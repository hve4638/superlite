import { editors, editorView, imageMime, ensureHex, loadHexChunk, HEX_CHUNK, openHex, toggleHtmlPreview, isHtml, viewerAutoReload, previewReloadTick, reloadPreview, languageOf, setApplyExternalEdit, setDisposeModels, updateContent, moveTabToGroup, moveTabSplit, openFileSplit, pinTab, openFolderTab, openFolderTabSplit, navigateFolderTab, addGroupBeside, folderPrefs, setFolderStyle, setFolderSort, toggleFolderPreviewPane } from '../../model/editors'
import { files, acquireDir, releaseDir, folderParent, isAbsPath, toWorkspacePath, toAbsPath } from '../../model/files'
import { createFile, createDir, renameEntry, deleteEntry, undoFileOp } from '../../model/fileops'
import { workbench, openContextMenu } from '../../model/workbench'
import { InlineNameInput } from '../widgets/InlineNameInput'
import { ConfirmDialog } from '../widgets/ConfirmDialog'
// 타입 전용 (DirEntry·Unopenable) — 런타임 호출은 model 을 거친다
import { DirEntry, Unopenable } from '../../backend/types'
import { createTerminal, setTerminalSerializer } from '../../model/terminal'
import { isShellSkippingChord } from '../../model/commands'
import { TERMINAL_FONT_FAMILY, TERMINAL_FONT_SIZE, TERMINAL_LINE_HEIGHT } from '../../theme/fonts'
import { openQuickInput } from '../../model/workbench'
import { FileIcon } from '../widgets/FileIcon'
import { backend, openFolder } from '../../model/host'
import { scm } from '../../model/scm'
import { setBeforeSessionSwitch, activeSessionEmpty, multiWindow, sessionRoot, sessions, detachEditorTab, requestTabsMove, DND_EDITOR, allTerminals } from '../../model/sessions'
import { windowLabel } from '../../model/window'
import { notify } from '../../model/notifications'
import { pointerOutside } from '../dndUtil'
import { StartPage } from '../StartPage'
import { EDITOR_FONT_SIZE, MONO_FONT_FAMILY } from '../../theme/fonts'

role: 에디터 영역 — monaco 수명주기(monaco.ts)와 그룹/탭바/diff 렌더링(.vue — 삭제 파일 탭(DiffTab.deleted)은 diff 대신 코드 편집기에 HEAD 모델을 읽기 전용으로), 탭 드래그 이동/분리(진행 상태는 tabDnd.ts 모듈 상태로 공유). 창 간(앱): 탭을 창 밖에 놓으면 새 창(detachEditorTab), 다른 창의 탭바에 놓으면 그 창이 출처에 이동을 요청(requestTabsMove) — 같은 root 세션에만, dataTransfer 의 DND_EDITOR 타입으로 식별. monaco 모델은 path 당 하나, 그룹 간 공유. 자동 줄바꿈(editorView.wordWrap, Alt+Z)은 MonacoHost 가 지켜보다 코드·diff 편집기에 updateOptions 로 반영. 열 수 없는 문서(doc.unopenable)는 모델을 만들지 않고 편집기 자리에 사유 안내를 띄운다 (VS Code binary/large 안내 근사). 편집기 자리를 차지하는 것(hex·preview 탭, 이미지, 열 수 없음 안내, 문서 미도착 파일 탭의 빈 본문 — openFile 이 탭을 읽기 전에 띄운다, MonacoHost 는 그동안 모델을 만들지 않고 docs 도착 워처로 sync)은 EditorGroupView 의 overlay computed 하나가 우선순위대로 정하고 monaco 는 v-show="!overlay" 로 가린다 — 종류가 늘면 그 분기 하나와 템플릿 분기 하나. 활성 탭이 editors.slowTabs(로드 800ms 초과)에 있으면 본문 상단(탭바·breadcrumbs 아래 2px)에 진행선(widgets ProgressBar). 터미널 탭(TerminalTab)은 TerminalView.vue — xterm 바인딩(terminalHost.ts: 인스턴스 id 키 모듈 맵, allTerminals 합집합으로 수명 판정, 세션 전환·탭 전환의 언마운트에도 살아 재부착, 버퍼 직렬화 seam 등록, 넘어온 restoreBuffer 는 xterm 을 열 때 먼저 그림)을 그룹 본문에 붙이고 fit·포커스(활성 그룹일 때만)한다. 키: skipShell 표식 chord(isShellSkippingChord)만 워크벤치로 양보하고 나머지는 xterm 이 셸로 보낸다 — Ctrl+V·Ctrl+Shift+V 는 xterm 처리를 건너뛰되 전파를 끊어 브라우저 네이티브 paste 가 워크벤치 chord(html.togglePreview)에 밀리지 않게 한다. 탭바 그룹 액션에는 활성 탭에 대한 것만 남는다 (새 터미널·폴더 탭 버튼은 타이틀바 — ui/_module; Split Editor 아이콘 없음, 분할은 Ctrl+\). 폴더 탭(FolderTab, 탭 아이콘 codicon-folder)은 FolderView.vue — 스타일(tab.style)별로 그린다: columns 는 yazi 식 3열(부모 폴더(현재 폴더 강조, 클릭으로 이동) / 현재 폴더(커서, 클릭 선택·더블클릭 진입) / 미리보기), details 는 Windows 탐색기 자세히 보기(FolderDetails.vue — 이름·수정한 날짜·유형·크기 열, 머리글 클릭 정렬(setFolderSort), 22px 가상 스크롤), icons 는 큰 아이콘 그리드(FolderIcons.vue — 104×96 타일, 행 단위 가상 스크롤, 열 수를 부모 키보드에 노출; 썸네일 없음). 서식(fmtDate·fmtSize KB 올림·typeOf '<EXT> File')은 folderFmt.ts. details·icons 는 미리보기 창(folderPrefs.previewPane, 오른쪽 34%)을 툴바 토글로 켠다. 미리보기(FolderPreview.vue — columns 셋째 열과 미리보기 창이 공유)는 커서가 폴더면 그 나열(FolderColumn), 파일이면 텍스트 앞부분(readFile maxBytes 256KB·400줄, 열린 문서는 버퍼)·이미지(ImageView)·이진은 HexView·크기 초과는 안내. 툴바(공통): 뒤로/앞으로(탭 이력, Alt+←/→)·위로(Alt+↑)·breadcrumb(안은 워크스페이스명›세그먼트, 밖은 '/'›세그먼트 — 조각 클릭 이동)·보기 전환 3개(setFolderStyle)·미리보기 창. 우클릭 메뉴 끝에도 View: … 항목. 열은 FolderColumn.vue (탐색기와 같은 22px 고정 행 가상 스크롤, 로드 중 스피너·실패 사유·Empty). 나열은 files.acquireDir/releaseDir (부모·현재·미리보기 폴더 집합의 차분만 참조), 탭 안 이동은 navigateFolderTab (탭 id 가 바뀌므로 EditorGroupView 는 FolderView 에 key 를 두지 않는다 — 같은 인스턴스가 path 를 따라간다), 커서는 editors.folderView (path 키 {cursor,index} — 항목이 사라지면 같은 자리로). 키(컨테이너 tabindex, 포커스 규칙은 터미널 탭과 같이 활성 탭일 때 pendingFocus 소비): ↑↓ j/k 이동(icons 는 ←→ ±1·↑↓ ±열 수), PageUp/Down·Home/End, → l Enter 진입·파일 열기(openFile), ← h Backspace 상위(떠나온 폴더에 커서), F2 rename·Delete(ConfirmDialog)·Ctrl+Z undoFileOp, 우클릭 메뉴 (폴더 항목·빈 영역이면 첫 항목 'Open in New Session' — 그 폴더(빈 영역은 현재 폴더)를 root 로 하는 새 세션 탭, host.openFolder(toAbsPath) — 같은 root 세션이 있으면 포커스만, 워크스페이스 밖에서도)·New File/Folder·Copy Path·Rename·Delete — 인라인 입력(InlineNameInput)·검증은 탐색기와 같은 규칙, 조작은 fileops 재사용. 목록 끝에는 32px 아래 여백 (세 스타일 공통). 탐색기 트리 선택과는 동기화하지 않는다. 드래그 진행 상태(tabDnd.ts)의 kind 'folder' 는 탐색기 폴더 행 — 본문 드롭 존 중앙은 openFolderTab, 가장자리는 openFolderTabSplit, 탭바 빈 영역은 그 그룹 끝. 타이틀바 아이콘 드래그(kind new-folder·new-terminal)는 탭바에서 탭 이동과 같은 삽입선을 보이고 그 index 에 (openFolderTab index / createTerminal index), 본문 중앙은 그 그룹 끝, 가장자리는 addGroupBeside 로 만든 분할 그룹에 연다 (ticket explorer-folder-tab, 2026-09-07). 외형은 Windows Terminal 을 닮는다 (사용자 방향 2026-09-07): Campbell 배색(배경 #0C0C0C, terminalHost 상수)·bar 커서·8px 패딩, 글꼴은 theme/fonts 의 TERMINAL_FONT_FAMILY(Cascadia Mono 우선) 16px·줄 높이 1.2. 드래그 선택도 WT 규칙: 마우스 모드가 아닐 때 Shift+클릭 확장 선택은 없다(capture 에서 Shift 를 뗀 mousedown 으로 교체), 마우스 모드(tmux·vim)에서는 그냥 드래그가 앱으로 가고 Shift+드래그만 xterm 강제 선택으로 터미널이 새 선택을 잡는다. 그 선택은 유지된다 — 1003 모드의 버튼 없는 이동 보고를 선택이 있는 동안 capture 에서 끊어 xterm 의 onUserInput 선택 해제를 막는다 (클릭·Ctrl+C 가 해제). MonacoHost 의 포커스 요청 소비는 다음 tick 에 focus() 한다 — post 워처 시점엔 부모의 v-show 반영 전이라 overlay(터미널·hex·프리뷰) 탭에서 파일 탭으로 옮길 때 호스트가 display:none 이어서 즉시 focus 가 무시된다. 이미지 문서(doc.image)도 모델 없이 편집기 자리에 이미지 뷰어(ImageView.vue — 체커보드, 영역 전체 휠 줌(커서 지점 고정)·드래그 팬·더블클릭 fit 복귀)를 띄운다. 해상도·크기·배율 표시는 statusbar 몫 — ImageView 가 editors.imageView 를 세운다. 이진 안내에는 "Open in Hex Editor" 링크(openHex). hex 탭(HexView.vue — HxD 식 offset/hex/ASCII 3열, 16바이트 행, 보이는 행만 렌더하는 가상 스크롤, 뷰어 전용·편집 없음)은 editors.hex(HexDoc)의 청크를 그린다 — 크기는 ensureHex, 보이는 행이 걸친 청크(±1 선읽기)는 loadHexChunk 로 요청하고 미도착 바이트는 빈 칸. 총 높이가 브라우저 요소 높이 한계를 넘는 GB 파일은 스크롤 트랙을 축척해 scrollTop 을 행 인덱스로 사상한다 (렌더 행은 scrollTop 을 따라가는 컨테이너에 상대 배치). preview 탭(HtmlPreview.vue)은 같은 path 의 doc.savedContent(저장된 내용 = 디스크 기준, 편집 버퍼 아님)를 sandbox iframe srcdoc 에 반영 — 저장·외부 변경 재로드 때 다시 그린다. 상대 경로 리소스는 해석되지 않는다(서버 없음). 자동 갱신(viewerAutoReload.html)이 off 면 저장·외부 변경을 따라가지 않고 마지막 렌더를 유지하며, 탭바 "Reload Preview"(reloadPreview → previewReloadTick)가 내용이 같아도 iframe 을 다시 만든다(key 증가). on 으로 켜면 즉시 동기화. iframe 안 클릭은 부모에 mousedown 이 오지 않으므로 window blur 시 활성 요소가 iframe 이면 focus 를 emit 해 그룹을 활성화한다(상태바가 따라온다). 탭바 그룹 액션에 활성 탭이 .html 편집기면 "Open Preview"(toggleHtmlPreview — 같은 탭을 제자리에서 프리뷰로), 프리뷰 탭이면 "Reload Preview"·"Show Source"(다시 편집기로) 아이콘. 부팅 유휴 시간에 더미 에디터를 한 번 만들어 폰트 측정 캐시를 데운다 — 첫 파일 콜드 오픈의 고정 비용(에디터 생성)을 부팅으로 옮기는 프리웜. 실측값은 localStorage 에 영속화(VS Code editorFontInfo 동일 수법)해 재실행부터는 부팅 실측도 건너뛴다 — 복원값은 monaco 가 5초 뒤 백그라운드 재실측(untrusted 취급)

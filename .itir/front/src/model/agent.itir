import { AgentState, AgentStatus, TerminalInfo, ThinBackend } from '../backend/types'
import { ctx } from './ctx'
import { confirm } from './dialog'
import { createEditors, Tab } from './editors'
import { errText, notify } from './notifications'
import { TerminalInstance } from './terminal'

role: 에이전트·터미널 상태 (ticket agent-hooks-status, 두 층). 뼈대 — 에이전트 훅 → 셸 심 `superlite agent-event` → 데몬(tmux 세션 id 별 캐시) → termAgent 방송 → 여기의 상태 기계. 단위는 탭이 아니라 tmux 세션 id: 같은 세션을 보는 모든 탭·카드·사이드바 행이 같은 값을 그린다. 어휘 unknown / running / needsInput / idle / exited (cmux). 표시는 배지(점)뿐 — 토스트 없음 (2026-09-14). idle 은 "봤는가"(seen Set) 로 갈린다 (사용자 결정 2026-09-14): Stop 이 왔는데 아직 그 터미널을 보거나 입력하지 않았으면 stopped(초록), 보이는 채로 받았거나 그 뒤 보거나(활성 leaf·창 focus) 입력하면 idle(회색). running·needsInput 이 30분 넘게 갱신되지 않으면 unknown (orca stale). 목록 폴링의 pane_current_command 가 셸(bash·zsh·fish·sh…)이면 exited 로 정정 (cmux 프로세스 교차검증 — 훅 없이 죽은 에이전트의 유령 상태). 바닥(agent-status-baseline 합침) — 훅 없는 CLI 용 프론트 신호: 보이지 않는 터미널에 출력이 오면 activity 점, BEL 이 오면 bell 배지 (토스트 없음) (tmux 를 통과하는 유일한 시퀀스가 BEL 이라 Codex 의 완료·승인 알림이 여기로 온다). 플러그인 구독 표면(ticket plugin-architecture)은 데몬 와이어가 아니라 이 모듈의 onAgentChange (AgentChange {tmuxId, status, prev}). TerminalInstance 의 activity·bell 도 여기서 세운다

export type AgentChange
export type DotColor
export type DotSpec
export fn createAgentStatus(backend, editorsM, terminals, closeRequested) {
  role: 세션 하나의 상태 모듈 — agents(tmux 세션 id → AgentStatus, shallowReactive Map)·onAgentChange·stateOf·statusOf·noteOutput·noteBell·noteInput·reconcile·installHooks·dotOfTmux·dotOfInstance·dotOfTab·dotOfSession. 점(DotSpec {a, b?}, 사용자 결정 2026-09-14): 터미널 하나(카드 행·사이드바 행)는 온전한 점 — closeRequested(terminal 의 `superlite card close` 요청 맵)에 있으면 빨강 우선, 아니면 running 파랑·needsInput 노랑·stopped 초록·idle 회색, exited·unknown 은 점 없음. 탭(탭 자신 + 터미널 카드들)·세션(모든 터미널) 요약은 노랑/초록만 모은다 — 둘 다면 반반(a/b, 30도 경계), 하나면 단색, 둘 다 없고 닫기 요청만 있으면 빨강 단색(급하지 않아 섞지 않음), 그 밖은 점 없음. backend.onTermAgent 구독은 여기서. 바닥 신호의 "보고 있는가" 판정은 document.hasFocus() ∧ 이 모듈이 활성 세션의 것(ctx().terminals.agent === self) ∧ 그 인스턴스가 어느 그룹의 활성 탭(카드가 있으면 활성 카드). needsInput 중 단독 Esc 입력(noteInput)은 취소로 보고 이 창에서 idle(본 것)로 내린다 — 질문·권한 창 Esc 취소에는 훅이 오지 않는다 (Claude Code 2.1.270 실측)
}
export fn installAgentHooks(action) {
  role: 활성 세션 shim — ConfirmDialog(설치·제거 문구, 데몬 머신 홈의 ~/.claude/settings.json 을 명시) 뒤 backend.agentHooks('claude', action), 결과 경로를 info 알림. 백엔드가 지원하지 않으면(mock·빈 세션) warning
}
export fn instanceDot(instId) -> DotSpec? {
  role: 카드 행의 점 — 터미널 하나 (plain 터미널은 null)
}
export fn listedDot(tmuxId) -> DotSpec? {
  role: 사이드바 행의 점
}
export fn tabDot(tab) -> DotSpec? {
  role: 에디터 탭의 요약 점 (TabBar)
}
export fn agentStateOfListed(tmuxId) -> AgentState? {
  role: 사이드바 행의 에이전트 상태
}

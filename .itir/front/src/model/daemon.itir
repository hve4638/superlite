import { ThinBackend } from '../backend/types'
import { confirm } from './dialog'

role: 문제 데몬 강제 정리 확인 — 원격 접속이 데몬 기동 단계에서 실패하면 dialog.confirm 으로 묻고 pending(실패 세션의 백엔드)을 든다. 자동 정리 없음 — 강제 종료는 명시적 승인 하에서만 (사용자 결정 2026-09-04). 실행(POST /daemon/clean·재접속)은 host.confirmDaemonClean — watch → daemon → host 순환 import 를 피해 host 가 daemonClean.onConfirm 에 꽂아 두고 여기는 승인 시 그것을 부른다

// pending: 확인 대기 중인 백엔드 (null = 대화상자 없음), busy: 정리 요청 진행 중, onConfirm: 승인 시 실행 (host 가 등록)
export val daemonClean

export fn promptDaemonClean(backend) {
  role: 확인 대화상자 열기 — 이미 떠 있으면 무시 (모달 하나). 승인이면 onConfirm, 취소면 cancelDaemonClean
}
export fn cancelDaemonClean() {
  role: 취소 — 아무것도 하지 않는다
}

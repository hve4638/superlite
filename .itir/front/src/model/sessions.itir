import { ThinBackend } from '../backend/types'
import { activeCtx } from './ctx'
import { createSessionCtx, SessionCtx } from './session'
import { TerminalInstance } from './terminal'

role: 워크스페이스 세션 탭 관리자 — 한 창(페이지) 안에서 세션 컨텍스트 여럿을 들고 전환한다. 탭 전환 = activeCtx 교체 (창 이동 없음, 웹·앱 동일 동작 — decision/workspace-session-tabs.md 개정). 목록의 단일 출처는 환경별: 앱은 native 레지스트리(추가·닫기는 invoke, sessions-changed 반향에 reconcile — 전환만 front 소유), 웹은 front 소유(세션마다 relay ?folder= 연결, 페이지 수명), mock 은 부팅 세션 하나(탭 UI 미표시). 환경(kind·연결 생성기)은 host.ts 조립 지점이 주입한다. root 가 null 인 탭은 루트 없는 빈 세션(시작 페이지, ticket app-empty-session) — 백엔드 연결 없이(EmptyBackend) 시작 페이지만 그려지고, 폴더를 열면 그 자리가 워크스페이스 세션으로 교체된다

export type SessionTab
export val sessions

export fn configureSessions(env) {
  role: 환경 주입 (host.ts 전용) — kind 와 탭별 백엔드 연결 생성기, 데몬 소켓 요청자 요청의 처리기(onRequest, 와이어 v9 — 세션 컨텍스트 생성 시 그 백엔드의 onRequest 를 이 처리기에 묶는다. 어떤 요청이 있는지는 조립 지점이 정한다)
}
export fn sessionsEnabled() -> Bool {
  role: 탭 UI 표시 여부 — mock 만 아니면 단일 탭이어도 그린다 (+ 버튼 발견성)
}
export fn setBeforeSessionSwitch(fn) {
  role: 전환 직전 훅 등록 — monaco 가 모델 캐시 전체 폐기를 건다 (path 키가 세션 간 충돌하므로. 새 세션 모델은 doc 스냅샷에서 재생성 — undo 만 잃는다)
}
export fn bootSession(tab, backend) {
  role: 부팅 세션 등록 (host.ts 평가 시점) — 마지막 등록이 활성
}
export fn cycleSession(dir) {
  role: 세션 탭 순환 (Ctrl+Shift+Tab — Ctrl+Tab 은 에디터 탭 넘기기 몫) — 활성 탭의 이웃으로 wrap 이동
}
export fn activateSession(id) {
  role: 탭 전환 — front 소유. beforeSwitch 훅 후 activeCtx 교체, shim·UI 가 따라온다
}
export fn closeSession(id) {
  role: 탭 닫기 = 세션 종료(kill 의미). 앱은 native invoke(레지스트리 제거·저장·방송), 웹은 로컬 제거·연결 dispose. 마지막 탭을 닫으면 빈 세션으로 대체한다 (앱은 native, 웹은 로컬 — 탭 0 은 없다, 앱 종료는 창 X). 데몬 터미널은 연결 끊김 → grace 후 회수
}
export fn addEmptySession() {
  role: 탭 추가(+) 기본 동작 — 루트 없는 빈 세션 탭을 만든다 (2026-09-01 확장: 폴더 선택 없이 빈 탭 먼저, 시작 페이지에서 열기로 이어진다). 앱은 native invoke(open_empty_session — 레지스트리 등록·방송 반향), 웹은 로컬 추가. mock 은 무동작
}
export fn activeSessionEmpty() -> Bool {
  role: 활성 탭이 빈 세션인가 (root null 또는 원격 빈 세션 isRemoteEmpty) — 시작 페이지 표시(EditorArea)·탐색기 빈 상태·터미널 생성 차단·폴더 열기의 빈 탭 교체 판단이 공유하는 반응형 판별
}
export fn isRemoteEmpty(root) -> Bool {
  role: 경로 없는 원격 root(`ssh://host`) — 원격 빈 세션. 시작 페이지이되 연결은 있다(탐색 전용 attach): 폴더 열기 퀵인풋의 browseDir 가 그 호스트를 탐색하고, 폴더를 열면 제자리 교체. 탭 라벨은 "Welcome [host]"
}
export fn browseBackend() -> ThinBackend? {
  role: 폴더 탐색(browseDir) 가능한 백엔드 — 활성 세션 우선, 활성이 빈 세션(무연결)이면 아무 연결 세션의 것으로 위임. browseDir 는 절대 경로 나열이라 세션 root 와 무관해 어느 연결이든 같은 결과다 (웹 = 서버 FS, 앱 = 데몬 FS). 전부 빈 세션이면 null — 퀵인풋 확정 검증이 불가하므로 호출측(Ctrl+O)이 OS 다이얼로그로 우회한다
}
export fn renameSession(id, name) {
  role: 세션 탭 이름 변경 (탭 더블클릭 rename) — 표시 라벨은 front 소유라 로컬만 바꾼다 (앱 reconcile 은 로컬 이름 우선). 지속 안 됨 — 재실행 복원은 root basename (수용)
}
export fn moveSession(id, to) {
  role: 세션 탭 순서 이동 (드래그) — to 는 표시 목록 기준 삽입 인덱스. 앱은 순서의 단일 출처인 native 레지스트리에 invoke(move_session) 로 위임하고 sessions-changed 반향을 reconcile 이 따라간다. 웹은 로컬 목록을 직접 재배열한다
}
export fn remoteHost(root) -> String? {
  role: ssh://host/path 또는 ssh://host root 의 host — 원격이 아니면 null (탭 라벨·원격 세션 안 폴더 열기 판정)
}
export fn genSessionId() -> String {
  role: 세션 id 생성 (웹 전용 — 앱은 native 가 발급)
}
export fn openWebFolder(root, replace?) {
  role: 웹 '폴더 열기' 확정 — 새 세션 탭 생성·활성화 (host.openFolder 가 부른다). 같은 워크스페이스(꼬리 '/' 정규화 root 문자열 — ssh://host/path 원격은 스킴·호스트가 문자열에 포함돼 (origin, path) 정체성이 그대로 성립)가 이미 열려 있으면 새 탭 대신 그 탭으로 포커스 이동 (빈 탭은 남는다, 명시적 replace 면 이전 탭 닫음). 대체 대상 = 활성 탭이 빈 세션이거나(앱의 native replace 와 동일 의미) 명시적 replace(VS Code 원격 "현재 창에 연결") — 새 탭이 그 자리를 차지하고 이전 탭은 활성화 후 제거 (빈 상태 없음). 원격 탭 라벨은 "이름 [호스트]"
}
export fn replaceAppSession(prevId, newRoot) {
  role: 앱 '현재 탭 대체' 뒷정리 — open_folder_path invoke 뒤 이전 활성 탭을 close_session (native replace 는 빈 세션만 제자리 교체). 같은 워크스페이스 재열기(포커스 이동만)면 root 문자열 대조로 건너뛴다
}
export fn initSessions() {
  role: 앱 전용 — list_sessions 초기 동기화 + sessions-changed·session-focus 구독. reconcile 은 추가분에 컨텍스트를 만들고(새 탭 = 활성) 제거분을 폐기하며 순서는 native 를 따른다. session-focus 는 이미 열린 워크스페이스 재열기 시 native 의 포커스 이동 지시다
}
export fn hasAnyDirty() -> Bool {
  role: 모든 세션의 미저장 문서 여부 — beforeunload 안전망 (배경 탭의 dirty 도 지킨다)
}
export fn allTerminals() -> TerminalInstance[] {
  role: 전 세션 터미널 합집합 — TerminalPane 의 xterm 바인딩 수명 판정용 (배경 세션 것을 죽이지 않기 위해)
}

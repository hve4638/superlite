import { ThinBackend } from '../backend/types'
import { MockBackend } from '../backend/mock'
import { WsBackend } from '../backend/ws'
import { EmptyBackend } from '../backend/empty'
import { ctx, viewOf } from './ctx'
import { activateSession, activeSessionEmpty, bootSession, configureSessions, genSessionId, openWebFolder, remoteHost, rootOfBackend, activeSessionCtx, replaceAppSession, sessions, SessionTab } from './sessions'
import { notify, errText } from './notifications'
import { daemonClean } from './daemon'
import { credential, CredentialRequest } from './gitauth'
import { SessionCtx } from './session'

import { tauri } from './tauri'
import { bootActiveSession, subWindow } from './window'
import { configureNvim } from './nvim'
role: ThinBackend 조립 지점 — 구현체를 직접 참조해도 되는 유일한 파일 (itir boundary assembly). 세션 관리자에 환경(kind·탭별 연결 생성기)을 주입하고 부팅 세션들을 등록한다. 앱은 주입된 __SUPERLITE_WS__ endpoint 와 __SUPERLITE_SESSIONS__ 목록(native 레지스트리가 발급 — 복원이면 여럿, 마지막이 활성)으로, 웹은 ?tkn=·?folder= 로 /ws 부팅 세션 하나를 만든다 (기본이 실 백엔드 — ?mock 일 때만 MockBackend, 2026-09-08 뒤집음. ?ws 는 무해한 잉여). root 가 null 인 탭(빈 세션)은 연결을 열지 않는다 — EmptyBackend (앱·웹 공통). 서브 창(subWindow)은 세션 탭의 mirror(미러 세션 id)로 연결을 열고, 미러가 없는 탭은 무연결 자리표시(EmptyBackend) — 탭이 오면 native ensure_mirror 로 미러가 생겨 컨텍스트가 교체된다. 부팅 후 묶음의 활성 세션(bootActiveSession)이 있으면 그 탭으로 (sync 없이). 모듈 평가 시점에 부팅을 끝낸다 — model shim 을 쓰는 모든 모듈보다 앞서야 하므로 main.ts 가 이 파일을 최우선 import 한다. 임베드 nvim(편집기 vim 모드)의 /nvim 주소도 여기서 configureNvim 으로 준다 — 웹은 같은 오리진 /nvim(+tkn), 앱은 주입 endpoint 의 /ws 를 /nvim 으로, mock 은 null

export val backend
export val openRootDefault

fn handleRequest(tab, ctx, method, params) {
  role: 데몬 소켓 요청자(셸 심 `superlite …`)가 세션에 보낸 요청의 처리기 (와이어 v9) — 통로의 첫 핸들러 둘: notify(알림 표시)·open(경로 열기 — stat 성공이면 파일로 그 세션 편집기에, 아니면 browseDir 로 폴더 확인 후 openFolder). 요청이 온 세션 탭으로 전환한다 (VS Code 가 요청한 창을 앞으로 가져오는 의미 — OS 창 포커스는 없음). credential(와이어 v18 — git credential helper 중계 get/store/erase, 데몬이 띄운 git 과 터미널 git 모두, gitauth.credential 이 답한다). 이후 전용 명령은 여기에 method 를 더한다. 결과는 요청자에게 돌아가고 throw(경로 부재·미지 method)는 에러로 돌아간다
}
fn requestPath(rootPath, abs) {
  role: 요청자의 절대 경로 → full('/' 구분 절대 경로 — 폴더 열기·browseDir 용)과 wire(파일 단건 RPC 용 — 루트 안이면 상대화, 밖이면 절대 경로 그대로, OS 드롭과 같은 규칙). 드라이브 경로(Windows)만 '\\' 정규화
}

export fn openFolder(root, opts?) {
  role: '폴더 열기' 확정의 단일 진입점 — 앱·웹 모두 "새 세션 탭 추가"이되, 활성 탭이 빈 세션이면 그 자리를 교체한다 (replace — 시작 페이지에서 열기 흐름). 앱은 native open_folder_path invoke (검증·등록은 native 소유, sessions-changed 반향으로 탭 생성. 잘못된 경로 reject 는 notify 로 드러낸다 — 퀵인풋이 자동완성 없이도 타이핑 확정을 허용하므로), 웹은 세션 관리자가 ?folder= 연결을 하나 더 연다. mock 은 무동작. 환경 분기가 여기 숨어 퀵인풋·원격 탐색기는 환경을 모른다. root 는 로컬 절대 경로 또는 ssh://host/path (원격 탐색기 접속 — 해석은 relay 몫). 활성 세션이 원격이면 맨 경로도 그 호스트의 경로로 본다 (퀵인풋 browseDir 가 원격 데몬을 탐색하므로 — VS Code 원격 창의 Open Folder 와 동일). opts.mode 'replace' 면 비어 있지 않은 활성 탭도 대체 (웹은 openWebFolder replace, 앱은 invoke 후 replaceAppSession — native replace 는 빈 탭 전용. 활성 탭이 빈 세션이면 'replace' 도 native 제자리 교체(replace id)를 써서, 대상이 이미 열려 있으면 Welcome 탭이 남는다 — 2026-09-05), 'new' 면 활성 빈 탭도 남기고 새 탭을 배경에 연다 — 현재 탭이 활성으로 남는다 (원격 탐색기 '새 탭에 연결', 2026-09-05. 앱은 openInBackground 예약 후 invoke, reject 면 cancelBackground), 생략은 활성 빈 탭만 제자리 교체
}
export fn backendApiUrl(path, query?) -> url? {
  role: 백엔드 자체 HTTP API(/ssh/*) 주소 — 데몬 와이어(/ws) 밖에서 백엔드가 직접 응답하는 첫 표면 (주소·연결은 백엔드 소유 — ws docs/decision/remote-ssh.md). 웹은 같은 오리진 상대 경로, 앱은 주입된 WS endpoint 에서 오리진·토큰 유도. mock 은 null — 호출측(원격 탐색기)이 UI 를 감추는 신호
}
export fn confirmDaemonClean() {
  role: 강제 정리 승인 — 실패 세션의 root(rootOfBackend)에서 host 를 얻어 POST /daemon/clean(host 없으면 로컬)로 superlite-daemon --clean 을 실행하고 결과를 알림으로 보인 뒤 backend.reconnect. 실패는 알림. 승인 없이는 아무것도 죽이지 않는다
}
export fn retryActiveConnection() {
  role: 영구 실패 뒤 사용자 주도 재접속 (시작 페이지 Retry) — 활성 세션 백엔드의 reconnect
}
export fn openFolderDialog() {
  role: OS 폴더 다이얼로그 열기 (앱 전용 — native open_folder invoke, 활성 빈 탭이면 replace 동반). Ctrl+Shift+O 커맨드가 쓴다 — 앱의 OS 다이얼로그 병행 통로. Ctrl+O·시작 페이지·탐색기·+ 드롭다운은 경로 입력 퀵인풋을 쓴다 (web-folder-open.md — Ctrl+O 는 모든 환경에서 경로 입력)
}

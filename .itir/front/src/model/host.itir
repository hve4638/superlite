import { ThinBackend } from '../backend/types'
import { MockBackend } from '../backend/mock'
import { WsBackend } from '../backend/ws'

role: ThinBackend 조립 지점 — 구현체를 직접 참조해도 되는 유일한 파일 (itir boundary assembly). Tauri 앱이 주입한 __SUPERLIGHT_WS__ 가 최우선 endpoint 이고 (자산 로드라 location 이 relay 가 아니다), 이때 __SUPERLIGHT_SESSION__ (native 세션 레지스트리가 발급한 session id)도 함께 넘긴다. 그 외엔 페이지 URL 의 ?tkn= 을 /ws 연결 토큰으로 전달하며 tkn 존재 자체가 실 백엔드 선택 신호다

export val backend

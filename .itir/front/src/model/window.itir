role: Tauri 창 제어 (앱 전용) — withGlobalTauri 전역(__TAURI__)으로 현재 창의 최소화·최대화 토글·닫기를 노출하고, resize 이벤트로 최대화 상태를 추적한다 (최대화/복원 아이콘 전환용). 브라우저에서는 inApp=false 이고 TitleBar 가 창 제어 버튼 자체를 숨긴다

export val inApp
export val appWindow
export fn minimizeWindow() {
  role: 창 최소화
}
export fn toggleMaximizeWindow() {
  role: 최대화/복원 토글
}
export fn closeWindow() {
  role: 창 닫기 — 보이는 세션 창의 close 는 native 가 앱 전체 종료로 확장한다 (배경 탭인 숨은 창만 남지 않게, app/src/main 참조)
}

import { ctx } from './ctx'
import { ThinBackend } from '../backend/types'
import { baseName, base64Bytes } from './editors'
import { blobToBase64 } from './fileops'
import { errText, notify, NotifyAction } from './notifications'
import { sessionsKind } from './sessions'
import { tauri } from './tauri'
import { ZipWriter } from './zip'

role: 원격 워크스페이스 ↔ 로컬 PC 파일 전송 (ticket explorer-download) — VS Code 원격 탐색기 "Download..." 와 OS 드롭 업로드 파리티. 전용 와이어 메서드 없이 readFile 범위 읽기(v11)·writeFile base64 + append(v14)로 4MB 조각 단위 전송 — 큰 파일도 한 메시지에 싣지 않는다. 로컬 저장은 환경별 sink: 앱은 native 저장 dialog + 조각 쓰기(Tauri 커맨드 pick_save_target·local_write·local_mkdir) 후 완료 알림에 "Open Folder" 액션(reveal_in_folder — OS 파일 관리자로 저장 위치, ticket download-conveniences), 웹은 브라우저 Blob 다운로드(폴더는 트리 저장 불가라 zip). 업로드는 DOM File 내용을 읽으므로 앱·웹 공통. ponytail: 전송은 한 번에 하나(transfer.active), 취소 없음, 진행은 상태바 항목 하나. 폴더 다운로드는 readDir 기준이라 트리가 숨기는 항목(.git 등)은 빠진다. 원격이 준 항목 이름은 로컬 경로 조각으로 검사(checkName — 구분자·'..' 거부)하고 재귀 깊이 상한(MAX_DEPTH 64)으로 순환 심링크를 끊는다

export type TransferProgress
export type DroppedEntry
// 진행 중인 전송 (label·done·total) — 없으면 null. StatusBar 가 그린다
export val transfer

export fn downloadEntry(path, kind) {
  role: 탐색기 Download... — 파일은 저장 위치(앱)·다운로드 폴더(웹)로, 폴더는 고른 폴더 안의 같은 이름 하위 폴더(앱)·<이름>.zip(웹)으로. 파일은 stat 크기만큼 범위 읽기(빈 파일도 생성), 폴더는 readDir 재귀로 목록을 모은 뒤 차례로. 진행: 파일은 바이트, 폴더는 파일 수. dialog 대기도 전송 슬롯 안(이중 dialog 방지), 취소는 무동작, 실패는 notify error, 완료는 notify info (앱은 "Open Folder" 액션 포함 — 웹은 브라우저가 저장하므로 없음)
}
export fn canOpenExternally(path) {
  role: 편집기 "Open Externally"(ticket open-externally) 대상인가 — 확장자 목록(OPEN_EXTERNALLY_EXTS: Office 계열 pptx·ppt·xlsx·xls·docx·doc·hwp·hwpx·pdf, 2026-09-11 사용자 결정, 설정 없음) 기준. 앱·웹 구분은 호출 쪽
}
export fn openExternally(path) {
  role: 편집기 "Open Externally"(앱 전용) — native 가 정한 임시 사본 경로(open_externally_target: <임시>/superlite-open/<경로 해시>/<파일명>)로 copyFile 후 open_externally 로 OS 기본 앱 실행. 전송 슬롯(run)을 다운로드와 공유. 사본이라 외부 앱의 저장은 원격에 반영되지 않는다 (완료 알림은 "Opened '<이름>' in the external app" 한 줄 — 짧게, 2026-09-11 사용자 결정). 같은 파일을 다시 열면 덮어쓴다 (외부 앱이 잠갔으면 local_write 실패 → 오류 알림)
}
export fn uploadDropped(dir, entries, confirmReplace) {
  role: 탐색기 OS 드롭 업로드 — webkitGetAsEntry 항목(드롭 이벤트 안에서 동기로 뽑아 넘긴 것)을 원격 dir 아래로. 같은 이름의 최상위 항목이 이미 있으면 confirmReplace 로 묻고 취소면 무동작. 폴더는 createDir(이미 있으면 실패 무시), 파일은 4MB 조각 — 첫 조각이 새로 만들고 이후 append. 끝나면 dir 리프레시 + Quick Open 무효화. 진행은 바이트
}

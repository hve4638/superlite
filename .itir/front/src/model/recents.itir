import { notify } from './notifications'
import { openFolder } from './host'
import { isRemoteEmpty, remoteHost, sessions, sessionsKind } from './sessions'

role: 시작 페이지의 최근 목록 (ticket start-page-recents) — 최근 연 폴더 MRU(개별 root, 최대 10)와 세션 묶음(한 창에 함께 열려 있던 root 집합, 이력 최대 5). 자동 복원은 없고(app-empty-session) 사용자가 여기서 골라 명시적으로 다시 연다. 저장소는 환경별 (decision/state-persistence.md version 2): 앱은 native 가 state.json 을 소유·갱신하고 여기는 list_recents 사영과 forget_*·open_bundle invoke 만, 웹은 앱 데이터 디렉터리가 없어 front 가 같은 스키마를 localStorage('superlight.state')에 두고 세션 목록 변화를 effect 로 추적해 기록한다 (웹은 검증 경로 — 이 환경에서 목록 동작을 볼 수 있어야 한다), mock 은 없음

export type RecentEntry
export val recents

export fn recentLabel(root) -> String {
  role: 표시 이름 — root 의 마지막 요소, 원격은 "이름 [host]" (세션 탭 라벨과 같은 규칙)
}
export fn refreshRecents() {
  role: 목록 새로 읽기 — 시작 페이지가 뜰 때와 세션 목록이 바뀔 때. 앱은 invoke list_recents(소실 여부 포함), 웹은 localStorage(소실 검사 없음)
}
export fn forgetRecent(root) {
  role: 최근 폴더에서 지우기(×) — 앱 forget_recent invoke / 웹 localStorage 갱신, 뒤에 refresh
}
export fn forgetBundle(roots) {
  role: 묶음 이력에서 같은 집합 지우기(×) — 앱 forget_bundle invoke / 웹 localStorage 갱신, 뒤에 refresh
}
export fn openBundle(roots) {
  role: 묶음 열기 — 앱은 native open_bundle(이 창이 전부 빈 탭이면 이 창에, 아니면 새 창에 — 사용자 결정; 거절은 notify). 웹은 창이 하나뿐이라 이 페이지에 탭으로 더한다 (첫 root 는 활성 빈 탭 제자리 교체, 나머지 mode 'new')
}
export fn initRecents() {
  role: 부팅 시 1회(main.ts) — 웹만 세션 목록 추적(trackWeb: 새로 나타난 workspace root 는 MRU 앞으로, 현재 root 집합은 native note_bundle 과 같은 규칙으로 묶음 이력에). 앱은 native 가 기록하므로 무동작
}

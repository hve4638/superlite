import { ThinBackend } from '../backend/types'
import { MockBackend } from '../backend/mock'
import { WsBackend } from '../backend/ws'
import { ctx, viewOf } from './ctx'
import { bootSession, configureSessions, genSessionId, openWebFolder, SessionTab } from './sessions'

role: ThinBackend 조립 지점 — 구현체를 직접 참조해도 되는 유일한 파일 (itir boundary assembly). 세션 관리자에 환경(kind·탭별 연결 생성기)을 주입하고 부팅 세션들을 등록한다. 앱은 주입된 __SUPERLIGHT_WS__ endpoint 와 __SUPERLIGHT_SESSIONS__ 목록(native 레지스트리가 발급 — 복원이면 여럿, 마지막이 활성)으로, 웹은 ?tkn=·?folder= 로 부팅 세션 하나를 만든다 (tkn 존재 자체가 실 백엔드 선택 신호). 모듈 평가 시점에 부팅을 끝낸다 — model shim 을 쓰는 모든 모듈보다 앞서야 하므로 main.ts 가 이 파일을 최우선 import 한다

export val backend

export fn openFolder(root) {
  role: '폴더 열기' 확정의 단일 진입점 — 앱·웹 모두 "새 세션 탭 추가". 앱은 native open_folder_path invoke (검증·등록은 native 소유, sessions-changed 반향으로 탭 생성), 웹은 세션 관리자가 ?folder= 연결을 하나 더 연다. mock 은 무동작. 환경 분기가 여기 숨어 퀵인풋은 환경을 모른다
}

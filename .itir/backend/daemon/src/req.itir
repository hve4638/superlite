// crate::err(main.rs) 참조 — crate:: 는 crate 루트(main.rs 디렉토리) 좌표 '.' 로 정규화된다
import { err, wire_rel } from '.'

role: RPC 요청 처리 — fs 읽기/쓰기(etag 낙관적 충돌 검사, readFile/writeFile 은 encoding=base64 이진 읽기/쓰기 겸용 — base64 읽기는 UTF-8 검증을 건너뛰고 크기 상한만 공유)·stat(내용 없는 경량 etag)·생성/이름변경/삭제, rg 검색, git 상태·커밋. readFile 의 크기 초과·이진(비 UTF-8)은 에러가 아니라 구조화된 unopenable 응답 — 프론트가 탭을 열고 안내 화면을 띄운다. 경로는 safe_join 관문 — 단 파일 단건(readFile/stat/writeFile)은 file_path 를 거쳐 절대 경로도 허용한다 (워크스페이스 밖 파일 열기, VS Code 파리티). excludes 는 VS Code 기본값 하드코딩 (설정 시스템 없음)

// 쓰기 계열 RPC(write/create/rename/delete)의 직렬화 락 — etag 검사-쓰기 원자성의 근거
val WRITE_LOCK
// readFile 기본 크기 상한(50MB, VS Code 텍스트 편집기 상한과 동일) — 초과는 unopenable(large) 반환, 검사는 읽기 전(stat)이라 대용량을 나르지 않는다
val READ_MAX_BYTES
// 트리(readDir)에서 숨기는 basename — VS Code files.exclude 기본값 (.git·.svn·.hg·.DS_Store·Thumbs.db). node_modules 는 트리에 보인다
val FILES_EXCLUDED
// 검색·listFiles 의 rg 공통 인자 — --hidden + files.exclude·search.exclude(node_modules 등) 글롭. ignore 파일은 워크스페이스 안의 것만 (VS Code 기본: useIgnoreFiles=true, parent/global=false)
val RG_EXCLUDE_ARGS

fn handle_req() {
  role: 메서드 디스패치 — 요청은 태스크로 병렬, 쓰기 경합은 WRITE_LOCK 직렬화
}
fn safe_join() {
  role: 루트 이탈 방지 — 렉시컬 검사 + 심링크 해소 실경로 확인, 트리·조작 계열 RPC 경로의 관문
}
fn file_path() {
  role: 파일 단건 호출(readFile/stat/writeFile)의 경로 해석 — 절대 경로면 '..' 만 거부하고 그대로, 아니면 safe_join. 워크스페이스 밖 파일 열기(OS 드롭)의 관문
}
// browseDir RPC — '폴더 열기' 경로 탐색용 임의 절대 경로의 하위 디렉토리 이름 나열. 절대 경로 허용 근거는 file_path 와 같다 (인증 경계는 relay, 인증 통과자는 터미널로 이미 셸을 가진다)
fn file_etag() {
  role: (mtime_ms, size) etag — VS Code 동일 구성, stat 스냅샷
}
fn search() {
  role: rg --json 파싱 — 바이트 오프셋을 UTF-16 코드유닛으로 변환 (프론트 slice 좌표계)
}
fn git_status() {
  role: porcelain v2 -z(NUL 구분) 파싱 — 경로 quote 없음, rename 은 새 경로만(원경로 토큰 소비), branch.oid → head (unborn 은 빈 문자열)
}
fn run_rg() {
  role: rg 실행 — exit 1(무매치)도 성공 취급
}
fn walk_files() {
  role: rg 부재 시 listFiles 강등 — RG_EXCLUDE_ARGS 의 basename 제외를 흉내 낸 자체 재귀 walk (gitignore 미적용이 의도된 차이, 심링크 미추적). 부팅이 listFiles 를 await 하므로 rg 없는 실기기에서도 앱은 떠야 한다
}
fn run() {
  role: 외부 명령 실행 — 실패 시 stderr, 비면 stdout 을 에러로
}

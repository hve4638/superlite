// crate::err(main.rs) 참조 — crate:: 는 crate 루트(main.rs 디렉토리) 좌표 '.' 로 정규화된다
import { err } from '.'

role: PTY 터미널 — 생성·입출력·리사이즈·정리. 입력은 터미널별 쓰기 스레드로 넘겨 read 루프를 절대 막지 않는다 (배압으로 셸이 출력에서 막히면 pty 입력 큐도 차기 때문 — termAck 이 같은 read 루프라 블로킹 쓰기는 데드락). 출력은 연결이 아니라 세션의 sink 로 — 끊김 중엔 버퍼, 재접속 시 flush

export fn owner_of(terms, tty, tmux_id?) -> attached_at? {
  role: 요청자(credential helper·셸 심) 좌표로 이 세션의 터미널 찾기 (와이어 v18) — tmux 세션 id 가 있으면 그것으로, 아니면 plain 셸의 tty 로. 같은 tmux 세션을 여러 탭이 보면 가장 늦게 붙은 것(attached_at — 터미널 id 는 프론트가 세션마다 매겨 세션 간 비교 불가)
}
class Term {
  role: PTY 한 벌 — 입력 채널(전용 쓰기 스레드), master, child 핸들, 입력 예산, 출력 경로(Route), detach(tmux 클라이언트면 이 pty 슬레이브 tty — 정리 시 detach-client 대상, None=plain)
}
class Route {
  role: 터미널 이벤트가 나가는 곳 — (세션 안의 term id, 세션 sink, 소속 terms 맵)의 간접층. 리더·쓰기 스레드가 매 전송마다 읽는다 — id·sink 를 값으로 잡으면 터미널을 다른 세션으로 옮길 수 없어서 (와이어 v10 adoptTerminal)
}
fn adopt() {
  role: 터미널을 다른 세션으로 — from 의 from_id 를 떼어 to 의 to_id 로 붙이고 Route 를 to 의 sink 로 돌린다. 배압 카운터 리셋(받는 연결은 0 에서). 락 순서 from → route → to (terms 락 아래에서 route 를 잡지 않는다). root 일치는 호출자(main) 몫
}
class InputBudget {
  role: 입력 큐 안전판 — 터미널별·전역(데몬 전체) 바이트 상한의 원자 카운터. 프론트가 입력 배압 창을 지키면 거의 도달하지 않는다 (끊김 반복으로 창 리셋이 겹치면 도달 가능). 초과분 폐기는 에피소드당 한 번만 안내(dropping 플래그, 큐가 비면 해제) — 한 터미널의 폭주가 그 터미널에 갇히고 다른 터미널 입력은 정상 동작한다. Drop 시 잔여분을 전역 카운터에서 마저 빼 영구 누수를 닫는다
}
class Sink {
  role: 터미널 이벤트의 세션 스코프 출구 — Attached(연결 tx) | Detached(버퍼). 리더 스레드는 연결을 모른다
}
fn sink_send() {
  role: sink 상태에 따라 전송 또는 버퍼 적재 — 버퍼는 바이트 상한, 넘치면 termData 만 오래된 것부터 버림. termExit 는 보존한다 (프론트 탭 수명이 termExit 하나에 의존 — 유실되면 유령 탭)
}
class Flow {
  role: 터미널별 ack 기반 배압 (VS Code 상수: high 100k / low 5k) — 미ack 이 high 를 넘으면 리더 스레드가 condvar 대기, ack 로 low 이하가 되면 재개. 재접속 시 리셋, kill 시 해제
}
fn handle_term() {
  role: 터미널 계열 메서드 디스패치 — createTerminal 의 attach(와이어 v17, tmux session id)를 spawn_term 에 넘긴다. 같은 id 재생성 무시 (PTY 누수 방지), termAck 는 Flow 카운터 차감. termWrite 는 입력 예산 확보 후 적재 — 실패 시 폐기하되 그 터미널 화면에 안내를 출력하고 폐기분도 termInputAck 로 창을 돌려준다 (큐를 점유하지 않으므로 — 안 돌려주면 프론트 창이 영구 축소). sink 전송은 terms 락 밖 — terms→sink 락 중첩을 만들지 않는다
}
fn reset_flow() {
  role: 세션 전 터미널의 미ack 카운터 리셋 — 재접속 시 프론트 카운터와 함께 0 에서 재시작 (유실 프레임 몫의 영구 누적 방지)
}
fn program() {
  role: PTY 에서 돌릴 프로그램 (와이어 v17) — 데몬이 tmux 방식이면 tmux 세션을 먼저 detached 로 만들거나(attach 인자 없음) 지목된 세션 이름을 조회한 뒤 `tmux -L <SLUG> -f base.conf -u attach-session -t <id>` 를 TMUX/TMUX_PANE 없이 띄운다 (셸 심 좌표·ENV_ROOT 는 세션 환경변수로; -u 는 클라이언트 로케일 부재 시 한글 _ 방지). 데몬 환경에 UTF-8 로케일이 없으면(ssh 원격 데몬) LANG 을 채워 준다 — 설치돼 있으면 ko_KR.UTF-8, 아니면 C.UTF-8 (tmux::locale_fallback, ticket tmux-server-cwd-utf8). tmux 실패면 사유를 들고 셸 직접 실행으로 대체. plain·Windows 는 종전대로 $SHELL/COMSPEC + 환경변수 직접 주입
}
fn spawn_term() {
  role: PTY 생성 + 전용 리더 스레드. 프로그램은 program() — tmux 세션에 붙었으면 첫 출력 전에 termTmux{term,id,name}, tmux 대체면 termTmux{term,error} 를 sink 로 보낸다 (와이어 v17). — 출력은 UTF-8 경계 분할로 termData 푸시(id·sink 는 Route 에서 매번 읽음), 셸 자연 종료 시 자기 정리(소속 맵도 Route 기준 — adopt 로 옮겨졌으면 그쪽에서 빠진다). 자연 종료 termExit 에는 exit code 를 싣는다 (spawn 실패·dispose 경유는 code 없음). 셸 기본값은 $SHELL(unix) / COMSPEC(Windows). 환경변수 SUPERLITE_SOCK(이 데몬의 socket_path — common 의 우회 변수와 같은 이름이라 셸 안의 심·백엔드가 격리 인스턴스 포함 이 데몬에 붙는다)·SUPERLITE_SESSION(세션 id, 익명은 생략)을 주입한다 (와이어 v9) — 셸 심이 이 데몬·세션을 찾는 좌표, 원격에서는 원격 데몬 소켓. GIT_CONFIG_*(credential.helper 에 이 데몬 실행 파일의 helper 모드를 덧붙임)도 주입한다 (와이어 v18) — 터미널의 git 이 그 머신의 helper 로 못 채운 인증은 앱 대화상자로 가고, 성공 store·실패 erase 도 받는다 (VS Code git.terminalAuthentication 대응). 대상 세션은 요청자 tty 로 데몬이 해석하므로(main.rs resolve_requester) 세션 id 환경변수가 낡아도 된다. Term 은 tty·tmux_id 를 들어 그 대조에 쓴다. 쓰기 스레드는 셸에 쓴 몫을 termInputAck(UTF-16 단위 — 프론트 data.length 와 일치)로 통지한다 — 프론트 입력 배압 창의 반쪽
}
fn kill_term() {
  role: 터미널 정리를 전용 스레드로 (read 루프를 안 막고 좀비를 안 남긴다). tmux 클라이언트는 detach-client 로 clean detach 하고 wait_client_gone 으로 서버가 detach 를 끝낼 때까지 기다린 뒤에야 master 를 닫는다 — SIGHUP·master 급종료는 그 pane(셸)까지 죽인다 (실측 2026-09-07). plain 은 SIGHUP(unix)/TerminateProcess(Windows)
}
fn split_valid_utf8() {
  role: 청크 경계에서 잘린 UTF-8 꼬리 분리 (진짜 깨진 바이트는 손실 변환)
}

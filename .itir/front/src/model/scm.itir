import { ctx, viewOf } from './ctx'
import { createEditors } from './editors'
import { notify } from './notifications'
import { GitChangeKind, ThinBackend } from '../backend/types'

role: SCM 뷰 상태 — git 변경 목록, 커밋, 트리·탭 장식(색/문자). 세션별 팩토리(createScm) + 활성 세션 전달 shim

export type ScmChange
export val scm
export val CHANGE_LETTER
export val CHANGE_COLOR

export fn createScm(backend, editorsM) {
  role: 세션별 SCM 모듈 생성 — 변경 클릭이 여는 diff·파일이 같은 세션의 editors 인스턴스로 가도록 묶는다
}
export fn refreshScm() {
  role: gitStatus 재조회로 변경 목록·head 해시 갱신 — head 변화가 diff original 캐시를 무효화한다. 겹친 조회는 마지막 발행분만 반영 (역순 완료가 head 를 과거로 되돌리지 않게)
}
export fn openChange(change) {
  role: 변경 클릭 — untracked 는 파일로, 나머지는 diff 로 연다
}
export fn commit() {
  role: 입력된 메시지로 전체 커밋 후 상태 재조회 — 실패는 notify
}
export fn decorationFor(path, isDir) -> Decoration? {
  role: 탐색기·탭에 붙는 git 장식 (디렉토리는 자손 변경 전파)
}

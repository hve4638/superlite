role: ThinBackend 계약 — 와이어 프로토콜(백엔드 /ws JSON-RPC, v6 부터 대형 readFile 응답은 바이너리 payload 프레임 — 계약 표면(content=string)은 불변, 복원은 ws.ts 몫)의 TS 사영. 와이어 쪽 대응은 daemon/src 참조

port ThinBackend {
  role: 워크스페이스 파일·검색·git·터미널 접근 계약. 구현체 선택은 model/host 조립 지점 한 곳
  impls: { MockBackend, WsBackend }
  fn workspace() -> WorkspaceInfo {
    role: 워크스페이스 이름·루트 경로
  }
  fn readDir(path) -> DirEntry[] {
    role: 디렉토리 1층 나열 (트리 lazy 로드 단위). files.exclude 기본값(.git 등 VCS 메타)은 숨긴다 — node_modules 는 보인다
  }
  fn readFile(path, maxBytes?, encoding?) -> FileContent {
    role: 파일 내용 + 그 시점 디스크 etag. 크기 초과(maxBytes 또는 데몬 기본 상한 50MB)·이진/비 UTF-8 은 에러가 아니라 unopenable(사유 kind·실측 size)로 반환 — 탭은 열리고 편집기 자리에 안내 화면이 뜬다 (etag 는 이때도 온다 — orphan 재검증·재로드용). 실존하지 않는 경로 등 실제 실패만 에러. maxBytes 는 undo 캡처 등 호출측 상한 (초과 파일을 읽어 나르지 않는다). encoding='base64' 면 UTF-8 검증 없이 바이트를 base64 content 로 나른다 (이미지 뷰어 등 — writeFile 이진 통로와 대칭, binary unopenable 은 안 생기고 크기 상한만 남는다). 루트 상대 외에 절대 경로도 허용 — 워크스페이스 밖 파일 열기 (OS 드롭, VS Code 파리티)
  }
  fn stat(path) -> FileStat {
    role: 내용 없이 실존·변경만 확인하는 경량 etag 스냅샷 — 정규 파일 전용(디렉토리는 에러). orphan 재검증용. readFile 과 같이 절대 경로 허용
  }
  fn writeFile(path, content, etag?, encoding?) -> WriteResult {
    role: 저장. etag 제시 시 낙관적 충돌 검사 — stale 이면 미기록으로 conflict 반환, 생략 시 무조건 쓰기. readFile 과 같이 절대 경로 허용. encoding='base64' 면 content 를 이진으로 디코드해 쓴다 (클립보드 이미지 저장 등 — 텍스트 전제 와이어의 이진 통로)
  }
  fn listFiles() -> Path[] {
    role: Quick Open 용 전체 파일 나열 — dotfile 포함, .gitignore·files/search.exclude 제외
  }
  fn browseDir(path) -> name[] {
    role: '폴더 열기' 경로 탐색용 — 임의 절대 경로의 하위 디렉토리 이름 나열 (정렬됨). 옵셔널 — mock 은 가짜 트리 밖 경로가 없어 미구현이고, 존재 자체가 웹 '폴더 열기' 커맨드 등록의 지원 신호다
  }
  fn search(query, opts) -> FileSearchResult[] {
    role: 내용 전문 검색 (디스크 기준, dirty 버퍼 미반영) — 제외 규칙은 listFiles 와 동일
  }
  fn createFile(path) {
    role: 빈 파일 배타적 생성 — 중간 디렉토리 자동 생성, 이미 존재하면 에러 (기존 내용 보호)
  }
  fn createDir(path) {
    role: 디렉토리 배타적 생성 — 중간 디렉토리 자동, 이미 존재하면 에러 (undo 의 "내가 만든 것" 전제 보호)
  }
  fn rename(from, to) {
    role: 이름 변경/이동 — 대상이 이미 존재하면 에러
  }
  fn delete(path) {
    role: 파일·디렉토리 삭제 (디렉토리는 재귀, 휴지통 없음 — 안전장치는 프론트 confirm, undo 는 파일 한정)
  }
  fn gitStatus() -> GitStatus {
    role: 브랜치 + HEAD 커밋 해시 + 변경 목록 (항목마다 staged 플래그 — 한 파일이 인덱스·워킹트리 양쪽에 변경이 있으면 항목 둘). head 는 diff original 캐시 무효화 키 — 앱 밖 커밋(터미널 git)도 잡는다
  }
  fn gitOriginalContent(path) -> content {
    role: diff 의 original 쪽 — HEAD 시점 내용
  }
  fn gitCommit(message) {
    role: 인덱스(staged)만 커밋 — 전체 커밋은 호출측이 gitStage 로 먼저 올린다
  }
  fn gitStage(paths) {
    role: 파일들을 인덱스에 올린다 (삭제도 스테이징)
  }
  fn gitUnstage(paths) {
    role: 파일들을 인덱스에서 내린다 (워킹트리 유지)
  }
  fn gitDiscard(paths, untracked) {
    role: 워킹트리 변경 되돌리기 — paths 는 인덱스 내용으로 복원, untracked 는 파일 삭제. 파괴적 — 확인은 호출측
  }
  fn gitLog(limit) -> GitLogItem[] {
    role: HEAD 부터 최근 커밋 (해시·제목·작성자·상대 시각). unborn/비 git 은 빈 배열
  }
  fn gitBranches() -> name[] {
    role: 로컬 브랜치 이름 목록
  }
  fn gitCheckout(branch) {
    role: 브랜치 전환 — 충돌 등 실패는 reject
  }
  fn createTerminal(cols, rows) -> TerminalSession {
    role: PTY 세션 생성 (동기 핸들, 데이터·셸 종료는 콜백 — onExit 는 셸 자연 종료에만 exit code 와 함께 발화(spawn 실패는 null), dispose 로 인한 정리에는 발화하지 않는다). onData 콜백은 done 을 함께 받는다 — 구독자(xterm)가 청크 처리를 마치면 호출해야 하는 렌더러 배압 신호 (WsBackend 가 ack 시점으로 쓴다, mock 은 생략)
  }
  fn onFsChanges(cb) {
    role: 외부 파일 변경 배치 구독 (옵셔널 — mock 은 외부 변경이 없다)
  }
  fn onConnection(cb) {
    role: 연결 상태 변화 구독 (옵셔널 — mock 은 끊길 일이 없다). 재연결 시 true — 구독자가 전체 리프레시로 재동기화한다. error 동반 false = 영구 실패(원격 ssh 접속 실패, close 4502) — 재연결하지 않는다
  }
  fn onInputBlocked(cb) {
    role: 터미널 입력 배압 상태 구독 (옵셔널 — mock 은 즉시 소화라 미구현). 미소화 입력이 창(1M chars)을 넘어 전송을 멈추면 (TerminalSession.id, true), 대기분이 모두 나가면 false. 셸이 입력을 읽지 않는 상황을 사용자에게 표면화하는 통로
  }
  fn onSessionLost(cb) {
    role: 재연결됐지만 데몬 세션이 회수된 경우(장기 끊김) 구독 (옵셔널). cb 는 죽은 터미널의 TerminalSession.id 목록을 받는다 — 끊김 중에 만들어진 터미널은 새 세션에 살아 있으므로 전체가 아니라 명단만 정리해야 한다
  }
}

export type WorkspaceInfo
export type DirEntry
export type SearchMatch
export type FileSearchResult
export type GitChangeKind
export type GitChange
export type GitStatus
export type GitLogItem
export type FsChange
export type FileContent
export type Unopenable
export type FileStat
export type WriteResult
export type TerminalSession

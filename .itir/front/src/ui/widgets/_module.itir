import { editors, overwriteConflict, revertConflict } from '../../model/editors'
import { notifications, dismissNotification, pauseNotification, resumeNotification } from '../../model/notifications'
import { fileIcon } from '../../theme/fileicons'
import { version, aboutText, closeAbout } from '../../model/version'

role: 재사용 위젯 — 파일 아이콘, 사시(분할 드래그), 저장 충돌 토스트, 알림 토스트, 인라인 이름 입력, 확인 다이얼로그, About 다이얼로그(Help: About — 본문은 model/version 의 aboutText 하나로 표시=복사, Copy 는 클립보드, OK·Enter·Escape·배경 클릭은 closeAbout, Workbench 가 version.aboutOpen 으로 띄운다)

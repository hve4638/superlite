import { ctx, viewOf } from './ctx'
import { DirEntry, QuickOpenResult, ThinBackend } from '../backend/types'

role: 탐색기 파일 트리 — lazy 디렉토리 로드, 외부 변경 시 로드된 디렉토리만 병합 리프레시. 세션별 팩토리(createFiles) + 활성 세션 전달 shim — UI 는 종전 이름 그대로 활성 세션에 작용한다

export type TreeNode
export val files

export fn createFiles(backend) {
  role: 세션별 트리 모듈 생성 — 트리·펼침·로딩 상태가 팩토리 클로저에 산다 (한 페이지에 세션 여럿). 인스턴스 전용 expandPaths(paths)는 펼침 집합 복원(ticket workspace-state-restore) — 얕은 경로부터 자식을 읽어 expanded 에 넣고 사라진 경로·읽기 실패는 건너뛴다 (shim 없음, workspaceState.restoreWorkspace 가 ctx 로 부른다). 초기 로드(initFiles)는 루트 readDir 만 — 빠른 열기 목록은 나르지 않는다 (와이어 v12). onDirLoaded: 디렉토리 나열(readDir) 결과 구독 — SCM 이 repo 표식으로 하위 저장소를 즉시 등록한다 (session 조립 지점에서 연결). loading(루트 첫 로드, 진행 막대)·slowDirs(자식 로드 800ms 초과 디렉토리, twistie 스피너 — VS Code asyncDataTree slow 규칙)
}
export fn parentOf(path) {
  role: 부모 디렉토리 경로 (루트는 '') — 순수 함수, 세션 무관
}
export fn isAbsPath(path) -> Bool {
  role: 절대 경로 판별 (unix '/'·Windows 드라이브 접두) — 폴더 탭이 워크스페이스 밖에 있을 때의 path 꼴. 순수 함수
}
export fn folderParent(path, rootPath) -> path? {
  role: 폴더 탭의 상위 폴더 — 루트('')의 위는 rootPath 의 절대 부모(와이어 v15 readDir 절대 경로로 나열), 절대 경로는 한 단계 위, 파일시스템 꼭대기('/'·'D:')는 null. 절대 경로가 다시 워크스페이스 안을 가리키면 toWorkspacePath 로 루트 상대로 되돌린다. 순수 함수
}
export fn toAbsPath(path, rootPath) -> abs {
  role: 루트 상대(또는 이미 절대) 경로를 절대 경로로 — 탐색기·폴더 탭의 'Open in New Session' 이 host.openFolder 에 넘길 root. 순수 함수
}
export fn toWorkspacePath(abs, rootPath) -> path {
  role: 절대 경로를 워크스페이스 기준으로 — root 자신은 '', 그 아래면 루트 상대, 밖이면 그대로 (Windows rootPath 의 '\\' 는 '/' 로 정규화). 밖에서 안으로 들어올 때 탭이 파일 조작이 되는 루트 상대 꼴로 수렴하게. 순수 함수
}
export fn toggleDir(node) {
  role: 디렉토리 펼침/접힘 (첫 펼침에 자식 로드)
}
export fn refreshTree() {
  role: 수동 새로고침 (탐색기 Refresh 버튼) — 로드된 디렉토리 재나열 + Quick Open 캐시 무효화. 실패는 삼킨다 (워처·다음 시도가 복구)
}
export fn collapseAll() {
  role: 모두 접기 — 펼침 집합만 비운다. 로드된 자식은 유지되어 재펼침에 왕복이 없다
}
export fn revealPath(path) {
  role: 조상 디렉토리를 차례로 로드·펼치고 해당 경로를 선택 — 활성 편집기 자동 reveal(VS Code explorer.autoReveal)의 몸체. 트리에 없는 경로는 닿는 데까지만
}
export fn quickOpen(pattern) -> QuickOpenResult {
  role: Quick Open 후보 요청 — 무효화 이후 첫 호출에만 fresh 를 실어 데몬이 다시 걷게 한다 (VS Code 처럼 목록은 데몬 쪽에, 프론트는 상위 결과만 — 와이어 v12). 실패하면 무효 상태를 되돌려 다음 호출이 다시 fresh. 무효화(팩토리 내부 invalidateQuickOpen)는 생성·삭제 이벤트(watch)·파일 조작(fileops)·수동 새로고침·재접속 전체 리프레시가 부르고, 걷기 자체는 다음 Ctrl+P 로 미룬다 (종전 refreshAllFiles 는 이벤트마다 즉시 다시 걷어 홈처럼 늘 변하는 트리에서 4MB 를 반복 전송했다)
}
export fn visibleNodes() -> TreeNode[] {
  role: 펼침 상태 기준 평탄화 — 렌더링용
}
export fn acquireDir(path) {
  role: 폴더 탭(FolderView) 열의 나열 참조 — files.listing (path → {entries|null(로드 중), error?}) 을 참조 계수로 든다. 0→1 에 readDir, 이미 있으면 왕복 없음 (부모·현재·미리보기 열과 여러 폴더 탭이 같은 경로를 공유). 트리와 별개라 임의 경로를 나열한다. refreshDir 는 listing 에 있는 경로를 트리의 로드된 디렉토리와 같게 갱신하고(실패는 error 로 보인다) loadedDirPaths 에도 포함되어 감시·fileops·전체 리프레시가 같은 경로로 닿는다 (ticket explorer-folder-tab)
}
export fn releaseDir(path) {
  role: acquireDir 의 반대 — 계수가 0 이 되면 listing 에서 지운다 (열이 떠난 디렉토리를 리프레시가 계속 읽지 않게)
}

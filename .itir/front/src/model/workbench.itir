import { ctx, viewOf } from './ctx'
import { ThinBackend } from '../backend/types'

role: 셸 상태 — 사이드바/패널/뷰릿 토글, Quick Input, 컨텍스트 메뉴(항목 key = 열린 동안 한 글자 니모닉). 세션별 팩토리(createWorkbench) + 활성 세션 전달 shim — 탭이 각자의 사이드바·패널 배치를 기억한다 (VS Code 창 단위와 동일 감각)

export type ViewletId
export type ContextMenuItem
export val workbench

export fn createWorkbench(backend) {
  role: 세션별 셸 상태 모듈 생성
}
export fn initWorkbench() {
  role: 워크스페이스 이름(타이틀 표시)·루트 절대 경로(OS 드롭 상대화용) 로드
}
export fn toggleSideBar() {
  role: 사이드바 접기/펴기
}
export fn showViewlet(id, toggle) {
  role: 뷰릿 전환 — 같은 것 재클릭은 토글
}
export fn togglePanel() {
  role: 하단 패널 접기/펴기
}
export fn openQuickInput(mode) {
  role: Ctrl+P(files) / Ctrl+Shift+P(commands) / Ctrl+O(folder — 웹 '폴더 열기' 경로 입력) 열기
}
export fn closeQuickInput() {
  role: Quick Input 닫기
}
export fn openContextMenu(x, y, items) {
  role: 좌표에 컨텍스트 메뉴 열기
}
export fn closeContextMenu() {
  role: 컨텍스트 메뉴 닫기
}

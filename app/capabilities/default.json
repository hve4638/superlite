{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "모든 창(main·분리 창 w*) 공통 권한 — core 기본 묶음 (event.listen 포함 — sessions-changed·handoff 반영에 필수) + 커스텀 타이틀바의 창 제어·드래그",
  "windows": ["*"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close"
  ]
}

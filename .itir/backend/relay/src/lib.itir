role: 중계 코어 — 준비된 TcpListener 위에 /ws·/ssh/hosts·/ssh/state·/daemon/clean·/tmux-conf(GET/PUT/OPTIONS — 클라이언트 tmux 프로필 내용, 편집기 탭이 연다)·/tmux-conf/profiles(GET/POST — 프로필 목록·CRUD·select)·/ssh-config(GET/PUT/OPTIONS — 이 머신의 ~/.ssh/config)·/settings(GET/PUT/OPTIONS — 이 머신의 사용자 설정 settings.json 원문, ticket user-settings; 다섯 다 conf.rs)·/version·/github/oauth·/git/credentials(gitcred.rs)·/nvim(nvim.rs — 임베드 Neovim 중계, 데몬 와이어 밖) 라우터를 얹어 serve. HTTP 핸들러는 각자 authed()+cors() 전문을 앞세운다(미들웨어 없음 — WS 둘은 예외라 라우터를 갈라야 해서) — 새 엔드포인트가 전문을 빠뜨리면 곧 무인증이다. attach 직후 클라이언트 tmux 적용 프로필(conf::active_content)을 데몬에 tmuxConf 로 밀어 넣는다 (와이어 v17 — 원격별 관리 없이 이 백엔드 머신의 프로필이 원본). 데몬 spawn·attach, 상주 제어 연결 포함. dist 는 옵션 (bin 은 정적 서빙, Tauri 앱은 자산 번들이라 불필요). root 는 세션 해석기(SessionRoots)가 정한다 — 고정 root(bin) 또는 세션 레지스트리 조회(Tauri 앱, decision/workspace-session-tabs.md). root 문자열이 ssh:// 스킴이면 원격 — 해석(Target)은 접속 직전 한 곳에서만 한다

// Registry: SessionRoots::Registry 의 본체 — (세션 id, root?) 등록 순서 목록(Arc<Mutex<Vec>>). 앱(native)이 만들어 넘기고 relay 는 읽기만
export type Registry
export class SessionRoots {
  role: 세션 id → root 해석기 (rust enum). Fixed 는 모든 세션이 기동 인자의 root 하나(bin·종전 동작), Registry 는 native 쪽이 등록한 세션만 허용 — root 결정권이 native 에 남아 front 가 임의 경로를 지목할 통로가 없다. Registry 는 순서 보존 리스트 — 등록 순서가 곧 세션 탭 순서라 순서의 단일 출처를 레지스트리에 둔다 (세션 수가 한 자리라 선형 탐색으로 충분). 엔트리의 root 는 Option — 루트 없는 빈 세션(시작 페이지)도 레지스트리에 산다 (ticket app-empty-session). 원격 root(ssh://host/path)도 불투명 문자열로 나른다
  fn resolve(session?) -> root? {
    role: Fixed 는 항상 그 root, Registry 는 등록된 id 중 root 가 있는 것만 — 미등록·부재·루트 없는 세션은 None (ws_handler 가 close 4403 으로 변환)
  }
}
class Target {
  role: 접속 대상 — Local(데몬 IPC 소켓) 또는 Remote{host, path}(ssh exec 채널). root 문자열의 ssh:// 스킴 여부로 to_target 이 가른다
}
fn serve() {
  role: 서버 기동 단일 진입점 — control_loop spawn + 모듈 role 의 라우트 전부(+옵션 dist ServeDir — 이것만 authed 밖, 번들에 비밀 없음) axum serve. bin 과 Tauri 앱이 공유한다. root 대신 SessionRoots 를 받는다. App 상태에 ssh::Spares(호스트별 예비 파이프)를 함께 둔다 — relay 들이 공유
}
fn authed() {
  role: /ws 와 /ssh/* 공유 인증 — SUPERLITE_TOKEN 설정 시 ?tkn= 일치(일치가 곧 인증 — Origin 검증 생략, tauri:// 오리진 수용), 미설정 시 Origin=Host 검증(브라우저 CSRF), Origin 부재(비브라우저)는 통과
}
fn cors() {
  role: /ssh/* 응답에 Access-Control-Allow-Origin '*' — Tauri webview(tauri.localhost 오리진)의 fetch 는 /ws 와 달리 CORS 대상이라 헤더가 없으면 "Failed to fetch". 접근 통제는 authed 가 이미 하므로 권한 확대가 아니다 (토큰 없는 교차 오리진은 403)
}
fn hosts_handler() {
  role: GET /ssh/hosts — 백엔드 머신의 ~/.ssh/config Host 별칭 목록에 즐겨찾기·고정·drift·missing 을 합친 JSON (ssh::host_list). 데몬 와이어 밖 백엔드 자체 응답의 첫 표면 (주소·연결은 백엔드 소유 — decision/remote-ssh.md 2026-08-31)
}
fn state_handler() {
  role: POST /ssh/state?op=&host=(&open=) — 즐겨찾기·고정·경로 아이템·pane 상태 변경 (ssh::update_state 에 쿼리 전체를 넘긴다). 인자는 쿼리로 — JSON content-type 본문은 CORS preflight 를 유발한다. set-items 의 아이템 배열만 본문(프론트가 text/plain 으로 보내 단순 요청)으로 받아 쿼리 items 자리에 넣는다. 응답은 갱신된 목록 (GET 과 동일 형태)
}
fn clean_handler() {
  role: POST /daemon/clean?host= — 문제 데몬 정리 (superlite-daemon --clean). host 없으면 clean_local, 있으면 ssh::clean_remote. 프론트가 '데몬 기동 실패' 뒤 사용자 승인을 받은 경우에만 부른다 — 자동 호출 없음 (사용자 결정 2026-09-04). 응답 본문은 --clean 의 stdout, 실패는 502 + 사유. 인증은 authed, CORS 는 /ssh/* 와 같다
}
fn version_handler() {
  role: GET /version — 이 빌드의 version·channel(빈 문자열 = stable)·commit·builtAt·daemonBuild(daemon_build — 로컬 데몬 빌드 식별, 부재면 오류 문자열)·daemonBin(로컬 데몬 배치 경로, 부재면 오류 문자열)·tmuxBin(tmux 배치 경로, 프론트 미소비) JSON. 프론트 About·시작 페이지가 쓴다. 데몬 와이어 밖 relay 자체 응답, 웹·앱 동일 경로 (release-versioning). 인증·CORS 는 /ssh/* 와 같다
}
fn github_oauth_handler() {
  role: POST /github/oauth?path=<device/code|oauth/access_token>&<폼 인자…> — GitHub device flow 두 끝점(https://github.com/login/<path>)으로 폼 인자를 전달하고 JSON 응답을 되돌리는 중계 (ticket scm-subrepo-credential). github.com 로그인 끝점은 CORS 가 없어 프론트가 직접 못 부른다. 인자를 query 로 받는 이유: 본문 없는 POST 는 단순 요청이라 preflight 가 없다. path 는 둘만 허용. 토큰은 프론트에만 간다 — relay 는 저장하지 않는다. 데몬 와이어 밖. 인증·CORS 는 /ssh/* 와 같다
}
fn git_credentials_get() {
  role: GET /git/credentials[?host=] — host 없으면 gitcred::list (토큰 없음), 있으면 gitcred::get 의 {username, secret, label?} 또는 null. git 이 credential get 을 보낼 때 프론트(gitauth)가 부른다 — 토큰은 응답으로 메모리에만. 인증·CORS 는 /ssh/* 와 같다
}
fn git_credentials_post() {
  role: POST /git/credentials?action=set&host=&username=[&label=] (본문 text/plain = 토큰 — 단순 요청이라 preflight 없음) → gitcred::set, 응답 {insecure}; ?action=delete&host= → gitcred::delete
}
fn form_encode(s) -> encoded {
  role: 폼 값 percent-encoding — reqwest 의 form 기능(추가 의존) 대신 직접
}
fn clean_local() -> report {
  role: 로컬 데몬 바이너리(daemon_bin_path)를 --clean 으로 실행해 stdout 반환
}
fn ws_handler() {
  role: /ws 관문 — 인증은 authed. Registry 모드에선 ?session= 이 root 있는 등록 세션이어야 하고, 아니면 upgrade 후 close 4403 — HTTP 403 은 브라우저 WS 에서 일반 끊김과 구분되지 않아 프론트가 무한 재연결에 빠지므로, 재시도 무의미를 알리는 유일한 통로가 close code 다. Fixed(bin) 모드는 ?folder= 로 root 를 넘겨받는다 (웹 '폴더 열기' — 인증 통과자는 터미널로 이미 셸을 가지므로 권한 확대가 아니다. 로컬은 canonicalize + 디렉토리 확인, ssh:// 는 형식 파싱만 — 경로 검증은 원격 데몬 attach 가 한다. 실패는 FORBIDDEN). Registry 는 folder 를 무시 — root 결정권은 native 에 남는다
}
fn token_eq() {
  role: 상수시간 토큰 비교 — 이른 반환 없이 XOR 누적
}
fn relay() {
  role: WebSocket ↔ 데몬 양방향 중계 (Local 은 IPC 소켓, Remote 는 ssh::pipe_conn 의 stdio — 프레이밍은 동일, 헬퍼는 생 바이트 중계) — 프레이밍만 알고 내용은 불투명 (데몬이 유일한 해석자). 데몬발은 JSON 줄('{' 시작)→WS Text, 0x00 매직+4B BE 길이 프레임(와이어 v6)→WS Binary 재프레이밍. 방향별 전용 태스크 — 바이너리 프레임 읽기(read_frame)가 다중 await 라 select 취소에 안전하지 않아 단일 select 루프를 못 쓴다, 한쪽 종료 시 반대쪽 abort. 첫 줄 attach 에 해석된 root(원격은 원격 경로 — ssh::probe_remote 로 홈·OS·arch 를 얻어 `/~` 를 expand_home 으로 치환, OS·arch 에 맞는 데몬을 배치)와 (있으면) session id 를 실어 보낸다. 경로 없는 ssh://host(원격 빈 세션)는 홈에 watch:false(와이어 v7, 재귀 워처 생략)로 attach — 시작 페이지의 폴더 열기가 그 호스트를 탐색만 한다. 원격 폴더 세션은 첫 줄(attach 응답)의 rootPath 를 ssh::record_recent 로 적어 원격 탐색기의 최근 폴더가 된다. ssh child 는 relay 수명에 묶인다(kill_on_drop) — 종료 시 원격 데몬이 세션을 detach 로 돌린다. 접속 실패는 close 4502 + 사유(123B 내, close_with)로 프론트에 — ssh 접속 실패뿐 아니라 첫 프레임(attach 응답)이 에러이거나 응답 전에 EOF(원격 헬퍼의 데몬 기동 실패·바이너리 실행 불가 — 이때 사유는 ssh child stderr 의 마지막 줄)인 경우도 같은 통로. 4403 과 같은 '재시도 무의미' 통로로, 프론트는 재연결을 멈추고 사유를 보인다 (종전에는 코드 없는 close 라 1초 재연결·매번 ssh 재시도에 빠져 'Reconnecting…' 만 영원히 보였다). 첫 프레임을 기다리는 동안 프론트 Text 요청은 그대로 데몬에 흘리고 프론트 close 는 즉시 접는다. 원격 접속 절차는 connect_remote 가 맡고, 그 결과(RemoteConn: child·enter 가드·host·browse_only·stderr 마지막 줄·접속 중 모아 둔 요청)를 attach 이후에 쓴다
}
fn connect_remote(ws_tx, ws_rx, host, path, spares) -> conn? {
  role: 원격 접속 절차. 먼저 ssh::Spares 의 예비 파이프를 소비한다 (ticket ssh-spare-pipe) — 있으면 exec 없이 attach 만 남고 connectStage 도 흐르지 않는다, 없거나 죽었으면 원격 정보 조회(probe_remote) → 헬퍼 배치(ensure_remote_bin) → 파이프 spawn(pipe_conn). 접속은 별도 태스크로 돌리며 단계(ssh→helper→upload→daemon)를 {"event":"connectStage"} 로 프론트에 흘린다 (relay 자체 이벤트 — ssh-connect-status) — 그동안 프론트 Close 는 태스크 abort(= ssh child kill)로 즉시 접고, Text 요청은 RemoteConn.early 에 모아 relay 가 attach 줄 뒤에 순서대로 보낸다. 어느 쪽이든 접속 성립 직후 Spares.fill 로 다음 접속용 예비를 보충하고, 접속 수명은 Spares.enter 가드(RemoteConn._enter)로 표시한다 (실제 접속 0 → 만료 타이머). 경로 없는 ssh://host 는 browse_only — 홈(`/~` → expand_home)에 attach. 실패는 close 4502 + 사유로 프론트에 알린 뒤 None, 프론트가 먼저 끊어도 None
}

fn read_frame() {
  role: 데몬 IPC 의 다음 프레임 — 첫 바이트로 JSON 줄/바이너리 payload 구분, 길이 상한(PAYLOAD_MAX) 초과·비 UTF-8 줄은 프레임 오염으로 연결 종료. 순차 읽기 전용 (select 안 사용 금지). 로컬·원격 공용 (boxed 읽기 반쪽)
}
fn close_with(tx, rx, code, reason) {
  role: '재시도 무의미' close(4403 미등록 세션·4502 접속 실패 + 사유, 123B 내 문자 경계로 절단)를 프론트에 — Close 를 보낸 뒤 클라이언트의 Close 응답을 최대 2초 기다린다 (바로 drop 하면 Chrome 이 1006 으로 보고해 코드·사유가 유실되고 프론트가 무한 재연결에 빠진다)
}
fn daemon_build() -> str {
  role: 로컬 데몬의 빌드 식별 — spawn 할 데몬 바이너리(daemon_bin_path)의 내용 해시(common build_id), OnceLock 한 번 계산. 데몬은 자기 실행 파일로 같은 값을 내므로 두 프로세스가 같은 IPC 주소를 계산한다 — 백엔드는 제 빌드의 데몬에만 붙고 다른 빌드의 상주 데몬은 건드리지 않는다 (ticket update-compat). 바이너리 부재·읽기 실패는 그대로 접속 실패 사유
}
fn daemon_conn() {
  role: 데몬 소켓 접속. spawn 인자는 제어 루프만 true — relay 까지 spawn 하면 백엔드 하나가 데몬을 두 번 띄우는 race 가 생기므로 relay 는 재시도만 한다 (데몬 부재 시 제어 루프가 곧 재기동)
}
fn tmux_bin_for(os, arch) -> path? {
  role: 동봉 tmux 바이너리 — 앱 옆 daemon/tmux-<os>-<arch> (build.sh 가 정적 릴리스를 둔다), 로컬은 SUPERLITE_TMUX_BIN 우회 먼저. 없으면 None — 원격은 원격 호스트의 tmux, 로컬 데몬은 PATH
}
fn tmux_conf_get() {
  role: GET /tmux-conf?profile= — 프로필 내용 (profile 생략 = 적용 프로필, 없는 프로필은 404)
}
fn tmux_conf_put() {
  role: PUT /tmux-conf?profile= — 본문을 프로필 파일로. 접속 중인 데몬 적용은 프론트가 세션마다 tmuxConf 로 (relay 는 연결을 모아 두지 않는다)
}
fn tmux_profiles_get() {
  role: GET /tmux-conf/profiles — conf::list JSON (active·names·dir·sshConfig 실제 경로)
}
fn tmux_profiles_post() {
  role: POST /tmux-conf/profiles?op=&name=&from= — conf::update (create·clone·delete·select), 인자는 쿼리(preflight 회피), 응답은 갱신 목록, 거부는 400
}
fn ssh_config_get() {
  role: GET /ssh-config — 이 머신의 ~/.ssh/config (없으면 빈 문자열)
}
fn ssh_config_put() {
  role: PUT /ssh-config — 본문으로 통째 교체. 호스트 목록 갱신은 프론트가 /ssh/hosts 재조회
}
fn settings_get() {
  role: GET /settings — 이 머신의 사용자 설정 settings.json 원문 (없으면 `{}`, ticket user-settings)
}
fn settings_put() {
  role: PUT /settings — 본문으로 통째 교체. 내용 해석은 프론트 몫 (relay 는 파일 IO 만)
}
fn conf_options() {
  role: OPTIONS /tmux-conf·/ssh-config·/settings — PUT 의 CORS preflight 응답 (204 + allow-methods GET, PUT + allow-headers content-type + cors). Tauri 앱은 프론트 오리진과 relay 가 달라 브라우저가 PUT 앞에 preflight 를 보내는데 종전엔 405 라 저장이 실패했다 (웹은 같은 오리진이라 무관 — ticket relay-conn-fixes). 다른 끝점처럼 preflight 를 피하는 대신 PUT 의미를 유지했다. 인증 없음 — 메타데이터 응답이고 실제 PUT 이 authed 를 거친다
}
fn daemon_bin_for(os, arch) -> path {
  role: OS·arch 에 맞는 데몬 바이너리 배치 규칙 하나 — 실행 파일 옆 daemon/<os>-<arch>[.exe] (이름은 std::env::consts::OS·ARCH 값 그대로, 매핑 표 없음). 로컬(내 OS·arch)이면 SUPERLITE_DAEMON_BIN 우회가 먼저, daemon/ 에 없으면 형제 superlite-daemon 폴백 (cargo 가 target/debug 에 평평하게 놓는다 — check 하니스·cargo run). 원격용은 daemon/ 에 없으면 파일명·위치를 담은 오류
}
fn daemon_bin_path() {
  role: 로컬 데몬 바이너리 — daemon_bin_for(내 OS, 내 arch)
}
fn control_loop() {
  role: 백엔드 자체 수명 — 데몬 기동 보장 + 30초 ping 생존 신호
}

import { ThinBackend } from './types'

role: 브라우저 단독 개발용 인메모리 백엔드 — ws 워크스페이스(repo 밖)의 tools/refspec/mock-workspace 픽스처와 파일·git 상태 1:1 (differential 비교 전제)

export class MockBackend {
  role: 고정 파일 맵 + 쓰기 세대 etag(stat 은 그 etag + 바이트 size) + 스크립트된 가짜 셸(exit 로 종료 — exit code 와 함께 onExit 발화). 0ms delay 로도 비동기 경계를 만들어 동기 가정 UI 를 걸러낸다. createTerminal 의 attach(v17)·quickOpen 의 fresh 는 받지 않는다 (listTerminals 가 없어 attach 진입로 자체가 없고, 목록은 고정) — base64 쓰기는 문자열 그대로 저장이라 base64 읽기와 왕복하지 않는다
}

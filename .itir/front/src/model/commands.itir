role: 커맨드 레지스트리 + 키바인딩 — VS Code 기본 chord 표기(ctrl+k ctrl+s 류) 지원

export type Command
export val commandList

export fn isWorkbenchChord(e) -> bool {
  role: 워크벤치가 가로채는 chord 인지 — monaco 에 키를 넘길지 판단
}
export fn installKeybindings(target) {
  role: window keydown 에 chord 상태기 설치
}
export fn setupCommands() {
  role: 내장 커맨드 전부 등록 (저장·분할·뷰 전환·터미널 등 — 터미널 생성은 activeSessionEmpty 가드). 활성 탭 경로를 hex 뷰어로 여는 'Hex Editor: Open Active File in Hex Editor', .html 활성 탭의 'HTML: Open Preview to the Side'(Ctrl+Shift+V). '폴더 열기' Ctrl+O 는 모든 환경에서 경로 입력 퀵인풋을 연다 (sessionsEnabled 에서 등록, mock 미등록). 앱(inApp)은 OS 다이얼로그를 Ctrl+Shift+O(host.openFolderDialog — 빈 탭 replace 판단 포함)로 병행 제공한다 — web-folder-open.md (Ctrl+O=경로 입력, Ctrl+Shift+O=OS 다이얼로그)
}

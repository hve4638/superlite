import { editors, overwriteConflict, revertConflict } from '../../model/editors'
import { notifications, dismissNotification, pauseNotification, resumeNotification } from '../../model/notifications'
import { fileIcon } from '../../theme/fileicons'
import { version, aboutText, closeAbout } from '../../model/version'

role: 재사용 위젯 — 파일 아이콘, 사시(분할 드래그), 진행선(ProgressBar — VS Code progressbar.css infinite 의 2px 막대, 부모(position: relative 본문)의 top -2px 에 절대 배치돼 제목 영역 아래 2px 에 겹친다. 표시·숨김은 부모 v-if), 저장 충돌 토스트, 알림 토스트, 인라인 이름 입력, 확인 다이얼로그, 탭 스트립 가로 스크롤 컨테이너(StripScroll — 세션 탭·에디터 탭 공용, ticket tab-strip-overflow: 넘치면 가로 스크롤, 세로 휠→가로, 넘친 쪽 끝 페이드(--strip-bg), 3px 슬라이더는 hover 중에만(네이티브 스크롤바는 숨긴다 — 높이를 차지해 탭 아래 1px 라인을 잘라먹는다), 드래그 중 가장자리 40px 에 머물면 rAF 자동 스크롤(capture dragover — 탭의 stopPropagation 무관), 부모가 reveal(selector) 로 활성 탭을 드러낸다; 액션(+·자물쇠)은 밖에 둔다), About 다이얼로그(Help: About — 본문은 model/version 의 aboutText 하나로 표시=복사, Copy 는 클립보드, OK·Enter·Escape·배경 클릭은 closeAbout, Workbench 가 version.aboutOpen 으로 띄운다)

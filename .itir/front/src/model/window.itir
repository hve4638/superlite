import { boot } from './boot'
import { tauri } from './tauri'
import { flushAllWorkspaces } from './workspaceState'
import { errText, notify } from './notifications'
import { ctx } from './ctx'
import { urlTargetOf } from './settings'
role: Tauri 창 제어 (앱 전용) — withGlobalTauri 전역(__TAURI__)으로 현재 창의 최소화·최대화 토글·닫기·줌을 노출하고, resize 이벤트로 최대화 상태를 추적한다 (최대화/복원 아이콘 전환용). windowLabel 은 이 창의 Tauri label(부팅 정보 boot.window) — 창 간 탭 이동에서 출처·대상 주소. 브라우저에서는 inApp=false·windowLabel null 이고 TitleBar 가 창 제어 버튼 자체를 숨긴다. ownerWindow 는 서브 창(에디터·터미널 탭 분리로 생긴 창)의 소속 메인 label(부팅 정보 boot.owner), subWindow 는 그 유무 — 메인 창(첫 창·세션 탭 분리 창)·웹·mock 은 null (decision/workspace-session-tabs.md 2026-09-08 개정). bootActiveSession 은 부팅 시 묶음의 활성 세션(부팅 정보 boot.active — 페이지 로드마다 native 에 묻는 값이라 창 새로고침 뒤에도 리로드 전 활성 탭이다). destroyWindow 는 onCloseRequested 를 거치지 않는 파괴, onWindowCloseRequested 는 X·OS 닫기 요청을 막고 핸들러를 부른다 — 서브 창이 탭을 메인에 되돌린 뒤 닫는 경로

export val inApp
export val appWindow
export val windowLabel
export val ownerWindow
export val subWindow
export val bootActiveSession
export fn minimizeWindow() {
  role: 창 최소화
}
export fn toggleMaximizeWindow() {
  role: 최대화/복원 토글
}
export fn setIme(enabled) {
  role: OS 입력기(IME) 전환 — native set_ime 커맨드 호출. vim 모드가 non-insert 로 들어갈 때 false(영문 강제, 그때 상태를 native 가 창 단위로 기억), insert 진입·vim 모드 해제에 true(복원). 편집기 안에서는 OS IME 를 이길 수 없어 VSCodeVim 의 im-select 처럼 밖에서 바꾼다 (app/src/main set_ime, ticket editor-vim-ime-imswitch). Windows 앱만 — 웹·다른 OS 는 무동작
}
export fn imeProbe() -> string {
  role: IME 진단 (ticket term-ime-toggle-stuck, 임시) — native ime_probe 호출 (전경 창·키보드 포커스 HWND·IME 열림 상태·포커스 프로세스·캐럿·조합 창 후보 한 줄). 터미널이 한/영 keydown 때와 조합 시작 때(ticket term-ime-window-topright) imeDiag 에 남긴다. 웹·다른 OS 는 null. 원인 확정 뒤 지운다
}
export fn clearWebviewCache() {
  role: 웹뷰 캐시 비우기 (app/src/main clear_webview_cache) — URL 탭 새로고침의 Ctrl+클릭이 프레임 재생성 전에 기다린다. cross-origin 프레임은 부모가 캐시 무시 재로드를 시킬 수 없어 캐시 자체를 비우는 길밖에 없다. Windows 앱만 실제로 비운다 — 웹·리눅스는 무동작(그냥 재생성), 그 환경은 dev 확인용이라 여기까지 (사용자 결정 2026-09-13). 범위는 웹뷰 프로필 전체
}
export fn openUrl(url) {
  role: URL 열기의 단일 진입점 (터미널 링크 Ctrl+클릭 ticket terminal-links, 앞으로 생길 링크) — 사용자 설정의 분기 규칙(settings.urlTargetOf, ticket user-settings)이 내부면 활성 세션의 URL 탭(ctx().editors.openUrl), 외부면 openExternal
}
export fn zoomWindow(action) {
  role: 이 창의 웹뷰 줌 — native set_zoom 커맨드 호출 ('in'·'out'·'reset'). 레벨·저장·적용은 native 몫이고 부른 창에만 적용된다 (app/src/main set_zoom, ticket zoom-per-window). 웹은 무동작
}
export fn destroyWindow() {
  role: 창 파괴 — 닫기 요청 훅 없이. 서브 창이 탭을 되돌린 뒤 스스로 닫을 때
}
export fn onWindowCloseRequested(handler) {
  role: 닫기 요청(X·Alt+F4) 가로채기 — preventDefault 후 handler. 웹은 무동작
}
export fn reloadWindow() {
  role: 창 새로고침 (팔레트 Developer: Reload Window, ticket workspace-state-restore) — 워크스페이스 상태를 저장(flushAllWorkspaces, 1.5초 상한)한 뒤 앱은 native reload_window(이 창이 속한 묶음 — 메인 + 서브 창 전부 — 를 네이티브 reload; 서브의 마지막 1초 이내 변경은 디바운스 전이라 빠질 수 있다), 웹은 location.reload. 앱은 세션이 native 에 남아 같은 id 로 재-attach 하고 탭·배치는 저장본에서 복원된다 (메인은 자기 몫, 서브 창은 자기 서브 몫 — get_workspace_sub_state). 웹은 브라우저 새로고침과 같다
}
export fn closeWindow() {
  role: 창 닫기 — 이 창의 X. 먼저 이 창의 워크스페이스 상태를 저장한다(flushAllWorkspaces, ticket workspace-state-restore). native 는 그 창의 세션만 정리하고 다른 창은 두며, 마지막 창이면 앱이 종료된다 (app/src/main 참조)
}
export fn openExternal(url) {
  role: 외부 브라우저로 열기 — 규칙을 거치지 않는 명시적 외부 열기(URL 탭 바의 버튼, ticket browser-tab-iframe — 주소칸의 입력값이 대상)와 openUrl 의 외부 쪽 출구. 앱은 native open_url(OS 기본 브라우저, 실패는 토스트 — 같은 일을 하던 tauri-plugin-opener 는 ticket user-settings 에서 제거), 웹은 window.open 새 탭(noopener)
}

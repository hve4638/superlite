import { ctx, viewOf } from './ctx'
import { notify } from './notifications'
import { FileContent, ThinBackend, Unopenable, WriteResult } from '../backend/types'

role: 탭·그룹·문서 상태와 열기/저장/충돌 처리. 열 수 없는 파일(크기 초과·이진)도 탭은 열린다 — doc.unopenable 에 사유를 실어 UI 가 편집기 대신 안내 화면을 띄운다 (content 는 '' 고정이라 dirty·저장 경로가 자연히 막힌다). 문서(docs)는 탭과 분리 — 같은 파일을 여러 탭이 공유한다. 그룹 목록(groups)은 flat 이고 화면 배치는 별도의 행/열 중첩 트리(layout)가 담당 — 순회 로직은 flat 목록만 알면 된다. 외부 삭제된 열린 파일은 orphaned 집합으로 표시(탭 유지 — VS Code closeOnFileDelete=false)하고 저장이 부활시킨다. 세션별 팩토리(createEditors) + 활성 세션 전달 shim. monaco 훅 슬롯(applyExternalEdit·disposeModels)은 세션 공용 모듈 슬롯 — 훅은 UI 능력이지 세션 상태가 아니다

export type FileTab
export type DiffTab
export type Tab
export type EditorGroup
export type LayoutNode
export type LayoutBranch
export type SplitSide
export val editors

export fn createEditors(backend) {
  role: 세션별 에디터 모듈 생성 — 그룹·배치·문서·undo 이력이 팩토리 클로저에 산다
}
export fn activeGroup() -> EditorGroup {
  role: 활성 에디터 그룹
}
export fn activeTab() -> Tab? {
  role: 활성 그룹의 활성 탭
}
export fn baseName
export fn openFile(path, opts) -> Bool {
  role: 파일 열기 — preview 탭 교체 규칙 포함 (VS Code 단일/더블 클릭 구분). focus:false 면 에디터 포커스 요청(pendingFocus)을 세우지 않는다 — 트리 단일 클릭은 포커스가 트리에 남는다. 읽기 실패는 notify 후 false
}
export fn openFileAt(path, line) {
  role: 열고 지정 라인으로 스크롤 (검색 결과 클릭)
}
export fn openDiff(path) {
  role: SCM diff 탭 열기 — modified 쪽은 워킹트리 문서 그 자체
}
export fn setActiveTab(groupId, tabId) {
  role: 탭·그룹 활성화 + 에디터 포커스 요청 (탭 클릭은 항상 에디터로 포커스 — VS Code 동일)
}
export fn pinTab(groupId, tabId) {
  role: preview 탭 고정 — 탭 더블클릭 (VS Code 동일)
}
export fn closeTab(groupId, tabId, force) {
  role: 탭 닫기 — 빈 분할 그룹은 접고 이웃으로 포커스. 닫힌 탭은 복원 이력에 쌓인다. dirty 문서의 마지막 참조 탭(같은 path 의 diff 탭 포함해 하나뿐)이면 곧장 닫지 않고 closeConfirm 을 세워 Save/Don't Save/Cancel 대화상자에 위임한다 (VS Code 동일 — 조용한 닫기는 버퍼가 몰래 살아남는 혼동을 낳는다). force 는 확인 생략 — confirm 처리부·삭제(closePathTabs)용
}
export fn confirmCloseSave() {
  role: 닫기 확인 Save — 저장(saveDoc) 성공 시에만 닫는다. 실패·충돌은 탭 유지 (충돌은 saveConflict 토스트가 이어받는다)
}
export fn confirmCloseDiscard() {
  role: 닫기 확인 Don't Save — 버퍼(docs)·orphan 표시·monaco 모델을 버려 다음 열기가 디스크를 읽게 하고 닫는다
}
export fn confirmCloseCancel() {
  role: 닫기 확인 Cancel — 대화상자만 닫고 탭·버퍼 유지
}
export fn reopenClosedEditor() {
  role: 마지막으로 닫은 탭 복원 (Ctrl+Shift+T) — 활성 그룹에 고정 탭으로 연다
}
export fn hasDirtyDocs() -> Bool {
  role: 미저장 문서 존재 여부 — 탭 닫힘(beforeunload) 안전망 판정용
}
export fn splitActiveEditor() {
  role: 활성 탭을 오른쪽 새 그룹으로 분할
}
export fn moveTabToGroup(fromGroupId, tabId, toGroupId, index) {
  role: 탭 드래그 드롭 — 다른 그룹의 index 위치로 이동(생략 시 끝) 또는 같은 그룹 내 순서 변경. preview 해제, 대상에 같은 탭이 있으면 합류(활성화만), 빈 원 그룹은 접는다
}
export fn moveTabSplit(fromGroupId, tabId, refGroupId, side) {
  role: 탭을 새 그룹으로 분리 — refGroupId 의 상하좌우(side) 에 생성. 단일 탭 그룹의 자기 분리는 no-op (결과가 제자리)
}
export fn openFileSplit(path, refGroupId, side) {
  role: 탐색기 드래그 드롭 — 파일을 refGroupId 상하좌우의 새 그룹에 연다. 읽기 실패 시 빈 그룹 잔재를 접는다
}
export fn resizeSplit(branch, boundary, startSizes, deltaPx, totalPx, minPx) {
  role: 분할 경계 드래그 — 경계 앞뒤 자식의 비율만 재분배 (합 보존, 최소 크기 클램프). 드래그 시작 스냅샷(startSizes) 기준 누적 델타. 순수 함수 — 세션 무관 (인자로 받은 branch 에 쓴다)
}
export fn updateContent(path, content) {
  role: 버퍼 갱신 + 파생 dirty 를 모든 탭에 전파
}
export fn setApplyExternalEdit(fn) {
  role: 외부 변경을 monaco 모델에 편집으로 반영하는 훅 등록 — model 이 UI 를 모르기 위한 seam
}
export fn reloadDocFromDisk(path, r: FileContent) {
  role: 외부 변경 반영 — 깨끗한 문서만 조용히 재로드, 내용 같아도 etag 는 갱신 (스퓨리어스 충돌 방지). unopenable 전이(텍스트↔이진·크기 초과)도 여기서 반영 — 사유를 최신화하고 내용은 '' 로 수렴
  depends: { updateContent }
}
export fn saveActive() {
  role: 활성 문서 저장 — 실체는 saveDoc(경로 단위, 닫기 확인 Save 와 공유): etag 낙관적 검사, conflict 면 saveConflict 슬롯에 걸고 토스트에 위임. 그 외 실패는 notify
}
export fn overwriteConflict() {
  role: 충돌 토스트 Overwrite — etag 없이 재기록해 디스크를 내 버퍼로 덮는다. 실패 시 토스트 유지
}
export fn revertConflict() {
  role: 충돌 토스트 Revert — 버퍼를 버리고 디스크 내용으로 강제 재로드 (dirty 무관). 실패 시 토스트 유지. 읽기 성공은 orphan 해제 겸
}
export fn remapPaths(from, to) {
  role: 파일/디렉토리 rename 반영 — docs 키·탭 id/path/name 을 새 경로로 이관 (내용·dirty·etag 유지). monaco 모델은 훅으로 버리고 doc 스냅샷에서 재생성
}
export fn setDisposeModels(fn) {
  role: rename/delete 시 monaco 모델을 버리는 훅 등록 — setApplyExternalEdit 와 같은 seam
}
export fn setOrphaned(path, on) {
  role: 외부 삭제 표시 토글 — watch 의 실존 재검증이 세우고, 재생성·저장 성공이 내린다
}
export fn closePathTabs(path) {
  role: 앱 내 삭제 반영 — 해당 경로(디렉토리면 하위 포함)의 탭을 모든 그룹에서 닫고 문서를 버린다 (외부 삭제와 달리 탭을 닫는 것이 VS Code 동일)
}
export fn languageOf(path) -> languageId {
  role: 확장자 → monaco 언어 id — 순수 함수, 세션 무관
}
export fn languageLabel(path) -> label {
  role: statusbar 표시용 언어 이름 — 순수 함수, 세션 무관
}
export fn indentOf(path) -> spaces {
  role: 들여쓰기 감지 — 최소 양수 선행 공백 (VS Code detectIndentation 근사)
}

import { ThinBackend } from '../backend/types'
import { activeCtx } from './ctx'
import { createSessionCtx, SessionCtx } from './session'
import { TerminalInstance, TerminalSnapshot } from './terminal'
import { TabHandoff } from './editors'
import { SessionSnapshot } from './session'
import { notify } from './notifications'
import { windowLabel } from './window'

role: 워크스페이스 세션 탭 관리자 — 한 창(페이지) 안에서 세션 컨텍스트 여럿을 들고 전환한다. 탭 전환 = activeCtx 교체 (창 이동 없음, 웹·앱 동일 동작 — decision/workspace-session-tabs.md 개정). 목록의 단일 출처는 환경별: 앱은 native 레지스트리(추가·닫기는 invoke, sessions-changed 반향에 reconcile — 전환만 front 소유), 웹은 front 소유(세션마다 relay ?folder= 연결, 페이지 수명), mock 은 부팅 세션 하나(탭 UI 미표시). 환경(kind·연결 생성기)은 host.ts 조립 지점이 주입한다. root 가 null 인 탭은 루트 없는 빈 세션(시작 페이지, ticket app-empty-session) — 백엔드 연결 없이(EmptyBackend) 시작 페이지만 그려지고, 폴더를 열면 그 자리가 워크스페이스 세션으로 교체된다. 다중 창(앱, decision 2026-09-03 개정 — ticket app-tab-detach-window): 창마다 관리자 하나, native 가 창 단위 목록을 준다. 탭을 창 밖에 놓으면 새 창(detach*), 다른 창에 놓으면 대상 창이 출처 창에 이동을 요청(request*)하고 출처가 그 시점 상태를 직렬화해 확정한다 — 핸드오프(Handoff JSON)는 항상 출처가 만들고 native 는 내용을 모른 채 전달(detach_session/move_session_to_window/detach_tabs 는 큐 적재+handoff-available, forward 는 살아 있는 창에 직접). 도착한 핸드오프는 applyHandoff 가 세션에 덮어쓴다 (대상 컨텍스트가 아직 없으면 다음 reconcile 뒤로 미룸). loading = 초기 로드(ctx.init: 워크스페이스·파일 목록·git 첫 로드) 진행 중인 세션 id 집합 — 탭이 X 왼쪽에 로딩 스피너를 그린다. 원격은 예비 파이프 접속이면 상태바 접속 단계가 안 보이므로 "로드가 끝났는가" 의 단일 시각 신호다 (2026-09-05 사용자 요청). 실패도 종료로 본다

export type SessionTab
export type Handoff
export val sessions
export val loading
export val DND_SESSION
export val DND_EDITOR
export val DND_TERMINAL

export fn configureSessions(env) {
  role: 환경 주입 (host.ts 전용) — kind 와 탭별 백엔드 연결 생성기, 데몬 소켓 요청자 요청의 처리기(onRequest, 와이어 v9 — 세션 컨텍스트 생성 시 그 백엔드의 onRequest 를 이 처리기에 묶는다. 어떤 요청이 있는지는 조립 지점이 정한다)
}
export fn sessionsKind() -> String {
  role: 환경 종류('app'|'web'|'mock') — recents 모델이 저장소(native state.json / localStorage / 없음)를 고른다
}
export fn sessionsEnabled() -> Bool {
  role: 탭 UI 표시 여부 — mock 만 아니면 단일 탭이어도 그린다 (+ 버튼 발견성)
}
export fn setBeforeSessionSwitch(fn) {
  role: 전환 직전 훅 등록 — monaco 가 모델 캐시 전체 폐기를 건다 (path 키가 세션 간 충돌하므로. 새 세션 모델은 doc 스냅샷에서 재생성 — undo 만 잃는다)
}
export fn bootSession(tab, backend) {
  role: 부팅 세션 등록 (host.ts 평가 시점) — 마지막 등록이 활성
}
export fn cycleSession(dir) {
  role: 세션 탭 순환 (Ctrl+Shift+Tab — Ctrl+Tab 은 에디터 탭 넘기기 몫) — 활성 탭의 이웃으로 wrap 이동
}
export fn activateSession(id) {
  role: 탭 전환 — front 소유. beforeSwitch 훅 후 activeCtx 교체, shim·UI 가 따라온다
}
export fn closeSession(id) {
  role: 탭 닫기 = 세션 종료(kill 의미). 앱은 native invoke(레지스트리 제거·저장·방송), 웹은 로컬 제거·연결 dispose. 마지막 탭을 닫으면 앱은 native 가 그 창을 닫고(마지막 창이면 앱 종료, 2026-09-05 개정), 웹은 창을 닫을 수 없어 로컬 빈 세션으로 대체한다. 데몬 터미널은 연결 끊김 → grace 후 회수
}
export fn addEmptySession() {
  role: 탭 추가(+) 기본 동작 — 루트 없는 빈 세션 탭을 만든다 (2026-09-01 확장: 폴더 선택 없이 빈 탭 먼저, 시작 페이지에서 열기로 이어진다). 앱은 native invoke(open_empty_session — 레지스트리 등록·방송 반향), 웹은 로컬 추가. mock 은 무동작
}
export fn activeSessionEmpty() -> Bool {
  role: 활성 탭이 빈 세션인가 (root null 또는 원격 빈 세션 isRemoteEmpty) — 시작 페이지 표시(EditorArea)·탐색기 빈 상태·터미널 생성 차단·폴더 열기의 빈 탭 교체 판단이 공유하는 반응형 판별
}
export fn isRemoteEmpty(root) -> Bool {
  role: 경로 없는 원격 root(`ssh://host`) — 원격 빈 세션. 시작 페이지이되 연결은 있다(탐색 전용 attach): 폴더 열기 퀵인풋의 browseDir 가 그 호스트를 탐색하고, 폴더를 열면 제자리 교체. 탭 라벨은 "Welcome [host]"
}
export fn browseBackend() -> ThinBackend? {
  role: 폴더 탐색(browseDir) 가능한 백엔드 — 활성 세션 우선, 활성이 빈 세션(무연결)이면 아무 연결 세션의 것으로 위임. browseDir 는 절대 경로 나열이라 세션 root 와 무관해 어느 연결이든 같은 결과다 (웹 = 서버 FS, 앱 = 데몬 FS). 전부 빈 세션이면 null — 퀵인풋 확정 검증이 불가하므로 호출측(Ctrl+O)이 OS 다이얼로그로 우회한다
}
export fn renameSession(id, name) {
  role: 세션 탭 이름 변경 (탭 더블클릭 rename) — 표시 라벨은 front 소유라 로컬만 바꾼다 (앱 reconcile 은 로컬 이름 우선). 지속 안 됨 — 재실행 복원은 root basename (수용)
}
export fn moveSession(id, to) {
  role: 세션 탭 순서 이동 (드래그) — to 는 표시 목록 기준 삽입 인덱스. 앱은 순서의 단일 출처인 native 레지스트리에 invoke(move_session) 로 위임하고 sessions-changed 반향을 reconcile 이 따라간다. 웹은 로컬 목록을 직접 재배열한다
}
export fn rootOfBackend(backend) -> String? {
  role: 백엔드 핸들 → 그 세션 탭의 root — 강제 정리가 원격 host 를 알아내는 경로
}
export fn activeSessionCtx() -> SessionCtx? {
  role: 활성 세션 컨텍스트 (없으면 null)
}
export fn remoteHost(root) -> String? {
  role: ssh://host/path 또는 ssh://host root 의 host — 원격이 아니면 null (탭 라벨·원격 세션 안 폴더 열기 판정)
}
export fn genSessionId() -> String {
  role: 세션 id 생성 (웹 전용 — 앱은 native 가 발급)
}
export type OpenMode
export fn openWebFolder(root, mode?) {
  role: 웹 '폴더 열기' 확정 — 새 세션 탭 생성·활성화 (host.openFolder 가 부른다). 같은 워크스페이스(꼬리 '/' 정규화 root 문자열 — ssh://host/path 원격은 스킴·호스트가 문자열에 포함돼 (origin, path) 정체성이 그대로 성립)가 이미 열려 있으면 새 탭 대신 그 탭으로 포커스 이동 (빈 탭은 남는다. 명시적 replace 면 이전 탭을 닫되 이전 탭이 빈 세션(Welcome)이면 남긴다 — 2026-09-05 사용자 지시). 대체 대상 = 명시적 mode 'replace'(VS Code 원격 "현재 창에 연결") 또는 mode 생략 시 활성 탭이 빈 세션(앱의 native replace 와 동일 의미) — mode 'new' 는 빈 탭도 남기고 새 탭을 배경에 열어 현재 탭이 활성으로 남는다 (2026-09-05) — 새 탭이 그 자리를 차지하고 이전 탭은 활성화 후 제거 (빈 상태 없음). 원격 탭 라벨은 "이름 [호스트]"
}
export fn openInBackground(root) {
  role: 앱 '새 탭에 연결'(mode 'new')의 포커스 유지 예약 — native 는 활성 탭을 모르므로 front 가 "이 root(normRoot) 가 새로 나타나면 활성화하지 않는다"를 집합에 적어 두고 reconcile 이 소비한다. 대상이 이미 열려 있어 session-focus 만 오면 그때 지운다. 못 맞추면 종전대로 활성화 — 안전한 실패
}
export fn cancelBackground(root) {
  role: openInBackground 예약 취소 — open_folder_path reject 시 host.openFolder 가 부른다
}
export fn replaceAppSession(prevId, newRoot) {
  role: 앱 '현재 탭 대체' 뒷정리 — open_folder_path invoke 뒤 이전 활성 탭을 close_session (native replace 는 빈 세션만 제자리 교체). 같은 워크스페이스 재열기(포커스 이동만)면 root 문자열 대조로 건너뛴다
}
export fn initSessions() {
  role: 앱 전용 — list_sessions 초기 동기화(뒤이어 take_handoff — 분리로 생긴 새 창의 부팅 전 핸드오프) + sessions-changed·session-focus·handoff-available·session-move-request·tabs-move-request 구독 — 구독은 전부 이 창 label 을 target 으로 등록한다 (Tauri 의 target 없는 listen 은 Any 라 native 가 emit_to 로 다른 창에 보낸 이벤트까지 받는다 — 창마다 다른 sessions-changed 가 모든 창에 도달해 서로의 목록으로 reconcile 이 뒤집히는 사고의 원인이었다). reconcile 은 추가분에 컨텍스트를 만들고(새 탭 = 활성 — openInBackground 예약분은 예외) 제거분을 폐기하며 순서는 native 를 따른다. session-focus 는 이미 열린 워크스페이스 재열기 시 native 의 포커스 이동 지시다
}
export fn multiWindow() -> Bool {
  role: 창 간 탭 이동이 가능한 환경인가 — 앱이고 창 label 이 있다 (UI 가 창 밖 드롭·이동 메뉴를 켠다)
}
export fn detachSession(id, x, y) {
  role: 세션 탭 창 밖 드롭 → native detach_session (그 화면 좌표에 새 창, 세션 소속 이전, 핸드오프 적재). 이 창은 sessions-changed 로 탭을 잃고 연결을 닫는다 — 새 창이 같은 id 로 재-attach 해 터미널을 이어받고 핸드오프로 에디터·레이아웃·xterm 버퍼를 복원
}
export fn detachSessionNearby(id) {
  role: 탭 우클릭 Move to New Window — 좌표 없이 이 창 근처에 새 창
}
export fn requestSessionMove(fromWindow, id, toIndex) {
  role: 대상 창의 탭 스트립 드롭 — 세션 상태는 출처 창에 있으니 forward 로 출처에 session-move-request 만 보낸다. 출처가 그 시점 상태를 직렬화해 move_session_to_window 로 확정 (이미 떠난 세션이면 무시 — 창 밖 드롭이 먼저 인식된 경우)
}
export fn moveSessionToWindow(id, toWindow) {
  role: 탭 우클릭 Move to Window … — 출처(이 창)가 곧바로 그 창의 끝에 병합
}
export fn listWindows() -> WindowInfo[] {
  role: native 창 목록(label·세션 이름들) — 이동 메뉴용
}
export fn sessionRoot(id) -> String? {
  role: 세션 root 문자열 — 에디터·터미널 탭 이동은 같은 root 사이에서만 (와이어 경로가 root 상대)
}
export fn detachEditorTab(groupId, tabId, x, y) {
  role: 활성 세션의 에디터 탭 창 밖 드롭 → 탭을 떼어(takeTabForHandoff) native detach_tabs — 같은 root 의 새 세션이 새 창에 뜨고 그 탭을 받는다 (toSession 은 native 가 채움)
}
export fn detachTerminal(id, x, y) {
  role: 활성 세션의 터미널(인스턴스 id) 창 밖 드롭 → 스냅샷(버퍼)+releaseTerminal 후 detach_tabs — 새 창의 세션이 adoptTerminal(와이어 v10)로 데몬 터미널을 가져간다
}
export fn requestTabsMove(fromWindow, pick, to) {
  role: 대상 창의 탭바·터미널 영역 드롭 — forward 로 출처에 tabs-move-request. 출처가 탭을 떼어 tabs-handoff 를 대상 창에 forward 로 바로 보낸다 (native 큐를 거치지 않는다). root 일치 검사는 호출측(UI)이 드래그 데이터의 root 로 미리 한다. 핸드오프 생성은 파괴적(탭 제거·터미널 핸들 해제)이라 invoke 가 거절되면 undoTabsHandoff 로 출처 세션에 되돌린다 (미저장 버퍼·살아 있는 PTY 가 고아가 되지 않게)
}
export fn hasAnyDirty() -> Bool {
  role: 모든 세션의 미저장 문서 여부 — beforeunload 안전망 (배경 탭의 dirty 도 지킨다)
}
export fn allTerminals() -> TerminalInstance[] {
  role: 전 세션 터미널 합집합 — TerminalPane 의 xterm 바인딩 수명 판정용 (배경 세션 것을 죽이지 않기 위해)
}

role: ThinBackend 계약 — 와이어 프로토콜(백엔드 /ws JSON-RPC, v6 부터 대형 readFile 응답은 바이너리 payload 프레임 — 계약 표면(content=string)은 불변, 복원은 ws.ts 몫. v10 adoptTerminal — 세션 간 터미널 이동. v11 readFile 범위 읽기 offset + stat size — hex 뷰어 청크. v12 listFiles → quickOpen: 빠른 열기 목록을 나르지 않고 데몬 캐시에서 검색. v14 writeFile append — 청크 업로드. v16 readDir 절대 경로 + 항목 mtime·size — 폴더 탭의 워크스페이스 밖 탐색·자세히 보기 (v15 는 폐기된 termd 분리 빌드가 소켓 충돌 방지로 건너뛴 번호). v17 내장 tmux — createTerminal attach·listTerminals·killTerminal·renameTerminal·applyTmuxConf·onTerminalMode·TerminalSession.onTmux. v19 copy — 탐색기 드래그 복사)의 TS 사영. 와이어 쪽 대응은 daemon/src 참조

export class TerminalMode {
  role: 데몬의 터미널 방식 (attach 응답, 와이어 v17) — 'tmux'(내장 tmux 서버) | 'plain'(unix 인데 tmux 를 못 써 PTY 직접 — 경고 배지) | 'unsupported'(Windows — 아이콘 없음)
}
export class TerminalInfo {
  role: 살아 있는 tmux 세션 하나 (listTerminals 항목) — id(tmux session id, 이름 바꿔도 불변)·name·root(세션 환경변수 SUPERLITE_TMUX_WORKSPACE_PATH)·attached(붙은 클라이언트 수)·activity·created(unix ms)·command(활성 패널의 현재 명령)
}

export class ConnectStage {
  role: 원격 접속 단계 — 'ssh'(원격 정보 조회·인증) | 'helper'(헬퍼 존재 확인) | 'upload'(헬퍼 업로드) | 'daemon'(원격 데몬 기동·attach 대기). relay 의 connectStage 이벤트 어휘 (ssh-connect-status 합의)
}

port ThinBackend {
  role: 워크스페이스 파일·검색·git·터미널 접근 계약. 구현체 선택은 model/host 조립 지점 한 곳
  impls: { MockBackend, WsBackend, EmptyBackend }
  fn workspace() -> WorkspaceInfo {
    role: 워크스페이스 이름·루트 경로
  }
  fn readDir(path) -> DirEntry[] {
    role: 디렉토리 1층 나열 (트리 lazy 로드 단위). files.exclude 기본값(.git 등 VCS 메타)은 숨긴다 — node_modules 는 보인다. 자식 .git 을 가진 디렉토리 항목은 repo=true (와이어 v13) — 트리 펼침이 곧 하위 저장소 인식. 절대 경로(와이어 v16)면 워크스페이스 밖도 나열 — 항목 path 는 절대('/' 구분), repo 표식 없음 (git RPC 는 루트 상대). 폴더 탭 전용. 항목에 mtime(ms)·size(파일만) 동봉(v16) — 폴더 탭 자세히 보기의 열·정렬
  }
  fn readFile(path, maxBytes?, encoding?, offset?) -> FileContent {
    role: 파일 내용 + 그 시점 디스크 etag. 크기 초과(maxBytes 또는 데몬 기본 상한 50MB)·이진/비 UTF-8 은 에러가 아니라 unopenable(사유 kind·실측 size)로 반환 — 탭은 열리고 편집기 자리에 안내 화면이 뜬다 (etag 는 이때도 온다 — orphan 재검증·재로드용). 실존하지 않는 경로 등 실제 실패만 에러. maxBytes 는 undo 캡처 등 호출측 상한 (초과 파일을 읽어 나르지 않는다). encoding='base64' 면 UTF-8 검증 없이 바이트를 base64 content 로 나른다 (이미지 뷰어 등 — writeFile 이진 통로와 대칭, binary unopenable 은 안 생기고 크기 상한만 남는다). offset 이 있으면(base64 전용, 와이어 v11) 범위 읽기 — 크기 상한 없이 offset 부터 maxBytes 만큼, EOF 넘어가면 짧게 (hex 뷰어 청크). 루트 상대 외에 절대 경로도 허용 — 워크스페이스 밖 파일 열기 (OS 드롭, VS Code 파리티)
  }
  fn stat(path) -> FileStat {
    role: 내용 없이 실존·변경만 확인하는 경량 etag 스냅샷 + 바이트 크기 size(와이어 v11, hex 뷰어의 범위 읽기 기준) — 정규 파일 전용(디렉토리는 에러). orphan 재검증용. readFile 과 같이 절대 경로 허용
  }
  fn writeFile(path, content, etag?, encoding?, append?) -> WriteResult {
    role: 저장. etag 제시 시 낙관적 충돌 검사 — stale 이면 미기록으로 conflict 반환, 생략 시 무조건 쓰기. readFile 과 같이 절대 경로 허용. encoding='base64' 면 content 를 이진으로 디코드해 쓴다 (클립보드 이미지 저장 등 — 텍스트 전제 와이어의 이진 통로). append=true(와이어 v14)면 etag 검사 없이 기존 파일 끝에 덧붙인다 — 청크 업로드(transfer)의 후속 조각, 첫 조각은 append 없이 써 파일을 새로 만든다
  }
  fn quickOpen(pattern, fresh?) -> QuickOpenResult {
    role: Quick Open 후보 검색 (와이어 v12, VS Code anythingQuickAccess 방식) — 전체 파일 목록은 데몬이 걷어 세션 캐시로 들고, 프론트는 패턴마다 상위 512건(items: path + 파일명 하이라이트 인덱스, limitHit)만 받는다. 종전 listFiles(목록 전체를 init 에 나르기 — 홈 디렉터리 5만 파일 4MB 가 저속 링크에서 뒤따르는 readDir 응답을 수 초 막아 스피너가 여럿 뜨던 원인)를 대체. 매칭은 파일명 subsequence 우선, 실패 시 전체 경로(하이라이트 없음). fresh=true 면 캐시를 버리고 다시 걷는다 — 무효화 판단(생성·삭제 이벤트·재접속·수동 새로고침)은 프론트 files 모듈 몫. 걷는 규칙: dotfile 포함, .gitignore·files/search.exclude 제외, WALK_MAX 상한
  }
  fn browseDir(path) -> name[] {
    role: '폴더 열기' 경로 탐색용 — 임의 절대 경로의 하위 디렉토리 이름 나열 (정렬됨). 옵셔널 — mock 은 가짜 트리 밖 경로가 없어 미구현이고, 존재 자체가 웹 '폴더 열기' 커맨드 등록의 지원 신호다
  }
  fn search(query, opts) -> FileSearchResult[] {
    role: 내용 전문 검색 (디스크 기준, dirty 버퍼 미반영) — 제외 규칙은 quickOpen 과 동일
  }
  fn createFile(path) {
    role: 빈 파일 배타적 생성 — 중간 디렉토리 자동 생성, 이미 존재하면 에러 (기존 내용 보호)
  }
  fn createDir(path) {
    role: 디렉토리 배타적 생성 — 중간 디렉토리 자동, 이미 존재하면 에러 (undo 의 "내가 만든 것" 전제 보호)
  }
  fn rename(from, to) {
    role: 이름 변경/이동 — 대상이 이미 존재하면 에러
  }
  fn copy(from, to) {
    role: 파일·디렉토리 복사 (와이어 v19, 디렉토리 재귀) — 대상이 이미 존재하거나 자기 하위면 에러. 탐색기 Ctrl+드래그 복사 (explorer-multiselect-dnd)
  }
  fn delete(path) {
    role: 파일·디렉토리 삭제 (디렉토리는 재귀, 휴지통 없음 — 안전장치는 프론트 confirm, undo 는 파일 한정)
  }
  fn gitRepos() -> repo[] {
    role: 워크스페이스 안 git 저장소 자동 탐색 (와이어 v13) — 루트 포함, 루트 상대 디렉토리 목록(루트는 ''). 깊이·개수 상한은 데몬 몫 — 더 깊은 저장소는 readDir 의 repo 표식(트리 펼침)으로 닿는다. 이하 git* 의 repo 는 이 목록의 원소, path 계열 인자·결과는 그 저장소 기준 상대 경로
  }
  fn gitStatus(repo) -> GitStatus {
    role: 브랜치 + HEAD 커밋 해시 + 변경 목록 (항목마다 staged 플래그 — 한 파일이 인덱스·워킹트리 양쪽에 변경이 있으면 항목 둘). head 는 diff original 캐시 무효화 키 — 앱 밖 커밋(터미널 git)도 잡는다. 저장소가 아니면 branch·head 둘 다 '' (unborn 은 branch 가 있다)
  }
  fn gitOriginalContent(repo, path) -> content {
    role: diff 의 original 쪽 — HEAD 시점 내용
  }
  fn gitCommit(repo, message) {
    role: 인덱스(staged)만 커밋 — 전체 커밋은 호출측이 gitStage 로 먼저 올린다
  }
  fn gitStage(repo, paths) {
    role: 파일들을 인덱스에 올린다 (삭제도 스테이징)
  }
  fn gitUnstage(repo, paths) {
    role: 파일들을 인덱스에서 내린다 (워킹트리 유지)
  }
  fn gitDiscard(repo, paths, untracked) {
    role: 워킹트리 변경 되돌리기 — paths 는 인덱스 내용으로 복원, untracked 는 파일 삭제. 파괴적 — 확인은 호출측
  }
  fn gitLog(repo, limit) -> GitLogItem[] {
    role: HEAD 부터 최근 커밋 (해시·제목·작성자·상대 시각). unborn/비 git 은 빈 배열
  }
  fn gitBranches(repo) -> name[] {
    role: 로컬 브랜치 이름 목록
  }
  fn gitCheckout(repo, branch) {
    role: 브랜치 전환 — 충돌 등 실패는 reject
  }
  fn gitFetch(repo) {
    role: 원격 동기화 (와이어 v18) — 인증은 그 머신의 credential helper 가 먼저, 비었을 때 뒤에 덧붙인 데몬 helper 모드가 onRequest('credential', {action,host,…}) 를 보낸다 (host.ts → gitauth). 실패는 git stderr 로 reject
  }
  fn gitPull(repo) {
    role: gitFetch 와 같은 인증 경로의 pull
  }
  fn gitPush(repo) {
    role: gitFetch 와 같은 인증 경로의 push — 상류 없는 브랜치는 origin 에 같은 이름으로 (push.autoSetupRemote)
  }
  fn createTerminal(cols, rows, attach?) -> TerminalSession {
    role: PTY 세션 생성. attach(와이어 v17)는 새 셸 대신 기존 tmux 세션 id 에 붙는다 — 같은 세션을 여러 탭·창이 동시에 본다. onTmux 콜백으로 붙은 세션 {id,name} 또는 plain 대체 사유가 온다. (동기 핸들, 데이터·셸 종료는 콜백 — onExit 는 셸 자연 종료에만 exit code 와 함께 발화(spawn 실패는 null), dispose 로 인한 정리에는 발화하지 않는다). onData 콜백은 done 을 함께 받는다 — 구독자(xterm)가 청크 처리를 마치면 호출해야 하는 렌더러 배압 신호 (WsBackend 가 ack 시점으로 쓴다, mock 은 생략)
  }
  fn listTerminals(all?) -> TerminalInfo[] {
    role: 살아 있는 tmux 세션 목록 (와이어 v17, 옵셔널 — WsBackend 만) — 기본은 이 워크스페이스, all 이면 서버 전부. plain·unsupported 데몬은 빈 배열
  }
  fn killTerminal(id) {
    role: tmux 세션 종료 (강제 닫기 — 프로세스가 죽는다). 탭 닫기는 detach 라 세션이 남는다
  }
  fn renameTerminal(id, name) {
    role: tmux 세션 이름 변경 (와이어 v17)
  }
  fn applyTmuxConf(content) -> message {
    role: 클라이언트 tmux.conf 를 이 데몬에 적용 — 반환은 tmux 의 경고·오류 문자열 ('' 이면 정상)
  }
  fn onTerminalMode(cb) {
    role: 데몬의 터미널 방식 구독 — attach 응답마다 (mode, error)
  }
  fn adoptTerminal(opts) -> TerminalSession {
    role: 기존 데몬 터미널을 이 연결의 핸들로 잡는다 (옵셔널 — WsBackend 만, 탭을 다른 창으로 옮기기). term 만: 같은 세션이 소유한 터미널(세션 탭 분리 — 같은 session id 재-attach)의 로컬 핸들 재구성, 데몬 요청 없음. from: 같은 root 의 다른 세션이 소유한 터미널을 데몬에서 이 세션으로 옮긴다 (와이어 v10 adoptTerminal, 새 로컬 id 발급). 이동 실패는 onExit(null) 로 드러난다. TerminalSession.release 는 로컬 핸들만 놓는다 (데몬 터미널은 살림 — 받는 쪽이 adopt)
  }
  fn onFsChanges(cb) {
    role: 외부 파일 변경 배치 구독 (옵셔널 — mock 은 외부 변경이 없다)
  }
  fn onConnection(cb) {
    role: 연결 상태 변화 구독 (옵셔널 — mock 은 끊길 일이 없다). 재연결 시 true — 구독자가 전체 리프레시로 재동기화한다. error 동반 false = 영구 실패(원격 ssh 접속 실패, close 4502) — 재연결하지 않는다
  }
  fn onConnectStage(cb) {
    role: 원격 접속 단계 구독 (옵셔널 — WsBackend 만; relay 의 connectStage 이벤트 ssh→helper→upload(bytes)→daemon, 데몬 와이어 밖이라 WIRE_VERSION 불변). attach 응답 도달 시 null(완료). 실패(onConnection error)는 마지막 단계에서 난 것
  }
  fn reconnect() {
    role: 영구 실패(4403·4502) 뒤 사용자 주도 재접속 (옵셔널 — WsBackend 만). 실패하지 않은 연결에는 무동작
  }
  fn onInputBlocked(cb) {
    role: 터미널 입력 배압 상태 구독 (옵셔널 — mock 은 즉시 소화라 미구현). 미소화 입력이 창(1M chars)을 넘어 전송을 멈추면 (TerminalSession.id, true), 대기분이 모두 나가면 false. 셸이 입력을 읽지 않는 상황을 사용자에게 표면화하는 통로
  }
  fn onSessionLost(cb) {
    role: 재연결됐지만 데몬 세션이 회수된 경우(장기 끊김) 구독 (옵셔널). cb 는 죽은 터미널의 TerminalSession.id 목록을 받는다 — 끊김 중에 만들어진 터미널은 새 세션에 살아 있으므로 전체가 아니라 명단만 정리해야 한다
  }
  fn dispose() {
    role: 연결·핸들 정리 (세션 닫기·창 회수). 옵셔널 — WsBackend(소켓 닫기·재연결 중단)·MockBackend(타이머)만, EmptyBackend 는 없다. 호출은 sessions 의 세션 제거·서브 창 회수
  }
  fn onRequest(cb) {
    role: 데몬 소켓 요청자(셸 심 등, ticket cli-open-command)가 이 세션에 보낸 요청 구독 (와이어 v9, 옵셔널 — mock·빈 세션은 요청자가 없다). 데몬은 method·params 를 해석하지 않는 범용 통로 — 어떤 요청이 있는지는 구독자(host.ts 조립 지점)의 몫. cb 반환값이 요청자에게 result 로, throw 는 error 로 돌아간다 (왕복). 구독 부재는 구현체가 에러로 답한다
  }
}

export type WorkspaceInfo
export type DirEntry
export type SearchMatch
export type FileSearchResult
export type GitChangeKind
export type GitChange
export type GitStatus
export type GitLogItem
export type FsChange
export type QuickOpenItem
export type QuickOpenResult
export type FileContent
export type Unopenable
export type FileStat
export type WriteResult
export type TerminalSession

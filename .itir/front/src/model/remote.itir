import { backendApiUrl, openFolder } from './host'
import { OpenMode } from './sessions'

role: 원격 탐색기 (SSH) 모델 — 백엔드 머신의 ~/.ssh/config 호스트 목록(/ssh/hosts)에 superlite 자체 상태(즐겨찾기·고정·최근 폴더·pane 접힘)를 합친 것. FAVORITE = 사용자가 고른 host (즐겨찾기 순), 고정(fix)은 즐겨찾기에서만 — 고정 시점 config 블록의 저장본으로 접속(사라져도 남음), 저장본≠현재 config 면 drift(이탤릭), 고정 안 한 즐겨찾기가 config 에서 사라지면 missing(접속 불가). ALL = config 전체(즐겨찾기는 별 표시). 최근 폴더 = 호스트 행 하위 항목(VS Code Remote Explorer 식 한 줄 트리 행 — 이름 + 흐린 전체 경로). 상태 파일의 items 스키마(pin·그룹, ticket remote-path-items)는 relay 에 남아 있으나 프론트는 recentOf 로 평면 단일 아이템 목록으로 펴서 보이고 편집은 pin 토글(togglePin — 상단 고정, 행에 pinned 아이콘)·제거(forgetItem)뿐으로 결과 목록을 set-items 로 보낸다 — 그룹·별칭·DnD 는 2026-09-11 사용자 결정으로 UI 에서 걷어냈고 pin 만 남겼다(ticket remote-explorer-vscode-style). 행 클릭은 선택이고 hover 의 →/새 탭이 접속 (호스트 행과 동일 mode 규칙). 호스트 행의 펼침은 호스트별 지속(collapsed, 기본 펼침). pane 접힘은 전역 지속 — 초기값만 백엔드가 한 번 정한다(즐겨찾기가 없으면 FAVORITE 닫힘·ALL 열림), 그 뒤는 사용자가 접고 펼친 대로 (2026-09-07 개정). 상태 파일은 백엔드가 단일 출처 — 변경(/ssh/state) 응답이 곧 갱신 목록. 호스트 접속은 경로 없는 ssh://host 로 원격 빈 세션(시작 페이지)을 연다 — 폴더는 그 세션의 '폴더 열기'가 원격을 탐색해 고른다. 세션과 무관한 앱 전역 상태

export type RemoteHost
export type PathItem
export type PathGroup
export type RemoteItem
export type HostList
export type RemoteOp
export val remote

export fn isGroup(item) -> Bool {
  role: 경로 아이템이 그룹인가 ('paths' 유무)
}
export fn remoteEnabled() -> Bool {
  role: 원격 탐색기 표시 여부 — 백엔드 HTTP API 가 없는 환경(mock)은 감춘다
}
export fn refreshHosts() {
  role: 호스트 목록 (재)로드 — 뷰 마운트·세션 목록 변경·사이드바 타이틀 액션이 부른다, 실패 메시지는 뷰 본문에
}
export fn setHostState(op, host, extra?, body?) {
  role: 상태 변경 — fav·unfav·pin·unpin·ack(이 경고 숨김)·refresh(최신 상태로 갱신)·set-items(body = 아이템 JSON, text/plain 이라 preflight 없음)·pane(extra.open)·expand(호스트 행 펼침, extra.open). POST /ssh/state 응답으로 교체
}
export fn setPaneOpen(pane, open) {
  role: pane 접힘 토글 — 로컬 즉시 반영 + 전역 지속
}
export fn setHostExpanded(host, open) {
  role: 호스트 행의 최근 폴더 펼침 토글 — 로컬 즉시 반영 + 호스트별 지속 (op expand). 같은 host 는 두 pane 이 공유
}
export fn connectHost(host, mode) {
  role: 호스트 접속 — 경로 없는 `ssh://host` 를 host.openFolder 에 (원격 빈 세션 — 시작 페이지 + 그 호스트 탐색). mode 'replace'=현재 탭 대체(arrow-right) / 'new'=항상 새 탭(empty-window — 활성 탭이 빈 세션이어도 대체하지 않는다)
}
export fn openRecent(host, path, mode) {
  role: 경로 아이템으로 접속 — ssh://host/path 를 host.openFolder 에, mode 규칙은 connectHost 와 동일
}
export fn recentOf(host) -> items {
  role: 호스트의 최근 폴더 — items 를 평면 단일 아이템 목록으로 편다 (그룹은 멤버를 차례로, pin 은 그룹의 것을 물려받음, 같은 경로는 처음 것만)
}
export fn togglePin(host, path) {
  role: 상단 고정 토글 — 평면 목록에서 그 경로의 pinned 를 뒤집어 set-items 로 (relay 가 pin 을 위로, 옛 파일의 그룹은 첫 편집 때 풀린다)
}
export fn forgetItem(host, path) {
  role: 최근 목록에서 제거 — 평면 목록에서 그 경로를 빼고 set-items 로
}

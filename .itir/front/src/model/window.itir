import { tauri } from './tauri'
role: Tauri 창 제어 (앱 전용) — withGlobalTauri 전역(__TAURI__)으로 현재 창의 최소화·최대화 토글·닫기·줌을 노출하고, resize 이벤트로 최대화 상태를 추적한다 (최대화/복원 아이콘 전환용). windowLabel 은 이 창의 Tauri label(native 주입 __SUPERLITE_WINDOW__) — 창 간 탭 이동에서 출처·대상 주소. 브라우저에서는 inApp=false·windowLabel null 이고 TitleBar 가 창 제어 버튼 자체를 숨긴다. ownerWindow 는 서브 창(에디터·터미널 탭 분리로 생긴 창)의 소속 메인 label(native 주입 __SUPERLITE_OWNER__), subWindow 는 그 유무 — 메인 창(첫 창·세션 탭 분리 창)·웹·mock 은 null (decision/workspace-session-tabs.md 2026-09-08 개정). bootActiveSession 은 부팅 시 묶음의 활성 세션(__SUPERLITE_ACTIVE__). destroyWindow 는 onCloseRequested 를 거치지 않는 파괴, onWindowCloseRequested 는 X·OS 닫기 요청을 막고 핸들러를 부른다 — 서브 창이 탭을 메인에 되돌린 뒤 닫는 경로

export val inApp
export val appWindow
export val windowLabel
export val ownerWindow
export val subWindow
export val bootActiveSession
export fn minimizeWindow() {
  role: 창 최소화
}
export fn toggleMaximizeWindow() {
  role: 최대화/복원 토글
}
export fn zoomWindow(action) {
  role: 앱 전체 웹뷰 줌 — native set_zoom 커맨드 호출 ('in'·'out'·'reset'). 레벨·저장·모든 창 적용은 native 몫 (app/src/main set_zoom). 웹은 무동작
}
export fn destroyWindow() {
  role: 창 파괴 — 닫기 요청 훅 없이. 서브 창이 탭을 되돌린 뒤 스스로 닫을 때
}
export fn onWindowCloseRequested(handler) {
  role: 닫기 요청(X·Alt+F4) 가로채기 — preventDefault 후 handler. 웹은 무동작
}
export fn closeWindow() {
  role: 창 닫기 — 이 창의 X. native 는 그 창의 세션만 정리하고 다른 창은 두며, 마지막 창이면 앱이 종료된다 (app/src/main 참조)
}

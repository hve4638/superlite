import { ctx, viewOf } from './ctx'
import { createEditors } from './editors'
import { notify } from './notifications'
import { GitChangeKind, GitLogItem, ThinBackend } from '../backend/types'

role: SCM 뷰 상태 — git 변경 목록(staged/unstaged 분리), 스테이징·discard·커밋, 최근 커밋 로그, 브랜치 전환, 트리·탭 장식(색/문자). 세션별 팩토리(createScm) + 활성 세션 전달 shim

export type ScmChange
export val scm
export val CHANGE_LETTER
export val CHANGE_COLOR

export fn createScm(backend, editorsM) {
  role: 세션별 SCM 모듈 생성 — 변경 클릭이 여는 diff·파일이 같은 세션의 editors 인스턴스로 가도록 묶는다
}
export fn refreshScm() {
  role: gitStatus 재조회로 변경 목록·head 해시 갱신 — head 변화가 diff original 캐시를 무효화한다. head·브랜치가 움직였을 때만 gitLog 도 다시 받는다 (파일 저장마다 로그를 나르지 않는다). 겹친 조회는 마지막 발행분만 반영 (역순 완료가 head 를 과거로 되돌리지 않게)
}
export fn openChange(change) {
  role: 변경 클릭 — untracked/added 는 파일로, 삭제는 HEAD 내용 읽기 전용 보기, 나머지는 diff 로 연다
}
export fn openChangeFile(change) {
  role: 행의 Open File 액션 — diff 가 아니라 파일 자체를 연다
}
export fn commit() {
  role: staged 항목만 커밋 — staged 가 없으면 no-op (ScmView 가 버튼·Ctrl+Enter 를 비활성화). 후 상태 재조회, 실패는 notify
}
export fn stage(changes?) {
  role: 파일별(인자) 또는 unstaged 전체 스테이징 — 실패 notify 후 재조회
}
export fn unstage(changes?) {
  role: 파일별(인자) 또는 staged 전체 언스테이징
}
export fn requestDiscard(changes?) {
  role: discard 확인 대기 상태(scm.discardConfirm) 진입 — 파괴적이라 바로 실행하지 않는다, 대화상자는 ScmView
}
export fn confirmDiscard() {
  role: 대기 중인 discard 실행 — 추적 파일은 인덱스 내용으로 복원, untracked 는 삭제. 열린 편집기 재로드는 파일 감시가 담당
}
export fn cancelDiscard() {
  role: discard 확인 취소
}
export fn branches() {
  role: 로컬 브랜치 목록 (브랜치 메뉴 열 때마다 조회)
}
export fn checkout(branch) {
  role: 브랜치 전환 — 현재 브랜치면 no-op, 실패(충돌 등)는 notify
}
export fn decorationFor(path, isDir) -> Decoration? {
  role: 탐색기·탭에 붙는 git 장식 (디렉토리는 자손 변경 전파)
}

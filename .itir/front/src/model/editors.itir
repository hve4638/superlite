import { ctx, viewOf } from './ctx'
import { notify } from './notifications'
import { FileContent, ThinBackend, Unopenable, WriteResult } from '../backend/types'

role: 탭·그룹·문서 상태와 열기/저장/충돌 처리. 열 수 없는 파일(크기 초과·이진)도 탭은 열린다 — doc.unopenable 에 사유를 실어 UI 가 편집기 대신 안내 화면을 띄운다 (content 는 '' 고정이라 dirty·저장 경로가 자연히 막힌다). 이미지 확장자(imageMime)는 readFile encoding=base64 로 읽어 doc.image 에 싣는다 — UI 가 편집기 대신 이미지 뷰어를 띄우고, content '' 고정은 unopenable 과 같다 (크기 상한 초과는 이미지도 unopenable(large) 안내). 이미지 뷰어의 해상도·배율 상태는 path 키 imageView 맵 (배율은 'fit' 또는 원본 대비 숫자 — 휠 줌) — ImageView 가 세우고 statusbar 가 활성 탭 경로로 읽는다 (rename·삭제·창 이동 정리는 docs·hex·folderView 와 함께 — 경로 키 맵 목록 pathMaps 를 세 함수가 공유). 문서(docs)는 탭과 분리 — 같은 파일을 여러 탭이 공유한다. 그룹 목록(groups)은 flat 이고 화면 배치는 별도의 행/열 중첩 트리(layout)가 담당 — 순회 로직은 flat 목록만 알면 된다. 외부 삭제된 열린 파일은 orphaned 집합으로 표시(탭 유지 — VS Code closeOnFileDelete=false)하고 저장이 부활시킨다. 세션별 팩토리(createEditors) + 활성 세션 전달 shim. monaco 훅 슬롯(applyExternalEdit·disposeModels)은 세션 공용 모듈 슬롯 — 훅은 UI 능력이지 세션 상태가 아니다

export type FileTab
export type DiffTab
export type HexTab
export type PreviewTab
export type FolderTab
export type FolderStyle
export type FolderSortKey
export val folderPrefs
export fn toggleFolderPreviewPane() {
  role: 폴더 탭 미리보기 창(details·icons 스타일의 오른쪽 창) 토글 — 전역 folderPrefs.previewPane, localStorage 기억
}
export type TerminalTab
export type Tab
export type EditorGroup
export type LayoutNode
export type LayoutBranch
export type SplitSide
export type Doc
export type HexDoc
export type EditorsSnapshot
export type TabHandoff
export val editors
export val HEX_CHUNK

export fn createEditors(backend, isActive?) {
  role: 세션별 에디터 모듈 생성 (터미널 탭 헬퍼: openTerminalTab·closeTerminalTabs·renameTerminalTab(tmux 세션 이름)·focusTerminalTab(사이드바에서 열린 세션 선택)) — isActive 는 이 세션이 활성인지 (기본 항상 참) — monaco 훅(applyExternalEdit·disposeModels)이 세션 공용 슬롯이라 배경 세션의 문서 변경이 활성 세션의 monaco 를 건드리지 않도록 훅 호출을 막는 교차 세션 불변식. 그룹·배치·문서·undo 이력이 팩토리 클로저에 산다. 창 이동(앱): snapshot/restore 는 세션 통째(그룹·배치·문서 버퍼 — JSON 왕복, undo·커서는 잃는다), takeTabForHandoff 는 탭 하나를 닫기 확인·이력 없이 떼어 탭+문서 버퍼로 만든다(마지막 참조면 버퍼·monaco 모델 폐기, 빈 그룹 접기; 터미널 탭은 탭만 떼고 문서 정리 없음 — PTY 몫은 sessions 가 terminals.snapshot/release 로), acceptTab 은 넘어온 탭을 그룹/index 에 붙인다 (이쪽에 같은 문서가 열려 있으면 이쪽 버퍼 유지, 버퍼 없는 탭은 디스크에서 열기, hex·folder 탭은 문서 없이 붙이고 뷰가 다시 읽는다; 터미널 탭은 받지 않는다 — adoptTerminals 가 새 인스턴스로 탭을 다시 연다). restore 는 스냅샷의 터미널 탭을 걷어낸다 — 인스턴스 id 가 창마다 달라 adoptTerminals 가 새로 연다. 터미널 탭(TerminalTab — 'terminal:'+인스턴스 id, path 없음, terminal-usability 2026-09-07)은 인스턴스 전용 API 로만 다룬다 (shim 없음, 같은 세션의 createTerminals 가 쓴다): openTerminalTab(term, name, at?) 은 탭을 at 그룹·index(창 간 드롭 위치, 없으면 활성 그룹 끝)에 연다, closeTerminalTabs(term) 은 셸 종료·세션 회수의 탭 몫으로 모든 그룹에서 닫는다, setTerminalCloser(fn) 은 탭 × (closeTab) 가 PTY 를 정리할 훅 등록 — editors 가 terminal 모듈을 모르기 위한 seam (이동·핸드오프의 takeTab 은 부르지 않는다)
}
export fn activeGroup() -> EditorGroup {
  role: 활성 에디터 그룹
}
export fn activeTab() -> Tab? {
  role: 활성 그룹의 활성 탭
}
export fn baseName
export fn openFile(path, opts) -> Bool {
  role: 파일 열기 — preview 탭 교체 규칙 포함 (VS Code 단일/더블 클릭 구분). focus:false 면 에디터 포커스 요청(pendingFocus)을 세우지 않는다 — 트리 단일 클릭은 포커스가 트리에 남는다. 탭은 readFile 전에 즉시 뜬다 (문서 없는 파일 탭 = 로드 중, UI 가 빈 본문으로 그린다) — 읽기 실패는 탭을 걷고 notify 후 false. 로드가 800ms 를 넘긴 탭 id 는 editors.slowTabs 에 오른다 (trackLoad — hex 탭의 stat·청크 읽기, preview 탭의 readFile 도 같은 표식. VS Code editorOperation 800ms 지연 progress)
}
export fn openFileAt(path, line) {
  role: 열고 지정 라인으로 스크롤 (검색 결과 클릭)
}
export fn openFolderTab(path, opts?) {
  role: 폴더 탭('folder:'+path, 폴더명 — 루트 '' 는 '/') 열기 — 탐색기 폴더 드래그 드롭(중앙)·타이틀바 폴더 아이콘(루트, 클릭 또는 드래그)·닫은 탭 복원·핸드오프 재개방의 진입점. opts.groupId 그룹(기본 활성 그룹)의 opts.index 자리(기본 끝)에 고정 탭(style 은 folderPrefs.style, 이력 [path], 정렬 name↑), 같은 폴더 탭이 그 그룹에 있으면 활성화만. groupId 지정이 없으면(탐색기 메뉴 'Open in New Tab'·타이틀바 클릭) 어느 그룹에든 이미 열린 같은 폴더 탭으로 포커스만 옮긴다. 문서 없음 — 나열은 FolderView 가 files.acquireDir 로, 커서는 path 키 folderView 맵({cursor, index} — pathMaps 에 포함되어 rename 이관·삭제·창 이동 정리를 같이 받는다) (ticket explorer-folder-tab, 2026-09-07)
}
export fn openFolderTabSplit(path, refGroupId, side) {
  role: 탐색기 폴더 드래그 드롭(가장자리) — refGroupId 상하좌우의 새 그룹에 폴더 탭을 연다 (openFileSplit 의 폴더판)
  depends: { openFolderTab, addGroupBeside }
}
export fn addGroupBeside(refGroupId, side) -> groupId? {
  role: 빈 새 그룹을 refGroupId 상하좌우에 만든다 — 가장자리 드롭(폴더 탭·새 터미널)의 공통 몸체. 호출측이 곧바로 동기로 탭을 넣는다 (못 넣으면 빈 그룹이 남는다). ref 가 없으면 null
}
export fn navigateFolderTab(groupId, tabId, path, opts?) {
  role: 폴더 탭 안 이동(yazi 의 cd) — 탭을 제자리에서 다른 폴더로 바꾼다 (id·path·name 동시 갱신, FolderView 인스턴스는 그대로 path 를 따라간다). 탭 이력(history·histIndex): opts.via 가 back/forward 면 자리만 옮기고, 새 이동은 앞쪽 이력을 버리고 쌓는다 (브라우저 동일). 그 그룹에 목적지 폴더 탭이 이미 있으면 이 탭을 접고 그쪽을 활성화 (그룹 안 id 유일)
}
export fn setFolderStyle(groupId, tabId, style) {
  role: 폴더 탭 보기 스타일(FolderStyle: columns = yazi 3열 / details = Windows 탐색기 자세히 / icons = 큰 아이콘) — 그 탭만 바꾸고 folderPrefs.style(새 탭 기본값, localStorage)로 기억
}
export fn setFolderSort(groupId, tabId, key) {
  role: 폴더 탭 정렬(FolderSortKey: name·mtime·type·size, details·icons 전용) — 같은 열이면 방향 토글, 다른 열이면 오름차순 (Windows 탐색기 머리글 동일). columns 는 항상 이름순
}
export fn openHex(path) {
  role: hex 뷰어 탭('hex:'+path, "x (Hex)") 열기 — 활성 그룹에 고정 탭. 바이트는 docs 와 분리된 path 키 hex 맵(HexDoc)에 두고 HexView 가 ensureHex·loadHexChunk 로 lazy 로드한다 (창 이동·복원·재열기가 같은 경로로 수렴). 텍스트 문서와 공존 — 이진 unopenable 안내의 "Open in Hex Editor" 와 명령 팔레트가 진입점
}
export fn ensureHex(path) {
  role: hex 문서(HexDoc: size + 청크 캐시)가 없으면 stat 으로 크기만 세운다 — 바이트는 통째로 읽지 않는다 (GB 파일). 외부 변경(reloadDocFromDisk)·rename·삭제 시 맵 엔트리를 비우거나 이관해 다음 표시가 다시 읽게 한다
}
export fn loadHexChunk(path, idx) {
  role: HEX_CHUNK(64KB) 단위 범위 읽기(readFile offset, 와이어 v11) — HexView 가 보이는 행의 청크만 요청한다. 진행 중 중복 요청 억제, 경로당 캐시 상한(64 청크) 초과 시 오래된 것부터 폐기, 왕복 중 문서가 갈렸으면 버린다. 실패는 조용히 (다음 스크롤이 재시도)
}
export fn openHtmlPreview(path) {
  role: HTML 프리뷰 탭('preview:'+path, "Preview x")을 활성 그룹에 열기 — 닫은 탭 복원·창 간 이동의 재개방 경로. 이미 열려 있으면 그 탭 활성화. 문서는 같은 path 의 doc 을 공유하고 HtmlPreview 는 savedContent(저장분)만 그린다 — 편집 버퍼는 반영하지 않는다. 프리뷰·hex 탭은 dirty 표시를 받지 않는다
}
export fn toggleHtmlPreview(groupId, tabId) {
  role: HTML 편집기 ↔ 프리뷰 제자리 전환 (Ctrl+Shift+V, 탭바 아이콘) — 탭을 같은 자리에서 다른 종류(id 가 다름)로 바꾼다. 문서 공유라 dirty 버퍼 유지, 프리뷰 상태에서 탐색기로 같은 파일을 열면 편집기 탭이 따로 열린다. 바꿀 종류의 탭이 그 그룹에 이미 있으면 현재 탭을 접고 그쪽 활성화. .html 이 아닌 file 탭·diff·hex 는 no-op
}
export fn openDiff(path, opts?) {
  role: SCM diff 탭 열기 — modified 쪽은 워킹트리 문서 그 자체. opts.deleted 면 워킹트리에 없는 파일 — 문서를 만들지 않고 deleted 탭으로 열어 HEAD 내용을 읽기 전용 편집기로 보여 준다 (MonacoHost 분기, dirty·저장 없음)
}
export fn setActiveTab(groupId, tabId) {
  role: 탭·그룹 활성화 + 에디터 포커스 요청 (탭 클릭은 항상 에디터로 포커스 — VS Code 동일)
}
export fn pinTab(groupId, tabId) {
  role: preview 탭 고정 — 탭 더블클릭 (VS Code 동일)
}
export fn closeTab(groupId, tabId, force) {
  role: 탭 닫기 — 빈 분할 그룹은 접고 이웃으로 포커스. 닫힌 탭은 복원 이력에 쌓인다 (터미널 탭 제외 — 대신 terminalCloser 훅으로 PTY 를 정리). dirty 문서의 마지막 참조 탭(같은 path 의 diff 탭 포함해 하나뿐)이면 곧장 닫지 않고 closeConfirm 을 세워 Save/Don't Save/Cancel 대화상자에 위임한다 (VS Code 동일 — 조용한 닫기는 버퍼가 몰래 살아남는 혼동을 낳는다). force 는 확인 생략 — confirm 처리부·삭제(closePathTabs)용
}
export fn confirmCloseSave() {
  role: 닫기 확인 Save — 저장(saveDoc) 성공 시에만 닫는다. 실패·충돌은 탭 유지 (충돌은 saveConflict 토스트가 이어받는다)
}
export fn confirmCloseDiscard() {
  role: 닫기 확인 Don't Save — 버퍼(docs)·orphan 표시·monaco 모델을 버려 다음 열기가 디스크를 읽게 하고 닫는다
}
export fn confirmCloseCancel() {
  role: 닫기 확인 Cancel — 대화상자만 닫고 탭·버퍼 유지
}
export fn reopenClosedEditor() {
  role: 마지막으로 닫은 탭 복원 (Ctrl+Shift+T) — 활성 그룹에 고정 탭으로 연다 (file·diff·hex·preview·folder — 터미널은 이력에 없다)
}
export fn hasDirtyDocs() -> Bool {
  role: 미저장 문서 존재 여부 — 탭 닫힘(beforeunload) 안전망 판정용
}
export fn splitActiveEditor() {
  role: 활성 탭을 오른쪽 새 그룹으로 분할 (폴더 탭은 같은 폴더의 폴더 탭으로, 터미널은 no-op) (터미널 탭은 no-op)
}
export fn moveTabToGroup(fromGroupId, tabId, toGroupId, index) {
  role: 탭 드래그 드롭 — 다른 그룹의 index 위치로 이동(생략 시 끝) 또는 같은 그룹 내 순서 변경. preview 해제, 대상에 같은 탭이 있으면 합류(활성화만), 빈 원 그룹은 접는다
}
export fn moveTabSplit(fromGroupId, tabId, refGroupId, side) {
  role: 탭을 새 그룹으로 분리 — refGroupId 의 상하좌우(side) 에 생성. 단일 탭 그룹의 자기 분리는 no-op (결과가 제자리)
}
export fn openFileSplit(path, refGroupId, side) {
  role: 탐색기 드래그 드롭 — 파일을 refGroupId 상하좌우의 새 그룹에 연다. 읽기 실패 시 빈 그룹 잔재를 접는다
}
export fn resizeSplit(branch, boundary, startSizes, deltaPx, totalPx, minPx) {
  role: 분할 경계 드래그 — 경계 앞뒤 자식의 비율만 재분배 (합 보존, 최소 크기 클램프). 드래그 시작 스냅샷(startSizes) 기준 누적 델타. 순수 함수 — 세션 무관 (인자로 받은 branch 에 쓴다)
}
export fn updateContent(path, content) {
  role: 버퍼 갱신 + 파생 dirty 를 모든 탭에 전파
}
export fn setApplyExternalEdit(fn) {
  role: 외부 변경을 monaco 모델에 편집으로 반영하는 훅 등록 — model 이 UI 를 모르기 위한 seam
}
export fn reloadDocFromDisk(path, r: FileContent) {
  role: 외부 변경 반영 — 깨끗한 문서만 조용히 재로드, 내용 같아도 etag 는 갱신 (스퓨리어스 충돌 방지). unopenable 전이(텍스트↔이진·크기 초과)도 여기서 반영 — 사유를 최신화하고 내용은 '' 로 수렴. 이미지 경로는 base64 재갱신만 한다 (호출측 watch 가 encoding=base64 로 읽어 온다는 전제)
  depends: { updateContent }
}
export fn saveActive() {
  role: 활성 문서 저장 — 실체는 saveDoc(경로 단위, 닫기 확인 Save 와 공유): etag 낙관적 검사, conflict 면 saveConflict 슬롯에 걸고 토스트에 위임. 그 외 실패는 notify
}
export fn overwriteConflict() {
  role: 충돌 토스트 Overwrite — etag 없이 재기록해 디스크를 내 버퍼로 덮는다. 실패 시 토스트 유지
}
export fn revertConflict() {
  role: 충돌 토스트 Revert — 버퍼를 버리고 디스크 내용으로 강제 재로드 (dirty 무관). 실패 시 토스트 유지. 읽기 성공은 orphan 해제 겸
}
export fn remapPaths(from, to) {
  role: 파일/디렉토리 rename 반영 — docs 키·탭 id/path/name 을 새 경로로 이관 (내용·dirty·etag 유지). monaco 모델은 훅으로 버리고 doc 스냅샷에서 재생성
}
export fn setDisposeModels(fn) {
  role: rename/delete 시 monaco 모델을 버리는 훅 등록 — setApplyExternalEdit 와 같은 seam
}
export fn setOrphaned(path, on) {
  role: 외부 삭제 표시 토글 — watch 의 실존 재검증이 세우고, 재생성·저장 성공이 내린다
}
export fn closePathTabs(path) {
  role: 앱 내 삭제 반영 — 해당 경로(디렉토리면 하위 포함)의 탭을 모든 그룹에서 닫고 문서를 버린다 (외부 삭제와 달리 탭을 닫는 것이 VS Code 동일)
}
export fn imageMime(path) -> mime? {
  role: 이미지 뷰어로 여는 확장자 판별 (확장자 → MIME, 아니면 null) — VS Code 내장 Media Preview 세트(png·jpg·jpeg·gif·webp·bmp·ico·avif). svg 는 VS Code 기본대로 텍스트. 순수 함수, 세션 무관
}
export fn isHtml(path) -> Bool {
  role: HTML 프리뷰 대상 확장자(.html·.htm) 판별 — 순수 함수, 세션 무관
}
export val viewerAutoReload
export fn toggleViewerAutoReload(kind) {
  role: 뷰어 자동 갱신 스위치 토글 — 뷰어 종류(html·pdf)별, 세션 무관 전역이라 localStorage 에 기억. 기본 HTML on / PDF off (PDF 는 재렌더 비용 — viewer-cache-refresh). 설정 체계(config-system)가 생기면 그쪽으로
}
export val editorView
export fn toggleWordWrap() {
  role: 자동 줄바꿈 토글 — 전 에디터 공통 뷰 상태(editorView.wordWrap), 세션 안에서만 (VS Code Alt+Z 동일, 영속화 없음). MonacoHost 가 지켜보다 updateOptions
}
export val EDITOR_ZOOM_MIN
export val EDITOR_ZOOM_MAX
export val EDITOR_ZOOM_STEP
export fn setEditorZoom(percent) {
  role: 편집기 전용 줌(editorView.zoom, 퍼센트) — 웹뷰 줌(Ctrl+=, 앱 전체)과 별개로 Monaco 글꼴 크기만 바꾼다 (사이드바·탭·터미널은 그대로). 50~200 을 10 단위로 스냅·클램프. 세션 무관 전역이라 localStorage 에 기억하고, 다른 창의 변경은 storage 이벤트로 따라온다 (앱 다중 창 = 같은 origin). MonacoHost 가 지켜보다 fontSize 를 updateOptions (ticket convenience-features, 2026-09-07)
}
export fn stepEditorZoom(dir) {
  role: 한 단계(EDITOR_ZOOM_STEP) 확대·축소 — 팔레트 'View: Editor Font Zoom In/Out' 용
}
export val previewReloadTick
export fn reloadPreview(path) {
  role: 프리뷰 수동 갱신 신호 — path 별 tick 증가. 자동 갱신 off 인 프리뷰의 유일한 갱신 통로 (HtmlPreview 가 iframe 을 다시 만든다)
}
export fn tabIdOf(kind, path) -> id {
  role: 탭 id 규칙 — file 은 path 그대로, 그 외는 kind 접두 ('diff:'·'hex:'·'preview:'·'folder:'). 순수 함수
}
export fn tabNameOf(kind, path) -> label {
  role: 탭 라벨 규칙 — hex "x (Hex)", preview "Preview x", folder 는 폴더명(루트 '' 는 '/'), 그 외 파일명 (diff 의 상태 접미는 호출측). 순수 함수
}
export fn base64Bytes(b64) -> bytes {
  role: base64 길이 → 원본 바이트 수 (패딩 보정) — statusbar 의 이미지 크기 표시용, 와이어가 크기를 따로 나르지 않는다. 순수 함수, 세션 무관
}
export fn languageOf(path) -> languageId {
  role: 확장자 → monaco 언어 id — 순수 함수, 세션 무관
}
export fn languageLabel(path) -> label {
  role: statusbar 표시용 언어 이름 — 순수 함수, 세션 무관
}
export fn indentOf(path) -> spaces {
  role: 들여쓰기 감지 — 최소 양수 선행 공백 (VS Code detectIndentation 근사). 앞 1만 줄 상한 — sync 마다 불리므로 초대형 파일 전체 스캔을 막는다
}

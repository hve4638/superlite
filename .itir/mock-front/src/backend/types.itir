role: ThinBackend 계약 — 와이어 프로토콜(백엔드 /ws JSON-RPC)의 TS 사영. 와이어 쪽 대응은 daemon/src 참조

port ThinBackend {
  role: 워크스페이스 파일·검색·git·터미널 접근 계약. 구현체 선택은 model/host 조립 지점 한 곳
  impls: { MockBackend, WsBackend }
  fn workspace() -> WorkspaceInfo {
    role: 워크스페이스 이름·루트 경로
  }
  fn readDir(path) -> DirEntry[] {
    role: 디렉토리 1층 나열 (트리 lazy 로드 단위). files.exclude 기본값(.git 등 VCS 메타)은 숨긴다 — node_modules 는 보인다
  }
  fn readFile(path, maxBytes?) -> FileContent {
    role: 파일 내용 + 그 시점 디스크 etag. maxBytes 상한 초과는 읽지 않고 에러 (undo 캡처용)
  }
  fn writeFile(path, content, etag?) -> WriteResult {
    role: 저장. etag 제시 시 낙관적 충돌 검사 — stale 이면 미기록으로 conflict 반환, 생략 시 무조건 쓰기
  }
  fn listFiles() -> Path[] {
    role: Quick Open 용 전체 파일 나열 — dotfile 포함, .gitignore·files/search.exclude 제외
  }
  fn search(query, opts) -> FileSearchResult[] {
    role: 내용 전문 검색 (디스크 기준, dirty 버퍼 미반영) — 제외 규칙은 listFiles 와 동일
  }
  fn createFile(path) {
    role: 빈 파일 배타적 생성 — 중간 디렉토리 자동 생성, 이미 존재하면 에러 (기존 내용 보호)
  }
  fn createDir(path) {
    role: 디렉토리 배타적 생성 — 중간 디렉토리 자동, 이미 존재하면 에러 (undo 의 "내가 만든 것" 전제 보호)
  }
  fn rename(from, to) {
    role: 이름 변경/이동 — 대상이 이미 존재하면 에러
  }
  fn delete(path) {
    role: 파일·디렉토리 삭제 (디렉토리는 재귀, 휴지통 없음 — 안전장치는 프론트 confirm, undo 는 파일 한정)
  }
  fn gitStatus() -> GitStatus {
    role: 브랜치 + HEAD 커밋 해시 + 워킹트리 변경 목록. head 는 diff original 캐시 무효화 키 — 앱 밖 커밋(터미널 git)도 잡는다
  }
  fn gitOriginalContent(path) -> content {
    role: diff 의 original 쪽 — HEAD 시점 내용
  }
  fn gitCommit(message) {
    role: 스테이징 전체 커밋
  }
  fn createTerminal(cols, rows) -> TerminalSession {
    role: PTY 세션 생성 (동기 핸들, 데이터·셸 종료는 콜백 — onExit 는 셸 자연 종료에만 발화, dispose 로 인한 정리에는 발화하지 않는다)
  }
  fn onFsChanges(cb) {
    role: 외부 파일 변경 배치 구독 (옵셔널 — mock 은 외부 변경이 없다)
  }
  fn onConnection(cb) {
    role: 연결 상태 변화 구독 (옵셔널 — mock 은 끊길 일이 없다). 재연결 시 true — 구독자가 전체 리프레시로 재동기화한다
  }
  fn onSessionLost(cb) {
    role: 재연결됐지만 데몬 세션이 회수된 경우(장기 끊김) 구독 (옵셔널) — 기존 터미널은 전부 죽어 있어 구독자가 정리한다
  }
}

export type WorkspaceInfo
export type DirEntry
export type SearchMatch
export type FileSearchResult
export type GitChangeKind
export type GitChange
export type GitStatus
export type FsChange
export type FileContent
export type WriteResult
export type TerminalSession

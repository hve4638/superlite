{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "../target/x86_64-pc-windows-gnu/release/superlite-daemon.exe": "daemon/windows-x86_64.exe",
      "../target/x86_64-unknown-linux-musl/release/superlite-daemon": "daemon/linux-x86_64",
      "../target/tmux/tmux-linux-x86_64": "daemon/tmux-linux-x86_64",
      "../target/x86_64-pc-windows-gnu/release/superlite.exe": "daemon/cli/superlite.exe",
      "../target/x86_64-pc-windows-gnu/release/sl.exe": "daemon/cli/sl.exe",
      "../target/x86_64-unknown-linux-musl/release/superlite": "daemon/cli-linux-x86_64"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "installerHooks": "installer-hooks.nsh",
        "languages": ["Korean", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}

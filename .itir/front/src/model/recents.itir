import { notify } from './notifications'
import { openFolder } from './host'
import { isRemoteEmpty, remoteHost, sessions, sessionsKind } from './sessions'

import { tauri } from './tauri'
role: 시작 페이지의 목록 (ticket start-page-recents → start-page-redesign) — 최근 연 폴더 MRU(개별 root, 최대 64 — 2026-09-07 10 에서 확장)와 사용자가 고정한 그룹(Pinned — 그룹 목록, root 하나여도 그룹. 2026-09-07 종전 세션 묶음 이력을 대체). 자동 복원은 없고(app-empty-session) 사용자가 여기서 골라 명시적으로 다시 연다. 고정된 root 는 MRU 에 들어오지 않고(pin 하면 빠지고 다시 열어도 안 들어옴) × 는 목록에서만 지운다. pin·unpin·순서·그룹 간 이동·별칭은 front 가 결과 목록을 계산해 통째로 저장한다(setPinned — 앱 native set_pinned / 웹 localStorage). 저장소는 환경별 (decision/state-persistence.md version 2): 앱은 native 가 state.json 을 소유·갱신하고 여기는 list_recents 사영과 forget_recent·set_pinned·open_group·open_groups invoke 만, 웹은 앱 데이터 디렉터리가 없어 front 가 같은 스키마를 localStorage('superlite.state')에 두고 세션 목록 변화를 effect 로 추적해 기록한다 (웹은 검증 경로 — 이 환경에서 목록 동작을 볼 수 있어야 한다), mock 은 없음

export type RecentEntry
export type PinGroup
export type PinSource
export val recents

export fn recentName(root) -> String {
  role: 표시 이름 — root 의 마지막 요소 (host 없이). 원격 표기는 시작 페이지가 "이름 from host" 로 잇는다 (탭 라벨의 "이름 [host]" 와 다른 시작 페이지 한정 표기)
}
export fn groupTitle(g) -> String {
  role: 그룹 제목 — 별칭, 없으면 첫 멤버 이름 + "+N"(나머지 수)
}
export fn refreshRecents() {
  role: 목록 새로 읽기 — 시작 페이지가 뜰 때와 세션 목록이 바뀔 때. 앱은 invoke list_recents(소실 여부 포함), 웹은 localStorage(소실 검사 없음)
}
export fn forgetRecent(root) {
  role: 최근 폴더에서 지우기(×) — 앱 forget_recent invoke / 웹 localStorage 갱신, 뒤에 refresh
}
export fn pinAsGroup(roots, index, from?) {
  role: 새 그룹으로 고정 — Recent 의 pin 아이콘(목록 끝), 그룹 사이·목록 끝 드롭. from(Pinned 안 출처)이 그룹이면 그 그룹(별칭 포함)을 그대로 옮긴다(순서 변경), 멤버면 원래 그룹에서 뺀다
}
export fn pinIntoGroup(roots, group, from?) {
  role: 기존 그룹에 멤버 추가 — 그룹 카드 위 드롭은 끝에, 멤버 줄 위·아래 드롭은 그 자리(at)에. 같은 그룹 안 이동은 순서 변경. from 이 그룹이면 그 멤버들이 합쳐진다. 같은 그룹을 자기 위에 놓는 것은 무동작
}
export fn unpinGroup(group) {
  role: 그룹 통째로 지우기(제목 줄 ×) — Recent 로 되돌리지 않는다
}
export fn unpinMember(group, root) {
  role: 멤버 하나 지우기(멤버 줄 ×) — 마지막 멤버면 그룹도 사라진다(normalize)
}
export fn setGroupAlias(group, alias) {
  role: 별칭 지정 — 빈 문자열은 없음
}
export fn openGroup(roots) {
  role: 그룹 열기(제목 클릭) — 앱은 native open_group(이 창이 전부 빈 탭이면 이 창에, 아니면 새 창에 — 사용자 결정; 거절은 notify). 웹은 창이 하나뿐이라 이 페이지에 탭으로 더한다 (첫 root 는 활성 빈 탭 제자리 교체, 나머지 mode 'new')
}
export fn openGroups(groups) {
  role: 일괄 열기(시작 페이지 "Open Selected", ticket window-virtual-desktop) — 번호 순서의 그룹들 [{roots, desktop}] 을 native open_groups 로 한꺼번에 연다 (그룹마다 open_group 의 창 배분 규칙, desktop 은 Windows 가상 데스크톱 순번 — null 이면 옮기지 않음; 거절은 notify). 앱 전용 — 웹은 선택 자체가 불가능해 호출되지 않는다
}
export fn initRecents() {
  role: 부팅 시 1회(main.ts) — 웹만 세션 목록 추적(trackWeb: 새로 나타난 workspace root 는 MRU 앞으로, 고정된 root 는 제외). 앱은 native 가 기록하므로 무동작
}

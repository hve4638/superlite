import { ThinBackend } from '../backend/types'

role: 문제 데몬 강제 정리 확인 상태 — 원격 접속이 데몬 기동 단계에서 실패하면 대화상자를 띄울 pending(실패 세션의 백엔드)을 든다. 자동 정리 없음 — 강제 종료는 명시적 승인 하에서만 (사용자 결정 2026-09-04). 실행(POST /daemon/clean·재접속)은 host.confirmDaemonClean — watch → daemon → host 순환 import 를 피해 여기는 상태만

// pending: 확인 대기 중인 백엔드 (null = 대화상자 없음), busy: 정리 요청 진행 중
export val daemonClean

export fn promptDaemonClean(backend) {
  role: 확인 대화상자 열기 — 이미 떠 있으면 무시 (모달 하나)
}
export fn cancelDaemonClean() {
  role: 취소 — 아무것도 하지 않는다
}

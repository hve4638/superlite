import { EditorGroup, LayoutNode } from './editors'
import { notify } from './notifications'
import { SessionCtx } from './session'

import { tauri } from './tauri'
role: 워크스페이스별 상태 기억 (ticket workspace-state-restore) — 같은 root 를 다시 열면 그 아래에서 열었던 탭(kind 전부)·활성 탭·그룹 배치·탐색기 펼침·파일별 커서·스크롤·터미널 자리를 복원한다. "어느 폴더를 열지" 는 여전히 사용자가 고른다 (app-empty-session 결정 유지) — 고른 폴더 안의 상태만 기억한다. 저장 형식 WorkspaceState(version 1)는 editors.snapshot 의 구조 부분(groups·layout·activeGroupId·nextGroupId, docs 제외 — dirty 버퍼는 싣지 않는다) + expanded + views(path → monaco 뷰 상태) + terminals(tmux 세션 id·그룹·index — 터미널 탭은 groups 에서 빼고 따로, 인스턴스 id 는 창마다 다르므로). 저장소 (decision/state-persistence.md): 앱은 native state.json 의 workspaces (native 소유 — 여기는 get/set_workspace_state invoke 만, root 는 native 가 세션 id 로 안다, 같은 root 의 두 번째 세션(탭 분리)은 native 가 거절), 웹은 localStorage 'superlite.state'.workspaces[root] (recents.ts 가 같은 키를 쓰되 이 필드는 통과만 시킨다), mock 은 없음. 저장 시점: 구조 변경 1초 디바운스 + 세션 닫기·창 닫기 flush. 커서·스크롤은 트리거가 아니고 저장할 때 함께 실린다. 보조창(서브 창)도 보존한다 (2026-09-08 사용자 결정): 서브 창은 미러 세션의 같은 형식 스냅샷을 set_workspace_sub_state 로 보내 native 가 위치·크기를 붙여 그 root 의 subs 로 모으고, 메인이 복원할 때 서브 창을 다시 만든다. 세션 닫기(회수)는 서브 상태를 남기고 서브 창 X·마지막 탭 이탈은 잊는다

export type WorkspaceState
export type SubWorkspaceState
export type StoreKind

export fn restoreWorkspace(kind, id, root, ctx) {
  role: 세션 초기 로드 뒤 한 번(sessions.addLocal) — 저장된 상태를 읽어 editors.restore 로 껍데기 탭·배치를 먼저 세우고(즉시 보임), 이어서 펼침(files.expandPaths)·터미널(refreshTerminals 뒤 살아 있는 tmux 세션만 저장된 그룹·index 에 attachTerminal, 없으면 건너뜀)·문서(editors.hydrate — 활성 탭부터 순차 읽기, 탭마다 loadingTabs 진행선, 사라진 파일 탭은 걷어내고 알림 한 줄)를 채운다. 저장된 것이 없거나 창 이동 핸드오프가 먼저 도착해 이미 탭이 있으면 무동작. 보조창(subs — native 가 넘기며 비운다)은 저장된 자리·크기에 detach_tabs(size) 로 서브 창을 만들고 'restore' 핸드오프(sessions.applyHandoff)로 채운다
}
export fn restoreSubWorkspace(kind, mirror, ctx) {
  role: 서브 창 자신의 몫 복원(서브 창 새로고침) — get_workspace_sub_state 로 같은 label 의 저장이 있으면 applyWorkspaceState. 새로 만든 서브 창은 없음이라 무동작이고 핸드오프가 채운다
}
export fn applyWorkspaceState(ctx, s) {
  role: 스냅샷 하나를 세션에 적용 — editors.restore 로 껍데기 탭·배치를 먼저 세우고 펼침·터미널(살아 있는 tmux 만 저장된 자리에 attach, 죽은 터미널의 빈 pane 은 closeEmptyGroup)·문서(hydrate)를 채운다. 메인(restoreWorkspace)과 서브 창('restore' 핸드오프)이 공유한다
}
export fn trackWorkspace(kind, id, root, ctx, sub?) {
  role: 복원이 끝난 세션의 변경을 따라가며 저장 — effect 가 직렬화 중 읽은 반응형 값(그룹·탭·배치·펼침·터미널 목록 — snapshot 이 docs 도 복사하므로 문서 content 변경에도 재실행되지만 구조 JSON 비교로 걸러진다)을 추적하고, 구조 JSON 이 마지막 저장과 다르면 1초 디바운스 뒤 persist. 첫 실행은 저장하지 않는다(복원 직후). viewStates 는 markRaw 라 추적되지 않는다. sub(미러 세션 id)가 있으면 서브 창 몫으로 set_workspace_sub_state 에 보내고 첫 실행부터 저장하며(추적 시작 시점에 넘어온 탭이 이미 있고 저장된 적이 없다), 탭이 하나도 없으면 null(잊기)
}
export fn forgetWorkspace(id) {
  role: 서브 창을 잊는다 — 추적을 멈추고 저장을 null 로 지운다 (서브 창 X·마지막 탭이 메인으로 돌아감). 세션 닫기의 회수는 untrackWorkspace(저장 유지)
}
export fn flushWorkspace(id) {
  role: 세션 닫기 — 즉시 저장하고 추적을 멈춘다. 앱은 native close_session 이 레지스트리에서 빼기 전에 도달해야 하므로 호출측(sessions.closeSession)이 await 한다
}
export fn untrackWorkspace(id) {
  role: 추적만 멈춘다(저장 없음) — 세션이 다른 창으로 옮겨 가거나 native 가 닫아 reconcile 이 제거한 경우 (sessions.removeLocal)
}
export fn flushAllWorkspaces() {
  role: 이 창의 모든 추적 세션을 저장 — 창 닫기(window.closeWindow)·beforeunload(main.ts). 추적은 유지한다
}

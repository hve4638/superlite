import { backend } from './host'
import { FileSearchResult } from '../backend/types'

role: 전문 검색 뷰 상태 — 파일 변경 시 자동 재실행 (250ms 디바운스는 watch 소비자 몫, 뷰 표시 여부와 무관)

export val search

export fn setQuery(q) {
  role: 질의 갱신 (디바운스 실행은 뷰 쪽)
}
export fn runSearch() {
  role: 검색 실행 — 결과와 접힘 상태 초기화
}
export fn autoRerunSearch() {
  role: 파일 변경에 의한 자동 재실행 — 결과가 떠 있을 때만, 접힘 상태 보존 (VS Code 동작)
}
export fn matchCount() -> Int {
  role: 총 매치 수 (요약 라벨)
}
export fn toggleCase() {
  role: 대소문자 구분 토글 + 재실행
}
export fn toggleFileCollapsed(path) {
  role: 파일 그룹 접힘 토글
}
export fn clearSearch() {
  role: 타이틀 액션 Clear — 질의·결과·접힘을 초기 상태로 (진행 중 검색 무효화 포함)
}
export fn collapseAllResults() {
  role: 타이틀 액션 Collapse All — 결과의 모든 파일 그룹을 접는다
}

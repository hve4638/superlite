import { ThinBackend } from '../backend/types'
import { MockBackend } from '../backend/mock'
import { WsBackend } from '../backend/ws'
import { activeCtx, ctx, viewOf } from './ctx'
import { createSessionCtx } from './session'

role: ThinBackend 조립 지점 — 구현체를 직접 참조해도 되는 유일한 파일 (itir boundary assembly). Tauri 앱이 주입한 __SUPERLIGHT_WS__ 가 최우선 endpoint 이고 (자산 로드라 location 이 relay 가 아니다), 이때 __SUPERLIGHT_SESSION__ (native 세션 레지스트리가 발급한 session id)도 함께 넘긴다. 그 외엔 페이지 URL 의 ?tkn= 을 /ws 연결 토큰으로, ?folder= 를 root 지정(Fixed relay 전용)으로 전달하며 tkn 존재 자체가 실 백엔드 선택 신호다. 모듈 평가 시점에 부팅 세션 컨텍스트를 만들어 activeCtx 를 세운다 — model shim 을 쓰는 모든 모듈보다 앞서야 하므로 main.ts 가 이 파일을 최우선 import 한다

export val backend

export fn openFolder(root) {
  role: '폴더 열기' 확정의 단일 진입점 — Tauri 는 native 커맨드 open_folder_path invoke — 새 세션 탭 추가 (검증·세션 등록은 native 소유), 웹은 같은 페이지 URL 에서 ?folder= 만 바꾼 주소로 이동 (새 페이지 로드 = 새 세션 — 탭이 곧 대등한 창). mock 은 무동작. 환경 분기가 여기 숨어 퀵인풋은 환경을 모른다
}

import { ctx, viewOf } from './ctx'
import { subWindow } from './window'
import { ThinBackend } from '../backend/types'

role: 셸 상태 — 사이드바/뷰릿(explorer·search·scm·remote·terminals) 토글, Quick Input, 컨텍스트 메뉴(항목 checked 는 체크 표시 — false 는 같은 폭의 빈 자리로 정렬, undefined 는 자리 없음; 항목 key = 열린 동안 한 글자 니모닉). 하단 패널은 없다 — 터미널은 편집기 탭 (terminal-usability 2026-09-07). 세션별 팩토리(createWorkbench) + 활성 세션 전달 shim — 탭이 각자의 사이드바 배치를 기억한다 (VS Code 창 단위와 동일 감각). 서브 창(window.subWindow — 에디터·터미널 탭 분리 창)은 사이드바·액티비티바를 기본 숨긴다 — 표시 여부는 창 단위 상태 subShell 이 갖고 세션의 sideBarVisible(스냅샷·핸드오프에 실림)은 건드리지 않아, 서브 창에서 Ctrl+B·뷰릿 명령으로 잠시 펼친 것이 메인 창의 세션에 번지지 않는다 (window-secondary-no-sidebar). 사이드바는 기본 플로팅 — 편집기 영역 위에 떠서 편집기 폭을 줄이지 않고, 고정(pin, sideBarPinned — 세션 상태·스냅샷, 서브 창은 subShell.sideBarPinned)하면 자리를 나눠 쓴다. 플로팅일 때 편집기 영역 mousedown 이 hideFloatingSideBar 로 접는다 — 포커스 이동만으로는 안 접힘. 폭(sideBarWidth)은 두 상태가 공유 (ticket floating-sidebar 2026-09-14)

export type ViewletId
export type QuickInputMode
export type ContextMenuItem
export type WorkbenchSnapshot
export val workbench
export val subShell
// 서브 창: subShell.sideBarVisible 이 참이 되거나 그 상태에서 활성 세션이 바뀌면 그 세션의 loadWorkspace — lazy 세션의 트리·SCM 을 그때 읽는다 (ticket window-detach-reload)

export fn createWorkbench(backend) {
  role: 세션별 셸 상태 모듈 생성. snapshot/restore — 창 이동 핸드오프의 레이아웃 몫(사이드바 크기·표시·뷰릿, 오버레이 제외)
}
export fn sideBarShown() {
  role: 이 창에서 사이드바를 그리는가 — 메인 창은 활성 세션의 sideBarVisible, 서브 창은 subShell (액티비티바는 activityBarShown 이 따로 판정)
}
export fn sideBarPinned() {
  role: 사이드바 고정 여부 — 메인 창은 활성 세션의 sideBarPinned, 서브 창은 subShell. 거짓이면 플로팅
}
export fn toggleSideBarPinned() {
  role: 고정/해제 토글 — 사이드바 제목 줄 핀 아이콘. 서브 창은 subShell 만 바꾼다
}
export fn hideFloatingSideBar() {
  role: 플로팅 사이드바 접기 (편집기 영역 mousedown) — 고정 상태면 무동작
}
export fn activityBarShown() {
  role: 액티비티바 — 메인 창은 늘, 서브 창은 사이드바와 함께
}
export fn toggleSideBar() {
  role: 사이드바 접기/펴기 — 서브 창은 subShell 만 바꾼다
}
export fn showViewlet(id, toggle) {
  role: 뷰릿 전환 — 같은 것 재클릭은 토글. 서브 창은 뷰릿 선택만 세션에 두고 펼침은 subShell
}
export fn openQuickInput(mode) {
  role: Ctrl+P(files) / Ctrl+Shift+P(commands) / Ctrl+O(folder — 웹 '폴더 열기' 경로 입력) 열기
}
export fn closeQuickInput() {
  role: Quick Input 닫기
}
export fn openContextMenu(x, y, items) {
  role: 좌표에 컨텍스트 메뉴 열기
}
export fn closeContextMenu() {
  role: 컨텍스트 메뉴 닫기
}

import { editors, editorView, imageMime, ensureHex, loadHexChunk, HEX_CHUNK, openHex, toggleHtmlPreview, isHtml, viewerAutoReload, previewReloadTick, reloadPreview, languageOf, setApplyExternalEdit, setDisposeModels, updateContent, moveTabToGroup, moveTabSplit, openFileSplit, pinTab } from '../../model/editors'
import { createTerminal, setTerminalSerializer } from '../../model/terminal'
import { isShellSkippingChord } from '../../model/commands'
import { TERMINAL_FONT_FAMILY, TERMINAL_FONT_SIZE, TERMINAL_LINE_HEIGHT } from '../../theme/fonts'
import { openQuickInput } from '../../model/workbench'
import { FileIcon } from '../widgets/FileIcon'
import { backend } from '../../model/host'
import { scm } from '../../model/scm'
import { setBeforeSessionSwitch, activeSessionEmpty, multiWindow, sessionRoot, sessions, detachEditorTab, requestTabsMove, DND_EDITOR, allTerminals } from '../../model/sessions'
import { windowLabel } from '../../model/window'
import { notify } from '../../model/notifications'
import { pointerOutside } from '../dndUtil'
import { StartPage } from '../StartPage'
import { EDITOR_FONT_SIZE, MONO_FONT_FAMILY } from '../../theme/fonts'

role: 에디터 영역 — monaco 수명주기(monaco.ts)와 그룹/탭바/diff 렌더링(.vue — 삭제 파일 탭(DiffTab.deleted)은 diff 대신 코드 편집기에 HEAD 모델을 읽기 전용으로), 탭 드래그 이동/분리(진행 상태는 tabDnd.ts 모듈 상태로 공유). 창 간(앱): 탭을 창 밖에 놓으면 새 창(detachEditorTab), 다른 창의 탭바에 놓으면 그 창이 출처에 이동을 요청(requestTabsMove) — 같은 root 세션에만, dataTransfer 의 DND_EDITOR 타입으로 식별. monaco 모델은 path 당 하나, 그룹 간 공유. 자동 줄바꿈(editorView.wordWrap, Alt+Z)은 MonacoHost 가 지켜보다 코드·diff 편집기에 updateOptions 로 반영. 열 수 없는 문서(doc.unopenable)는 모델을 만들지 않고 편집기 자리에 사유 안내를 띄운다 (VS Code binary/large 안내 근사). 편집기 자리를 차지하는 것(hex·preview 탭, 이미지, 열 수 없음 안내, 문서 미도착 파일 탭의 빈 본문 — openFile 이 탭을 읽기 전에 띄운다, MonacoHost 는 그동안 모델을 만들지 않고 docs 도착 워처로 sync)은 EditorGroupView 의 overlay computed 하나가 우선순위대로 정하고 monaco 는 v-show="!overlay" 로 가린다 — 종류가 늘면 그 분기 하나와 템플릿 분기 하나. 활성 탭이 editors.slowTabs(로드 800ms 초과)에 있으면 본문 상단(탭바·breadcrumbs 아래 2px)에 진행선(widgets ProgressBar). 터미널 탭(TerminalTab)은 TerminalView.vue — xterm 바인딩(terminalHost.ts: 인스턴스 id 키 모듈 맵, allTerminals 합집합으로 수명 판정, 세션 전환·탭 전환의 언마운트에도 살아 재부착, 버퍼 직렬화 seam 등록, 넘어온 restoreBuffer 는 xterm 을 열 때 먼저 그림)을 그룹 본문에 붙이고 fit·포커스(활성 그룹일 때만)한다. 키: skipShell 표식 chord(isShellSkippingChord)만 워크벤치로 양보하고 나머지는 xterm 이 셸로 보낸다 — Ctrl+V·Ctrl+Shift+V 는 xterm 처리를 건너뛰되 전파를 끊어 브라우저 네이티브 paste 가 워크벤치 chord(html.togglePreview)에 밀리지 않게 한다. 탭바 그룹 액션의 마지막 아이콘은 새 터미널(그 그룹에 createTerminal) — Split Editor 아이콘을 대체 (Ctrl+\ 는 유지). 외형은 Windows Terminal 을 닮는다 (사용자 방향 2026-09-07): Campbell 배색(배경 #0C0C0C, terminalHost 상수)·bar 커서·8px 패딩, 글꼴은 theme/fonts 의 TERMINAL_FONT_FAMILY(Cascadia Mono 우선) 16px·줄 높이 1.2. 드래그 선택도 WT 규칙: 마우스 모드가 아닐 때 Shift+클릭 확장 선택은 없다(capture 에서 Shift 를 뗀 mousedown 으로 교체), 마우스 모드(tmux·vim)에서는 그냥 드래그가 앱으로 가고 Shift+드래그만 xterm 강제 선택으로 터미널이 새 선택을 잡는다. 그 선택은 유지된다 — 1003 모드의 버튼 없는 이동 보고를 선택이 있는 동안 capture 에서 끊어 xterm 의 onUserInput 선택 해제를 막는다 (클릭·Ctrl+C 가 해제). MonacoHost 의 포커스 요청 소비는 다음 tick 에 focus() 한다 — post 워처 시점엔 부모의 v-show 반영 전이라 overlay(터미널·hex·프리뷰) 탭에서 파일 탭으로 옮길 때 호스트가 display:none 이어서 즉시 focus 가 무시된다. 이미지 문서(doc.image)도 모델 없이 편집기 자리에 이미지 뷰어(ImageView.vue — 체커보드, 영역 전체 휠 줌(커서 지점 고정)·드래그 팬·더블클릭 fit 복귀)를 띄운다. 해상도·크기·배율 표시는 statusbar 몫 — ImageView 가 editors.imageView 를 세운다. 이진 안내에는 "Open in Hex Editor" 링크(openHex). hex 탭(HexView.vue — HxD 식 offset/hex/ASCII 3열, 16바이트 행, 보이는 행만 렌더하는 가상 스크롤, 뷰어 전용·편집 없음)은 editors.hex(HexDoc)의 청크를 그린다 — 크기는 ensureHex, 보이는 행이 걸친 청크(±1 선읽기)는 loadHexChunk 로 요청하고 미도착 바이트는 빈 칸. 총 높이가 브라우저 요소 높이 한계를 넘는 GB 파일은 스크롤 트랙을 축척해 scrollTop 을 행 인덱스로 사상한다 (렌더 행은 scrollTop 을 따라가는 컨테이너에 상대 배치). preview 탭(HtmlPreview.vue)은 같은 path 의 doc.savedContent(저장된 내용 = 디스크 기준, 편집 버퍼 아님)를 sandbox iframe srcdoc 에 반영 — 저장·외부 변경 재로드 때 다시 그린다. 상대 경로 리소스는 해석되지 않는다(서버 없음). 자동 갱신(viewerAutoReload.html)이 off 면 저장·외부 변경을 따라가지 않고 마지막 렌더를 유지하며, 탭바 "Reload Preview"(reloadPreview → previewReloadTick)가 내용이 같아도 iframe 을 다시 만든다(key 증가). on 으로 켜면 즉시 동기화. iframe 안 클릭은 부모에 mousedown 이 오지 않으므로 window blur 시 활성 요소가 iframe 이면 focus 를 emit 해 그룹을 활성화한다(상태바가 따라온다). 탭바 그룹 액션에 활성 탭이 .html 편집기면 "Open Preview"(toggleHtmlPreview — 같은 탭을 제자리에서 프리뷰로), 프리뷰 탭이면 "Reload Preview"·"Show Source"(다시 편집기로) 아이콘. 부팅 유휴 시간에 더미 에디터를 한 번 만들어 폰트 측정 캐시를 데운다 — 첫 파일 콜드 오픈의 고정 비용(에디터 생성)을 부팅으로 옮기는 프리웜. 실측값은 localStorage 에 영속화(VS Code editorFontInfo 동일 수법)해 재실행부터는 부팅 실측도 건너뛴다 — 복원값은 monaco 가 5초 뒤 백그라운드 재실측(untrusted 취급)

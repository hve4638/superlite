role: 수명과 연결 — 파일 락 단독 보장, accept 루프, 유휴 grace 자진 종료, 연결당 read 루프, 세션 지속(재접속 시 터미널 이어 붙임). 데몬→프론트 요청(와이어 v9)은 front 모듈 — frontRequest(attach 없이 허용, params.session 으로 대상 세션 지목)·requestReply 디스패치만 여기

fn main() {
  role: IPC 확보(락 승자만 — unix 는 unlink 후 socket bind, Windows 는 named pipe 인스턴스 루프) + 유휴 감시 태스크(연결 0 이고 detach 세션도 없어야 종료) + 세션 reaper + accept 루프. --pipe 인자면 데몬 본체 대신 pipe_main 헬퍼 모드
}
fn pipe_main() {
  role: ssh 헬퍼 모드 — 백엔드가 `ssh host superlight-daemon --pipe` 로 원격(=이 머신)에 띄운다. 이 머신의 데몬 소켓에 접속(부재 시 자기 자신을 데몬으로 spawn)해 stdin/stdout 과 양방향 중계만 — 내용 해석 없음 (로컬 relay 의 daemon_conn+spawn 대응물, "헬퍼가 곧 원격의 데몬" 대칭의 접점). ssh 사망 = stdin EOF → 종료 → 데몬이 세션을 detach 로 돌리고 세션 grace 안의 재접속이 터미널을 이어받는다. 어느 방향이든 끝나면 stdout flush 후 process::exit — 런타임 반환으로 내리면 stdin 블로킹 읽기가 끝나길 기다려 데몬이 먼저 끊은 경우(attach 실패) relay 와 교착한다
}
fn spawn_self_daemon() {
  role: 헬퍼가 데몬 본체를 spawn (자기 자신, 인자 없이) — relay 의 spawn_daemon 과 같은 정책. stdout 은 null (상속되면 ssh 채널=와이어를 오염), stderr 는 daemon_log_file (ssh 세션보다 오래 사는 데몬이 끊긴 ssh 파이프에 eprintln 하면 EPIPE panic — 유휴 종료 경로가 소켓만 지운 채 락을 쥐고 남아 그 호스트의 모든 접속이 '데몬 기동 실패'가 됐다)
}
fn daemon_log_file() -> File? {
  role: 헬퍼가 띄운 데몬의 로그 파일 — $HOME/.cache/code-superlight/daemon.log (append). 실패면 None (호출측이 null 로)
}
fn acquire_lock() {
  role: 단독 데몬 보장 — connect 검사 대신 OS 파일 락(File::try_lock, 검사→unlink→bind 는 원자적이지 않다)
}
fn wire_rel() {
  role: 와이어 상대 경로 정규화 (크레이트 공용) — Windows 산출 경로의 '\' 를 '/' 로. unix 는 '\' 가 파일명 문자라 불변
}
class Session {
  role: 연결보다 오래 사는 상태 한 벌 — 터미널 맵 + 출력 sink(끊김 중 버퍼링) + root + detach 시각 + 프론트 응답 대기 요청(pending, 와이어 v9) + 자기 session id(PTY 환경변수 SUPERLIGHT_SESSION 으로 요청자에게 알린다, 익명은 None). attach 의 session id 가 키. sessions 맵 락 아래에서 terms 락을 잡지 않는다 (터미널 하나의 정체가 전역을 얼리지 않게)
}
fn reap_sessions() {
  role: detach 후 grace 를 넘긴 세션 회수 — 터미널 kill 후 맵에서 제거
}
fn handle_conn() {
  role: 연결 수명 — 라인 프레이밍 요청 디스패치(단일 writer 태스크로 응답 직렬화 — 텍스트 줄·바이너리 payload 이중 채널 select, 응답은 id 대응이라 채널 간 순서는 계약이 아니다) + attach 1회 규칙. readFile 은 반환형(ReadOut)이 달라 일반 경로와 분리 라우팅 — Payload 는 payload_frame(0x00 매직+4B BE 길이, 와이어 v6)으로 바이너리 채널에 싣는다. attach 에 session id 가 있으면 세션 재사용(터미널 생존·버퍼 flush), 없으면 연결과 함께 죽는 익명 세션. attach 의 watch:false(와이어 v7)는 탐색 전용 — 재귀 워처를 걸지 않는다 (원격 빈 세션이 홈을 탐색만 할 때). attach 응답의 resumed 가 세션 회수 여부를 프론트에 알린다. adoptTerminal(와이어 v10) — 같은 root 의 다른 세션이 소유한 터미널을 이 연결의 세션으로 옮긴다 (출처 세션 Arc 만 꺼내고 sessions 락을 놓은 뒤 term::adopt — 다른 창으로 끌어 옮긴 탭). 응답 있는 요청. 종료 뒷정리(detach 전환·익명 세션 터미널 kill·대기 중 요청자 요청 에러 회신)와 연결 카운터 감소는 drop guard — panic 에도 보장돼 유휴 종료가 막히지 않는다. frontRequest 는 attach 검사 밖 — 요청자 연결은 attach 없이 요청·응답만 주고받고 끊는다
}
fn err() {
  role: Display → String 에러 축약 (크레이트 공용)
}

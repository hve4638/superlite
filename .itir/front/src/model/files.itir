import { backend } from './host'
import { DirEntry } from '../backend/types'

role: 탐색기 파일 트리 — lazy 디렉토리 로드, 외부 변경 시 로드된 디렉토리만 병합 리프레시

export type TreeNode
export val files

export fn parentOf(path) {
  role: 부모 디렉토리 경로 (루트는 '')
}
export fn initFiles() {
  role: 루트 나열로 트리 초기화
}
export fn toggleDir(node) {
  role: 디렉토리 펼침/접힘 (첫 펼침에 자식 로드)
}
export fn refreshDir(path) {
  role: 한 디렉토리 재나열 후 기존 노드와 병합 — 펼침 상태·로드된 자식 보존
}
export fn loadedDirPaths() -> Path[] {
  role: 로드된 디렉토리 경로 나열 (전체 리프레시 대상)
}
export fn refreshAllFiles() {
  role: Quick Open 파일 목록 재조회
}
export fn refreshTree() {
  role: 수동 새로고침 (탐색기 Refresh 버튼) — 로드된 디렉토리 재나열 + Quick Open 목록 재조회. 실패는 삼킨다 (워처·다음 시도가 복구)
}
export fn collapseAll() {
  role: 모두 접기 — 펼침 집합만 비운다. 로드된 자식은 유지되어 재펼침에 왕복이 없다
}
export fn visibleNodes() -> TreeNode[] {
  role: 펼침 상태 기준 평탄화 — 렌더링용
}

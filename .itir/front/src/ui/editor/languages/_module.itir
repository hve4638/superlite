import { tmux } from './tmux'
import { sshConfig } from './sshconfig'
import { toml } from './toml'
import { nginx } from './nginx'
import { makefile } from './makefile'

role: monaco 내장이 아닌 언어의 등록 (ticket config-editors; toml·nginx·makefile 은 editor-language-coverage) — 언어 하나 = 파일 하나(id·언어 설정·monarch 토크나이저) + index 의 CUSTOM 목록 항목 하나. 판정(경로 → id)은 model/languages, 여기는 그 id 를 monaco 가 알게 만드는 쪽. 토큰 이름은 테마 공통 규칙(comment·keyword·keyword.control·string·number·variable·type.identifier·attribute.name·identifier)만 써서 언어를 더해도 테마(monaco.ts superlite-dark)를 건드리지 않는다. tmux: 줄 머리·';'·'{' 뒤의 명령(tmux(1) 명령·별칭 표) keyword, 플래그 attribute.name, 키 이름(C-b·M-x·MouseDown3Pane·Enter…) type.identifier, #{…}(중첩)·#[…]·$VAR variable, on/off/None 류 keyword.control, 따옴표 문자열·줄 이어짐 백슬래시. ssh_config: Host/Match keyword.control + 패턴(*·?·! type.identifier), 그 외 키워드(ssh_config(5) 표, 대소문자 무관) keyword, %토큰·~ variable, yes/no/ask 류 keyword.control 세 언어 모두 줄 단위 상태(인자·값·레시피)는 includeLF 로 줄 끝 토큰(\n)을 받아 닫는다 — monarch 는 줄 끝에 닿으면 규칙 평가를 멈춰 /$/ 규칙이 실행되지 않는다 (tmux·ssh_config 가 두 번째 줄부터 명령을 못 잡던 원인, editor-language-coverage 에서 수정). toml: [table]·[[array]] 머리(줄에 머리만 있을 때) type.identifier, 키('=' 또는 '.' 앞 낱말) attribute.name, 기본·리터럴·여러 줄("""·''') 문자열 string, 숫자(16·8·2진·inf·nan)·RFC 3339 날짜·시각 number, true/false keyword.control. nginx: 지시어 자리(줄 머리·';'·'{'·'}' 뒤) 낱말 keyword, 블록 지시어(events·http·server·location·upstream·if·map…) keyword.control, $변수 variable, on/off keyword.control, 숫자(단위 접미) number, 따옴표 문자열 string — 지시어는 ';'·'{' 까지 여러 줄이라 줄 끝에서 인자 상태를 닫지 않는다. makefile: 탭 줄은 레시피 — 앞의 @/-/+ keyword.control, 안은 $(…)(중첩)·${…}·$@ 류 variable 만; 그 밖의 줄은 변수 대입 이름 attribute.name, 타깃(':' 앞, ':=' 제외) type.identifier, 지시어(include·ifeq·define·export…) keyword.control, 줄 이어짐 백슬래시 keyword.control

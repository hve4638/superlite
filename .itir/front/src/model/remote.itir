import { backendApiUrl, openFolder } from './host'
import { sessions, OpenMode } from './sessions'

role: 원격 탐색기 (SSH) 모델 — 백엔드 머신의 ~/.ssh/config 호스트 목록(/ssh/hosts)에 superlite 자체 상태(즐겨찾기·고정·최근 폴더·pane 접힘)를 합친 것. FAVORITE = 사용자가 고른 host (즐겨찾기 순), 고정(fix)은 즐겨찾기에서만 — 고정 시점 config 블록의 저장본으로 접속(사라져도 남음), 저장본≠현재 config 면 drift(이탤릭), 고정 안 한 즐겨찾기가 config 에서 사라지면 missing(접속 불가). ALL = config 전체(즐겨찾기는 별 표시). 경로 아이템 = 호스트 행 하위 항목(ticket remote-path-items: 최근 폴더에 pin·그룹을 더한 것 — pin 은 상단 고정이고 pin 끼리 순서 유지, 그룹은 경로 여러 개를 한 번에 여러 탭으로 여는 묶음으로 아이템을 다른 아이템 위로 끌면 생기고 항상 펼쳐진 채 세로선으로 묶여 보인다, 별칭은 우클릭), 행 클릭은 선택이고 hover 의 →/새 탭이 접속 (호스트 행과 동일 mode 규칙). 편집(pin·이동·복사·그룹·별칭·제거)은 결과 목록을 계산해 set-items 로 통째로 보낸다(시작 페이지 Pinned 의 setPinned 와 같은 방식) — 평면(최상위·그룹)당 같은 경로 하나는 여기서 거르고 relay 가 정규화로 한 번 더. 호스트 행의 펼침은 호스트별 지속(collapsed, 기본 펼침). pane 접힘은 전역 지속 — 초기값만 백엔드가 한 번 정한다(즐겨찾기가 없으면 FAVORITE 닫힘·ALL 열림), 그 뒤는 사용자가 접고 펼친 대로 (2026-09-07 개정). 상태 파일은 백엔드가 단일 출처 — 변경(/ssh/state) 응답이 곧 갱신 목록. 호스트 접속은 경로 없는 ssh://host 로 원격 빈 세션(시작 페이지)을 연다 — 폴더는 그 세션의 '폴더 열기'가 원격을 탐색해 고른다. 세션과 무관한 앱 전역 상태

export type RemoteHost
export type PathItem
export type PathGroup
export type RemoteItem
export type HostList
export type RemoteOp
export type ItemSource
export type ItemTarget
export val remote

export fn isGroup(item) -> Bool {
  role: 경로 아이템이 그룹인가 ('paths' 유무)
}
export fn remoteEnabled() -> Bool {
  role: 원격 탐색기 표시 여부 — 백엔드 HTTP API 가 없는 환경(mock)은 감춘다
}
export fn refreshHosts() {
  role: 호스트 목록 (재)로드 — 뷰 마운트·세션 목록 변경·사이드바 타이틀 액션이 부른다, 실패 메시지는 뷰 본문에
}
export fn setHostState(op, host, extra?, body?) {
  role: 상태 변경 — fav·unfav·pin·unpin·ack(이 경고 숨김)·refresh(최신 상태로 갱신)·set-items(body = 아이템 JSON, text/plain 이라 preflight 없음)·pane(extra.open)·expand(호스트 행 펼침, extra.open). POST /ssh/state 응답으로 교체
}
export fn setPaneOpen(pane, open) {
  role: pane 접힘 토글 — 로컬 즉시 반영 + 전역 지속
}
export fn setHostExpanded(host, open) {
  role: 호스트 행의 최근 폴더 펼침 토글 — 로컬 즉시 반영 + 호스트별 지속 (op expand). 같은 host 는 두 pane 이 공유
}
export fn connectHost(host, mode) {
  role: 호스트 접속 — 경로 없는 `ssh://host` 를 host.openFolder 에 (원격 빈 세션 — 시작 페이지 + 그 호스트 탐색). mode 'replace'=현재 탭 대체(arrow-right) / 'new'=항상 새 탭(empty-window — 활성 탭이 빈 세션이어도 대체하지 않는다)
}
export fn openRecent(host, path, mode) {
  role: 경로 아이템으로 접속 — ssh://host/path 를 host.openFolder 에, mode 규칙은 connectHost 와 동일
}
export fn openGroup(host, paths, mode) {
  role: 그룹 열기 — 멤버마다 세션 탭. 같은 ssh://host/path 탭이 이미 열려 있으면(sessions.list) 그 멤버는 건너뛴다 (새로 만들지도 활성화하지도 않음). 첫 새 멤버가 mode 를 받고 나머지는 'new'
}
export fn togglePin(host, index) {
  role: 최상위 아이템(단일·그룹) pin 토글 — 결과 목록을 set-items 로 (relay 가 pin 을 위로)
}
export fn forgetItem(host, path, group?) {
  role: 목록에서 제거 — 최상위 단일 아이템, group 을 주면 그 그룹의 멤버 (하나 남으면 relay 가 그룹을 푼다)
}
export fn setGroupAlias(host, group, alias) {
  role: 그룹 별칭 — 빈 문자열은 없음 (제목줄 사라짐)
}
export fn dropItems(host, paths, target, from?, copy?) {
  role: 끌어 놓기 — target(before/after 최상위 자리, into = 대상 단일 아이템과 [대상, ...paths] 그룹 만들기, member = 그룹 안 at 번째)에 paths 를 넣는다. from 이 있고 copy 가 아니면 출처에서 뗀다(최상위 아이템은 pin·별칭째 통째로). 대상 평면에 이미 있는 경로는 넣지 않는다 — 같은 평면 복사 = 무동작, 이동·복사 병합 = 옮겨 온 쪽 소멸·원래 자리 유지
}

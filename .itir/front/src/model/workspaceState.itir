import { EditorGroup, LayoutNode } from './editors'
import { notify } from './notifications'
import { SessionCtx } from './session'

import { tauri } from './tauri'
import { fontZoom, FontZoom } from './terminal'
role: 워크스페이스별 상태 기억 (ticket workspace-state-restore; 추가 탐색기 섹션은 extraRoots(절대 경로 목록, 화면 순서대로, optional — version 1 유지)로 실려 복원 때 files.addExtraRoot 를 순서대로 부른다 (워크스페이스 밖 경로는 addExtraRoot 가 조용히 버린다) — 탭이 없던 워크스페이스도 섹션만은 되살린다, 섹션 안 펼침은 기억하지 않는다 (ticket explorer-extra-roots); 탭에 붙은 터미널 카드는 terminals 항목에 host(탭 id)·hostTmux(터미널 탭) 좌표로, 터미널 탭의 다른 카드는 항목의 cards 로 실리고 복원이 탭을 먼저 붙인 뒤 attachTerminal(at.host)·attachCards 로 되돌린다 — ticket terminal-tab-panes) — 같은 root 를 다시 열면 그 아래에서 열었던 탭(kind 전부)·활성 탭·그룹 배치·탐색기 펼침·파일별 커서·스크롤·터미널 자리를 복원한다. "어느 폴더를 열지" 는 여전히 사용자가 고른다 (app-empty-session 결정 유지) — 고른 폴더 안의 상태만 기억한다. 저장 형식 WorkspaceState(version 1)는 editors.snapshot 의 구조 부분(groups·layout·activeGroupId·nextGroupId, docs 제외 — dirty 버퍼는 싣지 않는다; 그룹의 MRU(EditorGroup.mru)도 groups 에 실리되 터미널 id 는 뺀다, ticket tab-open-next-mru-close) + expanded + sideBarPinned(사이드바 고정 여부, optional — ticket floating-sidebar) + views(path → monaco 뷰 상태) + terminals(tmux 세션 id·그룹·index — 터미널 탭은 groups 에서 빼고 따로, 인스턴스 id 는 창마다 다르므로). 저장소 (decision/state-persistence.md): 앱은 native state.json 의 workspaces (native 소유 — 여기는 get/set_workspace_state invoke 만, root 는 native 가 세션 id 로 안다, 같은 root 의 두 번째 세션(탭 분리)은 native 가 거절), 웹은 localStorage 'superlite.state'.workspaces[root] (recents.ts 가 같은 키를 쓰되 이 필드는 통과만 시킨다; 키는 configureWorkspaceStore 로 바꿀 수 있다 — 모바일 셸은 host.ts 가 'superlite.mobile.state' 로, 그룹 하나뿐인 모바일 저장분이 같은 root 의 데스크톱 배치를 덮지 않게), mock 은 없음. 저장 시점: 구조 변경 1초 디바운스 + 세션 닫기·창 닫기 flush. 커서·스크롤은 트리거가 아니고 저장할 때 함께 실린다. 보조창(서브 창)도 보존한다 (2026-09-08 사용자 결정): 서브 창은 미러 세션의 같은 형식 스냅샷을 set_workspace_sub_state 로 보내 native 가 위치·크기를 붙여 그 root 의 subs 로 모으고, 메인이 복원할 때 서브 창을 다시 만든다. 세션 닫기(회수)는 서브 상태를 남기고 서브 창 X·마지막 탭 이탈은 잊는다

export type WorkspaceState
export type SubWorkspaceState
export type StoreKind

export fn configureWorkspaceStore(key) {
  role: 웹 localStorage 저장 키 교체 — 모바일 셸용. 부팅 전(host.ts)에 한 번
}

export fn restoreWorkspace(kind, id, root, ctx) {
  role: 세션 초기 로드 뒤 한 번(sessions.addLocal) — 저장된 상태를 읽어 editors.restore 로 껍데기 탭·배치를 먼저 세우고(즉시 보임), 이어서 펼침(files.expandPaths)·터미널(refreshTerminals 뒤 살아 있는 tmux 세션만 저장된 그룹·index 에 attachTerminal, 없으면 건너뜀)·문서(editors.hydrate — 활성 탭부터 순차 읽기, 탭마다 loadingTabs 진행선, 사라진 파일 탭은 걷어내고 알림 한 줄)를 채운다. 저장된 것이 없거나 창 이동 핸드오프가 먼저 도착해 이미 탭이 있으면 무동작. 보조창(subs — native 가 넘기며 비운다)은 저장된 자리·크기에 detach_tabs(size) 로 서브 창을 만들고 'restore' 핸드오프(sessions.applyHandoff)로 채운다 — 저장한 label 의 서브 창이 아직 살아 있으면(list_subs, 다른 세션의 탭을 가진 채 남은 창) 새 창 대신 그 창에 forward 로 'restore' 핸드오프(toSession = 이 세션)를 보낸다 (ticket sub-window-restore-broken — label 일치가 같은 창을 뜻하는 것은 native 가 새 label 을 저장본 최대 번호 뒤에서 발급하기 때문, ticket sub-window-restore-label-collision). 창 생성·전달 실패는 sticky 경고보조창 항목의 zoom(웹뷰 줌 레벨)은 detach_tabs 의 zoom 인자로, fontZoom(편집기·터미널 배율)은 'restore' 핸드오프에 실어 되살아난 서브 창이 저장 당시 배율로 뜬다 (ticket zoom-per-window)
}
export fn restoreSubWorkspace(kind, mirror, ctx) {
  role: 서브 창 자신의 몫 복원(서브 창 새로고침) — get_workspace_sub_state 로 같은 label 의 저장이 있으면 applyWorkspaceState. 새로 만든 서브 창은 없음이라 무동작이고 핸드오프가 채운다
}
export fn applyWorkspaceState(ctx, s) {
  role: 스냅샷 하나를 세션에 적용 — editors.restore 로 껍데기 탭·배치를 먼저 세우고 펼침·터미널(terminals.listTerminalsFor(조회 실패 시에만 500ms·1s·2s·4s 백오프 재시도, 성공한 빈 목록은 즉시 수용)로 받은 목록에서 살아 있는 tmux 만 저장된 자리에 attach, 죽은 터미널의 빈 pane 은 closeEmptyGroup — 못 찾은 id·살아 있는 id·데몬 방식을 warning 알림으로. 조회 자체가 끝내 실패면 죽은 것으로 단정하지 않고 빈 pane 을 남긴 채 사유를 알린다, ticket term-layout-restore-flaky. 두 경고는 sticky — 자리를 비운 사이 12초에 사라지면 증거가 없다, ticket term-restore-observe)·문서(hydrate)를 채운다. 메인(restoreWorkspace)과 서브 창('restore' 핸드오프)이 공유한다
}
export fn trackWorkspace(kind, id, root, ctx, sub?) {
  role: 복원이 끝난 세션의 변경을 따라가며 저장 — effect 가 직렬화 중 읽은 반응형 값(그룹·탭·배치·펼침·터미널 목록 — snapshot 이 docs 도 복사하므로 문서 content 변경에도 재실행되지만 구조 JSON 비교로 걸러진다)을 추적하고, 구조 JSON 이 마지막 저장과 다르면 1초 디바운스 뒤 persist. 첫 실행은 저장하지 않는다(복원 직후). viewStates 는 markRaw 라 추적되지 않는다. sub(미러 세션 id)가 있으면 서브 창 몫으로 set_workspace_sub_state 에 보내고 첫 실행부터 저장하며(추적 시작 시점에 넘어온 탭이 이미 있고 저장된 적이 없다), 탭이 하나도 없으면 null(잊기) 서브 창(sub)의 스냅샷엔 fontZoom(창 배율)이 함께 실리고 배율 변경도 저장 트리거다 — 메인 몫(root 별)엔 없다, 메인 배율은 창 저장소(editors.loadWindowZoom)가 기억한다 (ticket zoom-per-window)
}
export fn forgetWorkspace(id) {
  role: 서브 창을 잊는다 — 추적을 멈추고 저장을 null 로 지운다 (서브 창 X·마지막 탭이 메인으로 돌아감). 세션 닫기의 회수는 untrackWorkspace(저장 유지)
}
export fn flushWorkspace(id) {
  role: 세션 닫기 — 즉시 저장하고 추적을 멈춘다. 앱은 native close_session 이 레지스트리에서 빼기 전에 도달해야 하므로 호출측(sessions.closeSession)이 await 한다
}
export fn untrackWorkspace(id) {
  role: 추적만 멈춘다(저장 없음) — 세션이 다른 창으로 옮겨 가거나 native 가 닫아 reconcile 이 제거한 경우 (sessions.removeLocal)
}
export fn flushAllWorkspaces() {
  role: 이 창의 모든 추적 세션을 저장 — 창 닫기(window.closeWindow)·beforeunload(main.ts). 추적은 유지한다
}

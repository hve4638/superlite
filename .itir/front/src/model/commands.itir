import { openQuickInput, showViewlet, toggleSideBar } from './workbench'
import { openFolderDialog } from './host'
import { closeTab, reopenClosedEditor, saveActive, splitGroup, toggleGroupLock, activeGroup, activeTab, openHex, toggleHtmlPreview, isHtml, openUrl, toggleWordWrap, stepEditorZoom, setEditorZoom, setActiveTab } from './editors'
import { createTerminal, toggleTerminal } from './terminal'
import { openSshConfig, openTmuxConf } from './configfiles'
import { refreshScm } from './scm'
import { activeSessionEmpty, cycleSession, sessionsEnabled } from './sessions'
import { inApp, reloadWindow, zoomWindow } from './window'
import { showAbout } from './version'
import { toggleVimMode, vimAvailable } from './nvim'

role: 커맨드 레지스트리 + 키바인딩 — VS Code 기본 chord 표기(ctrl+k ctrl+s 류) 지원

export type Command
export val commandList
export val recentCommands
export fn runCommandFromPalette(cmd) {
  role: 팔레트가 고른 명령 실행 + recentCommands(팔레트에서 실행한 명령 id 의 최근 목록 — 최근이 앞, 상한 20, localStorage superlite.recentCommands, 세션·창 무관) 앞에 기록. QuickInput 이 빈 입력·입력 있음 모두 이 순서로 매칭된 명령을 위에 올린다 (VS Code "recently used", 구분 라벨 없음 — 사용자 결정 2026-09-09, ticket palette-recent-commands). 키바인딩 실행(installKeybindings)은 세지 않는다 — Ctrl+S 류가 팔레트 상단을 차지하지 않게 (VS Code 와 같다)
}

export fn isWorkbenchChord(e) -> bool {
  role: 워크벤치가 가로채는 chord 인지 — monaco 에 키를 넘길지 판단
}
export fn isShellSkippingChord(e) -> bool {
  role: 터미널 포커스 중에도 워크벤치가 가로채는 chord 인지 (VS Code commandsToSkipShell) — Command.skipShell 표식이 붙은 커맨드(팔레트·퀵오픈·뷰 전환·터미널 토글·새 터미널·에디터 탭·세션 탭 순환·전역 줌)만. 나머지 chord(Ctrl+W·Ctrl+B·Ctrl+S 등)는 xterm 이 셸로 보낸다 — Ctrl+B 는 VS Code 기본과 달리 셸행(tmux 접두, terminal-usability)
}
export fn installKeybindings(target) {
  role: window keydown 에 chord 상태기 설치
}
export fn setupCommands() {
  role: 내장 커맨드 전부 등록 (저장·분할·뷰 전환·터미널 등 — 터미널은 편집기 탭: 'View: Toggle Terminal'(Ctrl+`, terminal.toggleTerminal — 터미널 탭이 없으면 생성, 있으면 창 전체에서 가장 최근에 활성이었던 터미널 탭으로 이동·포커스)·'Terminal: Create New Terminal'(Ctrl+Shift+`, createTerminal — 항상 새 탭), 둘 다 activeSessionEmpty 가드·skipShell — ticket terminal-toggle-keys 2026-09-09, 종전엔 Ctrl+` 가 매번 새 터미널. 하단 패널 토글(Ctrl+J)은 없다). 활성 탭 경로를 hex 뷰어로 여는 'Hex Editor: Open Active File in Hex Editor', .html·프리뷰 활성 탭의 'HTML: Toggle Preview'(Ctrl+Shift+V, toggleHtmlPreview — 제자리 전환), 'View: Toggle Word Wrap'(Alt+Z, toggleWordWrap), 'Help: About'(version.showAbout — 버전·커밋·와이어·데몬 경로 다이얼로그), 클라이언트 머신 설정 파일을 편집기 탭으로 여는 'Terminal: Open tmux.conf (Applied Profile)'(terminal.openTmuxConf)·'Remote: Open SSH Config (This Machine)'(remote.openSshConfig — 둘 다 configfiles, 키 없음, ticket config-editors). '폴더 열기' Ctrl+O 는 모든 환경에서 경로 입력 퀵인풋을 연다 (sessionsEnabled 에서 등록, mock 미등록). 앱(inApp)은 OS 다이얼로그를 팔레트 커맨드 'File: Open Folder (OS Dialog)...'(host.openFolderDialog — 빈 탭 replace 판단 포함, chord 없음)와 퀵인풋이 열린 채 Ctrl+O 를 한 번 더 누르는 경로(QuickInput.vue)로 병행 제공한다 — web-folder-open.md. 그 밖의 등록: 'View: Close Editor'(Ctrl+W)·'View: Reopen Closed Editor'(Ctrl+Shift+T — 둘 다 브라우저 예약 키라 웹은 팔레트로만)·'View: Toggle Editor Group Lock'(키 없음)·'View: Switch to Next Session Tab'(Ctrl+Shift+Tab, sessionsEnabled)·'View: Open Next/Previous Editor'(Ctrl+Tab·Ctrl+PageDown / Ctrl+PageUp). 줌 키 배정(사용자 확정, VS Code 기본과 다름): 편집기 전용 줌 'View: Editor Font Zoom In/Out/Reset'(Ctrl+= · Ctrl+- · Ctrl+0, stepEditorZoom·setEditorZoom — 상태바 배율 항목과 같은 값)은 모든 환경, UI 포함 전역(웹뷰) 줌 'View: Zoom In/Out/Reset Zoom'(Ctrl+Shift+= · Ctrl+Shift+- · Ctrl+Shift+0, window.zoomWindow)은 앱 전용(skipShell — 터미널 포커스 중에도 동작) — 웹은 같은 키가 브라우저 줌이라 미등록 (ticket convenience-features). 'View: Toggle Vim Mode'(vim.toggle, 키 없음 — nvim.toggleVimMode) 는 vimAvailable 일 때만 (mock 은 relay 가 없다). 'Developer: Reload Window'(workbench.action.reloadWindow, 키 없음 — window.reloadWindow: 워크스페이스 상태 저장 뒤 웹뷰 새로고침, ticket workspace-state-restore)
}

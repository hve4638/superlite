import { editors, imageMime, ensureHex, loadHexChunk, HEX_CHUNK, openHex, openHtmlPreview, isHtml, languageOf, setApplyExternalEdit, setDisposeModels, updateContent, moveTabToGroup, moveTabSplit, openFileSplit, pinTab } from '../../model/editors'
import { openQuickInput } from '../../model/workbench'
import { FileIcon } from '../widgets/FileIcon'
import { backend } from '../../model/host'
import { scm } from '../../model/scm'
import { setBeforeSessionSwitch, activeSessionEmpty, multiWindow, sessionRoot, sessions, detachEditorTab, requestTabsMove, DND_EDITOR } from '../../model/sessions'
import { windowLabel } from '../../model/window'
import { notify } from '../../model/notifications'
import { pointerOutside } from '../dndUtil'
import { StartPage } from '../StartPage'
import { EDITOR_FONT_SIZE, MONO_FONT_FAMILY } from '../../theme/fonts'

role: 에디터 영역 — monaco 수명주기(monaco.ts)와 그룹/탭바/diff 렌더링(.vue — 삭제 파일 탭(DiffTab.deleted)은 diff 대신 코드 편집기에 HEAD 모델을 읽기 전용으로), 탭 드래그 이동/분리(진행 상태는 tabDnd.ts 모듈 상태로 공유). 창 간(앱): 탭을 창 밖에 놓으면 새 창(detachEditorTab), 다른 창의 탭바에 놓으면 그 창이 출처에 이동을 요청(requestTabsMove) — 같은 root 세션에만, dataTransfer 의 DND_EDITOR 타입으로 식별. monaco 모델은 path 당 하나, 그룹 간 공유. 열 수 없는 문서(doc.unopenable)는 모델을 만들지 않고 편집기 자리에 사유 안내를 띄운다 (VS Code binary/large 안내 근사). 편집기 자리를 차지하는 것(hex·preview 탭, 이미지, 열 수 없음 안내)은 EditorGroupView 의 overlay computed 하나가 우선순위대로 정하고 monaco 는 v-show="!overlay" 로 가린다 — 종류가 늘면 그 분기 하나와 템플릿 분기 하나. 이미지 문서(doc.image)도 모델 없이 편집기 자리에 이미지 뷰어(ImageView.vue — 체커보드, 영역 전체 휠 줌(커서 지점 고정)·드래그 팬·더블클릭 fit 복귀)를 띄운다. 해상도·크기·배율 표시는 statusbar 몫 — ImageView 가 editors.imageView 를 세운다. 이진 안내에는 "Open in Hex Editor" 링크(openHex). hex 탭(HexView.vue — HxD 식 offset/hex/ASCII 3열, 16바이트 행, 보이는 행만 렌더하는 가상 스크롤, 뷰어 전용·편집 없음)은 editors.hex(HexDoc)의 청크를 그린다 — 크기는 ensureHex, 보이는 행이 걸친 청크(±1 선읽기)는 loadHexChunk 로 요청하고 미도착 바이트는 빈 칸. 총 높이가 브라우저 요소 높이 한계를 넘는 GB 파일은 스크롤 트랙을 축척해 scrollTop 을 행 인덱스로 사상한다 (렌더 행은 scrollTop 을 따라가는 컨테이너에 상대 배치). preview 탭(HtmlPreview.vue)은 같은 path 의 doc.content 를 sandbox iframe srcdoc 에 디바운스 반영 — 상대 경로 리소스는 해석되지 않는다(서버 없음). 탭바 그룹 액션에 활성 탭이 .html 이면 "Open Preview to the Side" 아이콘(openHtmlPreview). 부팅 유휴 시간에 더미 에디터를 한 번 만들어 폰트 측정 캐시를 데운다 — 첫 파일 콜드 오픈의 고정 비용(에디터 생성)을 부팅으로 옮기는 프리웜. 실측값은 localStorage 에 영속화(VS Code editorFontInfo 동일 수법)해 재실행부터는 부팅 실측도 건너뛴다 — 복원값은 monaco 가 5초 뒤 백그라운드 재실측(untrusted 취급)
